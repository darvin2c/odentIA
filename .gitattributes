# Scripts ejecutados dentro de contenedores Linux: nunca CRLF.
*.sh text eol=lf

# Catálogos con importación UTF-8 estricta: conservar LF también en Windows.
packages/db/seeds/*.csv text eol=lf

# Archivos oficiales tal como los publica su editor: su SHA-256 se verifica byte a byte.
packages/db/seeds/oficiales/** binary
