{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "DATABASE_URL",
    "APP_DATABASE_URL",
    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "WEB_URL",
    "ADMIN_URL",
    "COOKIE_DOMAIN",
    "MEDICAL_DOMAIN",
    "TRUSTED_ORIGINS",
    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "MEDICAL_SMTP_FROM",
    "COMPLAINTS_EMAIL",
    "VITE_API_URL",
    "VITE_BASE_DOMAIN",
    "VITE_DENTAL_DOMAIN",
    "VITE_MEDICAL_DOMAIN",
    "VITE_PRODUCT",
    "VITE_BASE_PORT",
    "SECRETS_KEY",
    "CHANNEL_VALIDATE_EXTERNAL",
    "CHANNEL_SENDER_MODE",
    "LLM_MODEL",
    "LLM_OPENAI_API_KEY",
    "LLM_OPENAI_BASE_URL",
    "LLM_TIMEOUT_MS",
    "LLM_MAX_RETRIES",
    "JEV_API_KEY",
    "JEV_BASE_URL",
    "JEV_MODEL",
    "DECISIONS_TIMEOUT_MS",
    "EMBEDDINGS_MODEL",
    "EMBEDDINGS_BASE_URL",
    "EMBEDDINGS_API_KEY",
    "EMBEDDINGS_TIMEOUT_MS",
    "META_APP_ID",
    "META_APP_SECRET",
    "META_LOGIN_CONFIG_ID",
    "META_WEBHOOK_VERIFY_TOKEN",
    "META_GRAPH_VERSION",
    "AGENT_BURST_WINDOW_SECONDS",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "S3_ATTACHMENTS_BUCKET",
    "S3_PUBLIC_URL",
    "PORTLESS_WILDCARD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@odentia/e2e#test": {
      "cache": false,
      "dependsOn": [],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*", "CI", "E2E_WORKERS"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
