    "BETTER_AUTH_SECRET",
    "BETTER_AUTH_URL",
    "WEB_URL",
    "ADMIN_URL",
    "COOKIE_DOMAIN",
    "VAPID_PUBLIC_KEY",
    "VAPID_PRIVATE_KEY",
    "VAPID_SUBJECT",
    "MEDICAL_DOMAIN",
    "OPTICAL_DOMAIN",
    "GESTORIA_DOMAIN",
    "GESTORIA_ACCOUNT_EVENTS_URL",
    "GESTORIA_ACCOUNT_EVENTS_SECRET",
    "GESTORIA_CONTRACT_SECRET",
    "GESTORIA_CONTRACT_URL",
    "GESTORIA_DATABASE_URL",
    "GESTORIA_APP_DATABASE_URL",
    "GESTORIA_ACCOUNT_URL",
