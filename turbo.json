    "SMTP_HOST",
    "SMTP_PORT",
    "SMTP_USER",
    "SMTP_PASS",
    "SMTP_FROM",
    "MEDICAL_SMTP_FROM",
    "OPTICAL_SMTP_FROM",
    "GESTORIA_SMTP_FROM",
    "CONVERSATION_SMTP_USER",
    "CONVERSATION_SMTP_PASS",
    "COMPLAINTS_EMAIL",
    "INBOUND_EMAIL_SECRET",
    "VITE_API_URL",
    "VITE_BASE_DOMAIN",
    "VITE_DENTAL_DOMAIN",
    "VITE_MEDICAL_DOMAIN",
    "VITE_OPTICAL_DOMAIN",
    "VITE_GESTORIA_DOMAIN",
    "VITE_PRODUCT",
    "VITE_SALES_WHATSAPP",
    "VITE_BASE_PORT",
