    "LLM_TIMEOUT_MS",
    "LLM_MAX_RETRIES",
    "YOUTUBE_API_KEY",
    "HELP_VIDEOS_PLAYLIST",
    "MEDICAL_HELP_VIDEOS_PLAYLIST",
    "OPTICAL_HELP_VIDEOS_PLAYLIST",
    "JEV_API_KEY",
    "JEV_BASE_URL",
    "JEV_MODEL",
    "DECISIONS_TIMEOUT_MS",
    "EMBEDDINGS_MODEL",
    "EMBEDDINGS_BASE_URL",
    "EMBEDDINGS_API_KEY",
    "EMBEDDINGS_TIMEOUT_MS",
    "META_APP_ID",
    "META_APP_SECRET",
    "META_LOGIN_CONFIG_ID",
    "META_PAGES_CONFIG_ID",
    "META_PAGES_REDIRECT_URI",
    "META_INSTAGRAM_APP_ID",
    "META_INSTAGRAM_APP_SECRET",
    "META_INSTAGRAM_REDIRECT_URI",
    "META_WEBHOOK_VERIFY_TOKEN",
    "META_GRAPH_VERSION",
    "ADMIN_META_APP_SECRET",
    "ADMIN_META_VERIFY_TOKEN",
    "ADMIN_WA_PHONE_NUMBER_ID",
    "ADMIN_WA_ACCESS_TOKEN",
    "ADMIN_META_PAGE_ID",
    "ADMIN_META_PAGE_ACCESS_TOKEN",
    "ADMIN_IG_ACCOUNT_ID",
    "ADMIN_META_GRAPH_URL",
    "AGENT_BURST_WINDOW_SECONDS",
    "S3_ENDPOINT",
    "S3_REGION",
    "S3_ACCESS_KEY",
    "S3_SECRET_KEY",
    "S3_BUCKET",
    "S3_ATTACHMENTS_BUCKET",
    "S3_PUBLIC_URL",
    "PORTLESS_WILDCARD"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "@odentia/e2e#test": {
      "cache": false,
      "dependsOn": [],
      "passThroughEnv": ["DOCKER_*", "TESTCONTAINERS_*", "CI", "E2E_WORKERS"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
