# Dev local. Copiar a .env y ajustar. No commitear .env con secretos reales.

# Postgres (rol owner: migraciones; rol app: runtime, sujeto a RLS)
POSTGRES_DB=dentalagent
POSTGRES_USER=dentalagent
POSTGRES_PASSWORD=dentalagent
POSTGRES_PORT=5432
POSTGRES_APP_PASSWORD=dentalagent_app
DATABASE_URL=postgres://dentalagent:dentalagent@127.0.0.1:5432/dentalagent
APP_DATABASE_URL=postgres://dentalagent_app:dentalagent_app@127.0.0.1:5432/dentalagent

# Better Auth
BETTER_AUTH_SECRET=dev-only-secret-change-me-0123456789abcdef
BETTER_AUTH_URL=https://api.odentia.localhost
WEB_URL=https://app.odentia.localhost
ADMIN_URL=https://admin.odentia.localhost
COOKIE_DOMAIN=odentia.localhost
TRUSTED_ORIGINS=https://odentia.localhost,https://app.odentia.localhost,https://api.odentia.localhost,https://*.odentia.localhost

# Google OAuth (Google Cloud Console; Authorized redirect URI =
# ${BETTER_AUTH_URL}/api/auth/callback/google). Vacíos = OAuth deshabilitado.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Portless: <slug>.odentia.localhost cae a platform; app./admin./api. son rutas explícitas
PORTLESS_WILDCARD=1

# SMTP (Mailpit)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="odentIA <no-reply@odentia.localhost>"
# Buzón de soporte: recibe «Caso nuevo» y «La clínica respondió» (se ve en Mailpit).
SUPPORT_INBOX_EMAIL=soporte@odentia.localhost
# Libro de Reclamaciones (web): correo de odentIA que recibe el aviso de cada
# hoja. Opcional; sin él solo sale la copia al consumidor (en dev, a Mailpit).
COMPLAINTS_EMAIL=reclamaciones@odentia.localhost

# S3 (MinIO)
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=auto
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dentalagent-dev
S3_ATTACHMENTS_BUCKET=dentalagent-attachments
S3_PUBLIC_URL=http://127.0.0.1:9000/dentalagent-dev

# CRM omnicanal (generar con: openssl rand -hex 32)
SECRETS_KEY=
# false en dev/e2e para no llamar a Meta/Telegram al crear conexiones
CHANNEL_VALIDATE_EXTERNAL=false
# mock = sin HTTP al proveedor; live = envío real
CHANNEL_SENDER_MODE=mock
# «Conectar con Facebook» de WhatsApp (Embedded Signup de Meta). Opcional: sin las
# cuatro primeras el botón no existe y WhatsApp se conecta a mano, como siempre.
# Son de la app de odentIA en Meta, la misma para todas las clínicas; solo las lee
# la API. Tampoco hay botón con CHANNEL_VALIDATE_EXTERNAL=false. Trámite y pasos en
# docs/development.md. La clave secreta nunca va en una variable VITE_*.
# META_APP_ID=
# META_APP_SECRET=
# META_LOGIN_CONFIG_ID=
# META_WEBHOOK_VERIFY_TOKEN=
# META_GRAPH_VERSION=v25.0
# Búsqueda por significado del agente (ADR 0021): vectores de la plataforma, la
# misma cuenta para todas las clínicas, compatible con OpenAI (POST /embeddings).
# fake = vectores por letras, sin red: encuentra palabras mal escritas pero no
# entiende significado. Vacío = el agente busca solo por palabras.
EMBEDDINGS_MODEL=fake
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=
# Modelo del agente (ADR 0022): la clínica elige «ChatGPT 6» (OpenAI) o
# «Claude 5.5» (Anthropic) y odentIA pone la cuenta. El modelo exacto y sus
# opciones están en packages/agent/src/llm.ts; aquí solo van las claves.
# LLM_MODEL=fake = agente determinista (dev/e2e), sin proveedor; quítalo para
# usar los reales. Sin la clave del proveedor elegido, el agente deriva y avisa.
# Las URL base solo hacen falta con una pasarela propia (por defecto, la API
# pública de cada proveedor). Reiniciar API y worker al cambiar valores.
LLM_MODEL=fake
# LLM_OPENAI_API_KEY=
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_ANTHROPIC_API_KEY=
# LLM_ANTHROPIC_BASE_URL=https://api.anthropic.com
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=2
# Modelos de decisión. Toda clínica nace con Jev (ADR 0047); sin JEV_API_KEY cada corrida
# deja una fila «sin credenciales» y responde sin modelo de decisión. «baseline» usa el
# modelo de conversación y no necesita otra clave.
# JEV_API_KEY=
# JEV_BASE_URL=https://api.typesafe.ai
# JEV_MODEL=jev-1.13.0
# OPENAI_DECISIONS_API_KEY=
# OPENAI_DECISIONS_BASE_URL=https://api.openai.com/v1
# OPENAI_DECISIONS_MODEL=gpt-6-luna
# DECISIONS_TIMEOUT_MS=2000

# Segundos de silencio que el agente espera antes de leer el hilo: la espera se
# reinicia con cada mensaje nuevo de la persona, y agrupa la ráfaga en una sola
# corrida (y una sola respuesta). 0 responde sin esperar.
# AGENT_BURST_WINDOW_SECONDS=6
# Tope de esa espera, contado desde el primer mensaje sin responder.
# AGENT_BURST_MAX_WAIT_SECONDS=30
# Transcripción de notas de voz entrantes (OpenAI-compatible, p.ej. whisper-1).
# Vacío = desactivada. Sin TRANSCRIBE_API_KEY se reutiliza LLM_OPENAI_API_KEY solo si
# TRANSCRIBE_BASE_URL es el mismo host que LLM_OPENAI_BASE_URL; si no, queda desactivada.
# TRANSCRIBE_MODEL=
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=

# Frontend
VITE_API_URL=https://api.odentia.localhost
VITE_BASE_DOMAIN=odentia.localhost
# Puerto del proxy cuando no es 443 (dev lo deja vacío)
# VITE_BASE_PORT=
