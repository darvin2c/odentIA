# Producción. Una sola fuente: variables del proyecto en OpenShip o este
# archivo copiado a infra/prod/.env para Docker Compose. Nunca commitear secretos.

# Postgres (rol owner: migraciones; rol app: runtime, sujeto a RLS)
POSTGRES_DB=dentalagent
POSTGRES_USER=dentalagent
POSTGRES_PASSWORD=cambia-esto
POSTGRES_APP_PASSWORD=cambia-esto-tambien
DATABASE_URL=postgres://dentalagent:cambia-esto@postgres:5432/dentalagent
APP_DATABASE_URL=postgres://dentalagent_app:cambia-esto-tambien@postgres:5432/dentalagent

# Better Auth
BETTER_AUTH_SECRET=genera-con-openssl-rand-hex-32
BETTER_AUTH_URL=https://api.example.com
WEB_URL=https://app.example.com
COOKIE_DOMAIN=example.com
TRUSTED_ORIGINS=https://example.com,https://app.example.com,https://api.example.com

# Google OAuth (vacíos = deshabilitado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP transaccional real (obligatorio en producción)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="odentIA <no-reply@example.com>"

# S3 (Cloudflare R2): endpoint https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=odentia
S3_ATTACHMENTS_BUCKET=odentia-attachments
S3_PUBLIC_URL=

# CRM omnicanal (openssl rand -hex 32)
SECRETS_KEY=
CHANNEL_VALIDATE_EXTERNAL=true
CHANNEL_SENDER_MODE=live
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=2
# TRANSCRIBE_MODEL=
# TRANSCRIBE_API_KEY=

# Frontend (coinciden con los ARG de build de la imagen)
VITE_API_URL=https://api.example.com
VITE_BASE_DOMAIN=example.com

# Puerto interno de la API; panel y platform fijan PORT=3000 en el compose.
PORT=3001

# Backup a R2 (bucket dedicado; mismas credenciales S3 si aplica)
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_BUCKET=odentia-backups
BACKUP_RETAIN=14
BACKUP_INTERVAL=86400
