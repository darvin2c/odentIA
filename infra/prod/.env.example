# Producción. Una sola fuente: variables del proyecto en OpenShip o este
# archivo copiado a infra/prod/.env para Docker Compose. Nunca commitear secretos.

# Postgres (rol owner: migraciones; rol app: runtime, sujeto a RLS)
POSTGRES_DB=dentalagent
POSTGRES_USER=dentalagent
POSTGRES_PASSWORD=cambia-esto
POSTGRES_APP_PASSWORD=cambia-esto-tambien
DATABASE_URL=postgres://dentalagent:cambia-esto@postgres:5432/dentalagent
APP_DATABASE_URL=postgres://dentalagent_app:cambia-esto-tambien@postgres:5432/dentalagent

# Better Auth
BETTER_AUTH_SECRET=genera-con-openssl-rand-hex-32
BETTER_AUTH_URL=https://api.example.com
# Panel (app.). La web de marketing ocupa el dominio raíz y toma su dirección de VITE_BASE_DOMAIN.
WEB_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
COOKIE_DOMAIN=example.com
TRUSTED_ORIGINS=https://example.com,https://app.example.com,https://admin.example.com,https://api.example.com
# latidIA en su dominio (decisión 9 del issue 229; docs/deployment.md): sus clínicas, su panel y su
# API van en él, con su propia sesión; sus orígenes de confianza salen de los de arriba. Vacío: un solo dominio.
MEDICAL_DOMAIN=
# Cabecera con la IP de quien pide (límite de intentos de Better Auth). Solo una que
# reescriba siempre quien está delante: con Cloudflare Tunnel, cf-connecting-ip; por el
# borde de OpenShip, x-real-ip. Vacía: todos comparten el límite (docs/deployment.md).
CLIENT_IP_HEADER=cf-connecting-ip

# Cloudflare Tunnel: única entrada pública (Networking → Tunnels, un túnel por proyecto).
# Solo la clave del comando de instalación. Obligatoria: sin ella Compose no arranca.
CLOUDFLARE_TUNNEL_TOKEN=

# Google OAuth (vacíos = deshabilitado)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# SMTP transaccional real (obligatorio en producción)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="odentIA <no-reply@example.com>"
# Buzón de soporte de odentIA; vacío deja pendientes los avisos a soporte.
SUPPORT_INBOX_EMAIL=soporte@example.com
# Libro de Reclamaciones (web): correo de odentIA que recibe el aviso de cada hoja.
# Vacío, solo sale la copia al consumidor; la hoja queda en admin igualmente.
COMPLAINTS_EMAIL=reclamaciones@example.com

# S3 (Cloudflare R2): endpoint https://<accountid>.r2.cloudflarestorage.com
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=odentia
S3_ATTACHMENTS_BUCKET=odentia-attachments
S3_PUBLIC_URL=

# CRM omnicanal (openssl rand -hex 32)
SECRETS_KEY=
CHANNEL_VALIDATE_EXTERNAL=true
# Rechazar contraseñas filtradas (Have I Been Pwned; solo viajan 5 caracteres del SHA-1).
# Si el servicio no responde, la contraseña se acepta. false solo en pruebas sin red.
PASSWORD_BREACH_CHECK=true
CHANNEL_SENDER_MODE=live
# Cuenta de odentIA para el modelo del agente (ADR 0052): obligatoria; sin ella
# el agente deriva y avisa.
LLM_OPENAI_API_KEY=
# LLM_OPENAI_BASE_URL=
# LLM_TIMEOUT_MS=60000
# LLM_MAX_RETRIES=2
# LLM_MODEL=fake es el modelo de demostración: con canales reales el servidor no arranca.
# Búsqueda con vectores del agente (compatible con OpenAI). Vacío: solo por palabras
# (11 de 35 aciertos frente a 32 de 35 con vectores, ADR 0021).
# EMBEDDINGS_MODEL=text-embedding-3-small
# EMBEDDINGS_BASE_URL=https://api.openai.com/v1
# EMBEDDINGS_API_KEY=
# Sugerencias de direcciones (issue 36, ADR 0077), solo en la API: Google Places
# para la sede (clave restringida a «Places API (New)», con facturación) y
# Geoapify para el paciente. Vacías = los campos de siempre. GEOAPIFY_DAILY_LIMIT
# son las búsquedas al día del plan de Geoapify (el gratis da 3 000).
# GOOGLE_MAPS_API_KEY=
# GEOAPIFY_API_KEY=
# GEOAPIFY_DAILY_LIMIT=3000
# Segundos que el agente espera tras un mensaje entrante para agrupar una ráfaga
# en una sola respuesta (0–30). Añade esa demora a cada respuesta; 0 = sin espera.
# AGENT_BURST_WINDOW_SECONDS=4
# Modelo de decisión de toda clínica (ADR 0047). Sin JEV_API_KEY el agente sigue
# respondiendo, pero los mensajes ajenos a la clínica se cobran y Soporte recibe
# el caso «Modelo sin responder».
# JEV_API_KEY=
# Transcripción de notas de voz (OpenAI-compatible). Vacía = apagada: el agente no
# entiende las notas de voz (el equipo las escucha en la Bandeja). Producción usa
# gpt-transcribe de OpenAI (USD 0,0045 el minuto), con LLM_OPENAI_API_KEY. Groq es
# la alternativa más barata, sin probar en español (issue 158):
# TRANSCRIBE_BASE_URL=https://api.groq.com/openai/v1
# y TRANSCRIBE_MODEL=whisper-large-v3-turbo, con su propia TRANSCRIBE_API_KEY.
# TRANSCRIBE_MODEL=gpt-transcribe
# TRANSCRIBE_API_KEY=
# TRANSCRIBE_BASE_URL=

# Frontend (coinciden con los ARG de build de la imagen). VITE_BASE_DOMAIN también fija
# la dirección canónica de la web de marketing (https://example.com) y sus enlaces a app. y api.
VITE_API_URL=https://api.example.com
VITE_BASE_DOMAIN=example.com
# Dónde abre una clínica de cada producto desde el panel y la clínica; vacíos, en VITE_BASE_DOMAIN.
VITE_DENTAL_DOMAIN=
VITE_MEDICAL_DOMAIN=
# La API en el dominio de latidIA, para su panel y su app (perfil «latidia» del compose).
LATIDIA_API_URL=

# Puerto interno de la API; admin, panel, platform y web fijan PORT=3000 en el compose.
PORT=3001

# Backup a R2 (bucket dedicado; mismas credenciales S3 si aplica)
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_BUCKET=odentia-backups
BACKUP_RETAIN=14
BACKUP_INTERVAL=86400
