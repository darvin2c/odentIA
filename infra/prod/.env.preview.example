# Referencia del entorno PREVIEW de cada PR. scripts/preview-environment.mjs
# aplica estos valores con la base pr-<número>.<OPENSHIP_PREVIEW_DOMAIN> y genera
# los secretos vacíos una vez por entorno; nunca se configuran en Production.
# Receta: compose.preview.yaml. Sin datos ni credenciales productivos.

POSTGRES_DB=dentalagent
POSTGRES_USER=dentalagent
POSTGRES_PASSWORD=
POSTGRES_APP_PASSWORD=
# Completar con las contraseñas anteriores, codificadas para URL.
DATABASE_URL=
APP_DATABASE_URL=

# BETTER_AUTH_SECRET: al menos 32 caracteres; SECRETS_KEY: 32 bytes en hex.
BETTER_AUTH_SECRET=
SECRETS_KEY=
BETTER_AUTH_URL=https://api.preview.example.com
WEB_URL=https://app.preview.example.com
ADMIN_URL=https://admin.preview.example.com
COOKIE_DOMAIN=preview.example.com
TRUSTED_ORIGINS=https://app.preview.example.com,https://api.preview.example.com,https://*.preview.example.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Mailpit recibe SMTP real, pero no reenvía correo al exterior.
# Su interfaz HTTP permanece interna; acceder por Terminal de OpenShip.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="odentIA preview <no-reply@example.com>"
SUPPORT_INBOX_EMAIL=soporte@example.com

# MinIO propio del entorno. El endpoint HTTPS permite URLs firmadas utilizables
# por el navegador; no publicar la consola de administración de MinIO.
S3_ENDPOINT=https://storage.preview.example.com
S3_REGION=us-east-1
S3_ACCESS_KEY=preview
S3_SECRET_KEY=
S3_BUCKET=avatars
S3_ATTACHMENTS_BUCKET=attachments
S3_PUBLIC_URL=https://storage.preview.example.com/avatars

CHANNEL_VALIDATE_EXTERNAL=false
CHANNEL_SENDER_MODE=mock
LLM_MODEL=fake
VITE_API_URL=https://api.preview.example.com
VITE_BASE_DOMAIN=preview.example.com
PORT=3001
