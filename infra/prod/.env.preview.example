# Variables para entornos preview en OpenShip. Cada preview levanta su propio
# Postgres efímero (volumen aislado): nace vacío, migraciones corren solas vía
# el servicio `migrate`, y los datos se siembran con `pnpm db:seed` (seed-dev).
# Nunca apuntar un preview a la base de producción ni copiar sus datos (RGPD).

# Postgres efímera del preview (credenciales de usar y tirar)
POSTGRES_DB=dentalagent
POSTGRES_USER=dentalagent
POSTGRES_PASSWORD=preview-cambia-esto
POSTGRES_APP_PASSWORD=preview-cambia-esto-tambien
DATABASE_URL=postgres://dentalagent:preview-cambia-esto@postgres:5432/dentalagent
APP_DATABASE_URL=postgres://dentalagent_app:preview-cambia-esto-tambien@postgres:5432/dentalagent

# Better Auth (dominios del preview; los asigna OpenShip)
BETTER_AUTH_SECRET=preview-cambia-esto
BETTER_AUTH_URL=https://api-pr-XXX.example.com
WEB_URL=https://app-pr-XXX.example.com
COOKIE_DOMAIN=pr-XXX.example.com
TRUSTED_ORIGINS=https://pr-XXX.example.com,https://app-pr-XXX.example.com,https://api-pr-XXX.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sin SMTP real: los envíos caen al log del worker
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM="odentIA <no-reply@example.com>"

# R2: bucket de preview aislado (o prefijo pr-XXX/ en uno compartido)
S3_ENDPOINT=
S3_REGION=auto
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=odentia-preview
S3_ATTACHMENTS_BUCKET=odentia-preview-attachments
S3_PUBLIC_URL=

# Todo simulado: sin llamadas a Meta/Telegram, sin LLM real
SECRETS_KEY=preview-cambia-esto
CHANNEL_VALIDATE_EXTERNAL=false
CHANNEL_SENDER_MODE=mock
LLM_MODEL=fake

# Frontend (build-args del preview)
VITE_API_URL=https://api-pr-XXX.example.com
VITE_BASE_DOMAIN=pr-XXX.example.com

PORT=3001

# Backup desactivado en previews (efímeros; nada que conservar)
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_BUCKET=
BACKUP_RETAIN=0
BACKUP_INTERVAL=86400
