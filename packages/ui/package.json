{
  "name": "@odentia/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./globals.css": "./src/styles/globals.css",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./hooks/*": "./src/hooks/*.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@radix-ui/react-use-controllable-state": "1.2.6",
    "@remixicon/react": "4.9.0",
    "@shadcn/react": "0.3.1",
    "ai": "7.0.103",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "cn": "0.2.6",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.468.0",
    "media-chrome": "4.19.2",
    "nanoid": "6.0.1",
    "next-themes": "0.4.6",
    "react": "^19.2.8",
    "react-day-picker": "10.0.1",
    "react-dom": "^19.2.8",
    "react-resizable-panels": "4.12.4",
    "sonner": "2.0.8",
    "tailwind-merge": "3.6.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "shadcn": "4.21.0",
    "tw-animate-css": "1.4.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  }
}
