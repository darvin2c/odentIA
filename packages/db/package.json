{
  "name": "@odentia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./src/schema/*.ts",
    "./dental": "./src/dental/index.ts",
    "./products": "./src/products.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../infra/dev/.env src/migrate.ts",
    "seed:diagnoses": "tsx --env-file-if-exists=../../infra/dev/.env src/seed-diagnoses.ts",
    "seed:procedures": "tsx --env-file-if-exists=../../infra/dev/.env src/seed-catalog.ts",
    "import:procedures": "tsx --env-file-if-exists=../../infra/dev/.env src/import-procedures.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@odentia/channels": "workspace:*",
    "@odentia/clinical": "workspace:*",
    "@odentia/dental": "workspace:*",
    "@odentia/medical": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9",
    "tsx": "4.23.13"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.7",
    "xlsx": "0.18.5"
  }
}
