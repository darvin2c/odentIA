{
  "name": "@odentia/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./schema/*": "./src/schema/*.ts"
  },
  "scripts": {
    "generate": "drizzle-kit generate",
    "migrate": "tsx --env-file-if-exists=../../infra/dev/.env src/migrate.ts",
    "seed:cie10": "tsx --env-file-if-exists=../../infra/dev/.env src/seed-cie10.ts",
    "seed:procedures": "tsx --env-file-if-exists=../../infra/dev/.env src/seed-procedure-codes.ts",
    "import:cpms": "tsx --env-file-if-exists=../../infra/dev/.env src/import-cpms.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:ubigeo": "tsx --env-file-if-exists=../../infra/dev/.env src/seed-ubigeo.ts"
  },
  "dependencies": {
    "@odentia/channels": "workspace:*",
    "@odentia/clinical": "workspace:*",
    "drizzle-orm": "0.45.2",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "drizzle-kit": "0.31.10",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "^3.2.7",
    "xlsx": "0.18.5"
  }
}
