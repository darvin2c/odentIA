{
  "name": "@odentia/services",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./test-patient": "./src/test-patient.ts",
    "./dental": "./src/dental/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed:dev": "tsx --env-file-if-exists=../../infra/dev/.env src/seed-dev.ts",
    "mail:preview": "tsx --env-file-if-exists=../../infra/dev/.env src/mail-preview.ts",
    "bench:reports": "tsx --env-file-if-exists=../../infra/dev/.env src/bench-reports.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1131.0",
    "@aws-sdk/s3-request-presigner": "3.1131.0",
    "@odentia/auth": "workspace:*",
    "@odentia/channels": "workspace:*",
    "@odentia/clinical": "workspace:*",
    "@odentia/db": "workspace:*",
    "@odentia/dental": "workspace:*",
    "@odentia/mail": "workspace:*",
    "@pdf-lib/fontkit": "1.1.1",
    "@simplewebauthn/server": "14.0.3",
    "drizzle-orm": "0.45.2",
    "pdf-lib": "1.17.1",
    "postgres": "3.4.9",
    "sharp": "0.34.4",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "better-auth": "1.7.4",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  }
}
