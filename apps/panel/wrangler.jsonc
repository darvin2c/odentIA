// El panel en Cloudflare Workers (ADR 0137): el de odentIA y, con `CLOUDFLARE_ENV=latidia` al
// compilar, el de latidIA. El build con `WEB_TARGET=cloudflare` arma desde aquí el
// `dist/server/wrangler.json` que publica `wrangler deploy`. Sin `routes`: la ruta de `app.<dominio>`
// vive en el panel de Cloudflare (docs/deployment.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "odentia-panel",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "env": {
    "latidia": {
      "name": "latidia-panel",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true }
    }
  }
}
