{
  "name": "@odentia/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#components/*": "./src/components/*.tsx",
    "#lib/*": "./src/lib/*.ts",
    "#hooks/*": "./src/hooks/*.ts",
    "#storybook/api": "./.storybook/mocks/api.ts",
    "#storybook/crm": "./.storybook/mocks/crm.ts"
  },
  "scripts": {
    "dev": "node --import ../../scripts/local-network.mjs ../../node_modules/portless/dist/cli.js",
    "dev:app": "vite dev",
    "build": "vite build",
    "start": "node server.mjs",
    "storybook": "storybook dev -p 6006 --no-open",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@fontsource-variable/raleway": "5.3.0",
    "@odentia/auth": "workspace:*",
    "@odentia/clinical": "workspace:*",
    "@odentia/ui": "workspace:*",
    "@odentia/ui-patterns": "workspace:*",
    "@simplewebauthn/browser": "14.0.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-form": "1.33.5",
    "@tanstack/react-query": "5.102.8",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-start": "1.168.52",
    "@tanstack/react-table": "^8.21.3",
    "better-auth": "1.7.4",
    "cn": "0.2.6",
    "lucide-react": "^0.468.0",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "srvx": "0.11.22",
    "react-easy-crop": "6.2.3",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "vite": "8.3.0",
    "zod": "4.6.2"
  },
  "devDependencies": {
    "@storybook/react": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "storybook": "10.6.0",
    "typescript": "7.0.2",
    "vitest": "^3.2.7"
  },
  "portless": {
    "name": "odentia",
    "script": "dev:app"
  }
}
