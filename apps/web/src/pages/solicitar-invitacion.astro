---
// La dirección de la antigua lista de espera: el alta es libre y ya no hay invitación que pedir. Los
// enlaces ya enviados (correos, guías en PDF, chats) llevan al registro, donde se crea la cuenta y se
// abre la clínica al momento; sin plan publicado (vistIA hoy), a escribirnos. Para siempre (301), sin
// indexar y fuera del mapa del sitio (`FUERA_DEL_MAPA` en astro.config.mjs).
import { contactHref, registerUrl } from "../lib/site"
import { shownPlan } from "../lib/pricing"

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow")
return Astro.redirect(shownPlan(Astro.locals.pricing) ? registerUrl : contactHref, 301)
---
