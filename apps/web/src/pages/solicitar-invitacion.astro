---
// «Pide tus USD 100» (Fundadores, issue 165): la solicitud de la lista de espera. Mientras se abren
// clínicas solo con invitación es el destino de todos los botones de la web; las cifras salen del
// plan Fundadores publicado en la administración.
import WaitlistSplit from "../components/founders/WaitlistSplit"
import Base from "../layouts/Base.astro"
import { giftOf } from "../lib/pricing"

const pricing = Astro.locals.pricing
const founder = pricing.founders
const gift = giftOf(pricing)
const title = gift ? `Pide tus ${gift}: programa Fundadores` : "Solicita tu invitación"
const description = gift
  ? `Programa Fundadores de odentIA: los primeros ${gift} de tus agentes los pagamos nosotros. Se entra por invitación; te respondemos en 2 días hábiles.`
  : "Programa Fundadores de odentIA: se entra por invitación; te respondemos en 2 días hábiles."
---
<Base title={title} description={description} header="light">
  <WaitlistSplit
    client:load
    gift={gift}
    discountPercent={founder?.discountPercent ?? null}
    noFee={founder ? founder.plan === 0 : false}
  />
</Base>
