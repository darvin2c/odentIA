---
// Inicio de la web: portada «D3» y las secciones del lienzo aprobado, en su orden.
import CtaBand from "../components/CtaBand.astro"
import Faq from "../components/Faq.astro"
import AgentsSection from "../components/home/AgentsSection.astro"
import CaseSection from "../components/home/CaseSection.astro"
import ControlSection from "../components/home/ControlSection.astro"
import { homeFaq } from "../components/home/faqItems"
import HomeHero from "../components/home/HomeHero"
import OmniSection from "../components/home/OmniSection.astro"
import StickyCta from "../components/home/StickyCta.astro"
import SystemSection from "../components/home/SystemSection.astro"
import TrustSection from "../components/home/TrustSection.astro"
import ValueSection from "../components/home/ValueSection.astro"
import "../components/home/home.css"
import LatidiaHome from "../components/latidia/LatidiaHome.astro"
import Base from "../layouts/Base.astro"
import { faqJsonLd } from "../lib/faq"
import { MEDICAL } from "../lib/product"
import { businessDays, giftOf, shownPlan } from "../lib/pricing"
import { ctaOf } from "../lib/site"

const title = MEDICAL
  ? "latidIA · Software médico omnicanal y agéntico con IA"
  : "odentIA · Software dental omnicanal y agéntico con IA"
const description = MEDICAL
  ? "Software para consultorios médicos: WhatsApp, Instagram, correo y más en una sola ficha por persona, con agentes de IA que agendan, ordenan la consulta que dictas y traen de vuelta a tus pacientes."
  : "Software para clínicas dentales: WhatsApp, Instagram, correo y más en una sola ficha por persona, con agentes de IA que agendan, documentan la consulta y traen de vuelta a tus pacientes."
const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const cta = ctaOf(pricing)
const gift = giftOf(pricing)
const HOME_FAQ = homeFaq(plan, pricing.terms, plan !== null && plan === pricing.founders)
const answer = businessDays(pricing.terms.waitlistAnswerDays)
// Mientras se entra por invitación, la nota de la portada dice el regalo y cómo se entra.
const note =
  pricing.signupMode === "invitacion"
    ? { gift, text: gift ? `de regalo para tus agentes, sin cuota ni tarjeta. Se entra por invitación; te respondemos en ${answer}.` : `Se entra por invitación; te respondemos en ${answer}.` }
    : undefined
// La pregunta pendiente de confirmar se muestra en la página, pero no se publica en los datos estructurados.
const faqLd = faqJsonLd(HOME_FAQ.filter((q) => !q.pending))
const softwareLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: MEDICAL ? "latidIA" : "odentIA",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
}
---
<Base title={title} description={description} jsonLd={MEDICAL ? [softwareLd] : [softwareLd, faqLd]}>
  {MEDICAL ? <LatidiaHome /> : (
  <div class="home">
    <HomeHero client:load ctaHref={cta.href} ctaLabel={cta.label} note={note} />
    <OmniSection />
    <AgentsSection />
    <CaseSection />
    <ControlSection />
    <ValueSection />
    <SystemSection />
    <TrustSection />
    <Faq items={HOME_FAQ} tag="08 · Preguntas" />
    <CtaBand
      text={plan
        ? `Pruébalo ${plan.trialDays} días: tus agentes trabajan en tu clínica desde el primer día, con el crédito de prueba. Sin límite de odontólogos, sedes ni usuarios.`
        : "Tus agentes trabajan en tu clínica desde el primer día. Sin límite de odontólogos, sedes ni usuarios."}
    />
    <StickyCta />
  </div>
  )}
</Base>
