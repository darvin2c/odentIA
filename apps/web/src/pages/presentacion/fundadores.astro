---
// La presentación de Fundadores (odentia32.com/presentacion/fundadores y latidia72.com/presentacion/fundadores): la de
// cada producto, a pantalla completa y sin cabecera ni pie (vistIA todavía no tiene la suya y no sirve
// /presentacion). Es para mostrarla en una llamada o enviarla a quien preguntó, no para buscadores: no se indexa ni va en el mapa del sitio. Sus cifras
// salen de la administración (src/presentations/figures.ts). Las tipografías son las de la web, servidas
// desde el mismo dominio: la web no llama a terceros (política de cookies).
import "@fontsource-variable/manrope"
import "@fontsource/ibm-plex-mono/latin-400.css"
import "@fontsource/ibm-plex-mono/latin-500.css"
import "@fontsource/ibm-plex-mono/latin-600.css"
import "@fontsource/ibm-plex-mono/latin-700.css"
import { ECG } from "../../components/latidia/home/DictationDemo"
import { ICON, LOGO } from "../../lib/logos"
import { BRAND, ofProduct, PRODUCT, WORDS } from "../../lib/product"
import { contactHref } from "../../lib/site"
import { deckFigures, fillDeck, withClinic, withoutGuide } from "../../presentations/figures"
import LatidiaScripts from "../../presentations/LatidiaScripts.astro"
import latidiaClinic from "../../presentations/latidia/clinic-slide.html?raw"
import latidiaDeck from "../../presentations/latidia/deck.html?raw"
import OdentiaScripts from "../../presentations/OdentiaScripts.astro"
import odentiaClinic from "../../presentations/odentia/clinic-slide.html?raw"
import odentiaDeck from "../../presentations/odentia/deck.html?raw"

Astro.response.headers.set("X-Robots-Tag", "noindex, nofollow")

// La presentación de cada producto: su deck, su clínica en 3D, sus guiones y el día de ejemplo (lo que
// cobra además de la cita recuperada). vistIA todavía no tiene la suya.
const spec = ofProduct({
  dental: { deck: odentiaDeck, clinic: odentiaClinic, Scripts: OdentiaScripts, day: ["gestiona", "estandar"] as const },
  medical: { deck: latidiaDeck, clinic: latidiaClinic, Scripts: LatidiaScripts, day: ["agenda", "estandar", "informa"] as const },
  optical: null,
})
const figures = spec ? deckFigures(Astro.locals.pricing, [...spec.day]) : null
const Scripts = spec?.Scripts
// El logotipo de la web, sin su título para que no aparezca como globo al pasar el puntero.
const logo = LOGO.dark
  .replace(/<title>[^<]*<\/title>/, "")
  .replace("<svg ", `<svg aria-label="${WORDS.name}" role="img" `)
// El guion es para quien presenta: solo viene con /presentacion/fundadores?guion.
const guide = Astro.url.searchParams.has("guion")
// La v2, con la clínica en 3D: solo con /presentacion/fundadores?v2.
const source = !spec ? null : Astro.url.searchParams.has("v2") ? withClinic(spec.deck, spec.clinic, PRODUCT) : spec.deck
const deck = figures && source
  ? fillDeck(guide ? source : withoutGuide(source), { ...figures, logo, ecg: ECG })
  : null
---
<!doctype html>
<html lang="es" data-brand={BRAND}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{WORDS.name} Fundadores</title>
    <meta name="theme-color" content={WORDS.themeColor} />
    <link rel="icon" href={ICON.svg} type="image/svg+xml" />
  </head>
  <body>
    {deck ? (
      <>
        <Fragment set:html={deck} />
        {Scripts ? <Scripts /> : null}
      </>
    ) : (
      <main class="soon">
        <p>{WORDS.name} Fundadores</p>
        <h1>Los precios se publican pronto.</h1>
        <p>Escríbenos y te mostramos la presentación en una llamada.</p>
        <a href={contactHref}>Habla con nosotros</a>
      </main>
    )}
    <style>
      .soon { min-height: 100vh; display: grid; place-content: center; gap: 16px; padding: 24px; text-align: center; font-family: Manrope, system-ui, sans-serif; background: #0a2129; color: #f1f5f9; }
      :global([data-brand="latidia"]) .soon { background: #1e0b3d; }
      :global([data-brand="vistia"]) .soon { background: #0a2615; }
      .soon h1 { margin: 0; font-size: clamp(28px, 5vw, 48px); }
      .soon a { color: inherit; font-weight: 700; }
    </style>
  </body>
</html>
