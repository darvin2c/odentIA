---
import CtaBand from "../components/CtaBand.astro"
import Faq from "../components/Faq.astro"
import Difference from "../components/pricing/Difference.astro"
import HowWeCharge from "../components/pricing/HowWeCharge.astro"
import PlanPrices from "../components/pricing/PlanPrices.astro"
import PricingHero from "../components/pricing/PricingHero"
import ValueSection from "../components/pricing/ValueSection.astro"
// Precios: pagas por el valor que recibes, no por el software. Todas las cifras salen de lib/pricing.
import Base from "../layouts/Base.astro"
import { breadcrumbJsonLd, type FaqItem, faqJsonLd } from "../lib/faq"
import {
  CONSULTATION,
  CONVERSATION,
  PLAN,
  PRICING,
  RECOVERED,
  TRIAL_CREDIT,
  usd,
} from "../lib/pricing"

const title = "Precios: pagas por el valor, no por el software"
const description = `Software para clínicas dentales con un plan de ${usd(PLAN)} al mes que vuelve como crédito. Pagas por conversación atendida, consulta documentada o cita recuperada; sin resultado, no hay cobro. Prueba ${PRICING.trialDays} días sin tarjeta.`

const faq: FaqItem[] = [
  {
    q: "¿Por qué no hay planes con más funciones?",
    a: "Porque no vendemos funciones. Todas las clínicas tienen el sistema completo; lo que cambia de una a otra es cuánto trabajo hacen sus agentes, y solo eso se paga.",
  },
  {
    q: "¿Y si un mes mis agentes gastan mucho?",
    a: "Pones un tope de gasto. Te avisamos al acercarte y, al llegar, los casos nuevos pasan a tu equipo. Ningún paciente se queda sin respuesta.",
  },
  {
    q: "¿Qué pasa si no uso el crédito?",
    a: `Si en un mes tus agentes usan menos que el crédito, pagas solo los ${usd(PLAN)} del plan. El crédito es el de ese mes.`,
  },
  {
    q: "¿La prueba pide tarjeta?",
    a: `No. Te registras, conectas tus canales y tus agentes trabajan ${PRICING.trialDays} días con el crédito de prueba. La tarjeta solo se pide si decides activar el plan.`,
  },
  {
    q: "¿Cada cuánto me cobran?",
    a: "Tu mes empieza el día que activas el plan. Lo que pasa del crédito se factura cada mes o cada 15 días, como prefieras.",
  },
  {
    q: "¿WhatsApp cobra aparte?",
    a: "Responder a quien te escribió, dentro de las 24 horas, no tiene costo de Meta. Los mensajes de plantilla los cobra Meta directamente a tu clínica; odentIA te muestra el estimado.",
  },
  {
    q: "¿Y si mi clínica tiene mucho movimiento?",
    a: "Escríbenos. Revisamos tu caso y te damos un precio por acción para tu volumen.",
  },
]

const pageUrl = new URL("/precios", Astro.site).toString()
const product = {
  "@context": "https://schema.org",
  "@type": "Product",
  name: "Plan odentIA",
  description: `Plataforma omnicanal y agéntica para clínicas dentales. El plan de ${usd(PLAN)} al mes vuelve completo como crédito para los agentes; cada conversación atendida cuesta ${usd(CONVERSATION)}, cada consulta documentada ${usd(CONSULTATION)} y cada cita recuperada ${usd(RECOVERED)}.`,
  brand: { "@type": "Brand", name: "odentIA" },
  url: pageUrl,
  offers: {
    "@type": "Offer",
    url: pageUrl,
    price: PLAN.toFixed(2),
    priceCurrency: PRICING.currency,
    availability: "https://schema.org/InStock",
    priceSpecification: {
      "@type": "UnitPriceSpecification",
      price: PLAN.toFixed(2),
      priceCurrency: PRICING.currency,
      unitCode: "MON",
      referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitCode: "MON" },
    },
  },
}
const jsonLd = [
  product,
  faqJsonLd(faq),
  breadcrumbJsonLd(Astro.site, [
    ["Inicio", "/"],
    ["Precios", "/precios"],
  ]),
]
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <PricingHero client:load />
  <HowWeCharge />
  <PlanPrices />
  <ValueSection />
  <Difference />
  <Faq items={faq} title="Sobre el precio." />
  <CtaBand
    title={`Obtén ${usd(TRIAL_CREDIT)} de crédito y pruébalo ${PRICING.trialDays} días.`}
    text="Con ese crédito tus agentes trabajan en tu clínica desde el primer día. Precios en dólares, más los impuestos de tu país."
  />
</Base>
