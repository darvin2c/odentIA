---
import CtaBand from "../components/CtaBand.astro"
import Faq from "../components/Faq.astro"
import Difference from "../components/pricing/Difference.astro"
import HowWeCharge from "../components/pricing/HowWeCharge.astro"
import PlanPrices from "../components/pricing/PlanPrices.astro"
import PricingHero from "../components/pricing/PricingHero"
import ValueSection from "../components/pricing/ValueSection.astro"
// Precios: pagas por el valor que recibes, no por el software. Todas las cifras salen de lib/pricing.
import Base from "../layouts/Base.astro"
import { breadcrumbJsonLd, type FaqItem, faqJsonLd } from "../lib/faq"
import { businessDays, days, giftOf, money, shownPlan, valuePricesOf } from "../lib/pricing"
import { ctaOf } from "../lib/site"

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const founder = plan !== null && plan === pricing.founders ? pricing.founders : null
const prices = valuePricesOf(plan)
const cta = ctaOf(pricing)
const gift = giftOf(pricing)
const m = (value: number | null) => (plan && value !== null ? money(value, plan.currency) : "—")
// Las condiciones comerciales: de la administración, como los precios (issue 167).
const terms = pricing.terms

const title = "Precios: pagas por el valor, no por el software"
const description = !plan
  ? "Software para clínicas dentales: pagas por conversación atendida, consulta documentada o cita recuperada; sin resultado, no hay cobro."
  : founder
    ? `Software para clínicas dentales. Programa Fundadores: sin cuota y con ${m(plan.trialCredit)} de regalo para tus agentes; después pagas solo por conversación atendida, consulta documentada o cita recuperada${founder.discountPercent ? `, con ${founder.discountPercent} % menos` : ""}.`
    : `Software para clínicas dentales con un plan de ${m(plan.plan)} al mes que vuelve como crédito. Pagas por conversación atendida, consulta documentada o cita recuperada; sin resultado, no hay cobro. Prueba ${plan.trialDays} días sin tarjeta.`
const lead = !plan
  ? "Lo que pagas depende de lo que tus agentes logran en tu clínica. Cada resultado tiene su precio, y lo que no da resultado no se cobra."
  : founder
    ? `Lo que pagas depende de lo que tus agentes logran en tu clínica. Como Fundador entras sin cuota y los primeros ${m(plan.trialCredit)} los pagamos nosotros. Lo que no da resultado no se cobra.`
    : `Lo que pagas depende de lo que tus agentes logran en tu clínica. Un plan de ${m(plan.plan)} al mes que vuelve completo como crédito. Cada resultado tiene su precio, y lo que no da resultado no se cobra.`

const faq: FaqItem[] = [
  {
    q: "¿Por qué no hay planes con más funciones?",
    a: "Porque no vendemos funciones. Todas las clínicas tienen el sistema completo; lo que cambia de una a otra es cuánto trabajo hacen sus agentes, y solo eso se paga.",
  },
  {
    // ADR 0047 y 0054: lo decide el modelo de decisión de toda clínica; si duda, se atiende y cuenta.
    q: "¿Me cobran si alguien escribe algo que no tiene que ver con la clínica?",
    a: "No. El spam (publicidad, cadenas, estafas, quien le vende algo a la clínica) va a una lista aparte: no se responde ni se cobra. Si alguien pregunta, por ejemplo, si venden zapatillas, el agente le responde con un texto fijo que dice en qué puede ayudar, y eso no cuenta como conversación. Si el agente duda, lo atiende como cualquier mensaje y sí cuenta.",
  },
  {
    // ADR 0054: «Pedir revisión», no «reclamo», que es el del Libro de Reclamaciones.
    q: "¿Y si me cobran algo que no debía?",
    a: `Pides revisión desde la fila, en tu cuenta, de lo de este mes o del anterior. ${
      terms.reviewAutoPercent > 0
        ? `Si era spam, se devuelve al instante, hasta el ${terms.reviewAutoPercent} % de tus conversaciones del mes. Lo demás lo revisamos`
        : "Lo revisamos"
    } y te respondemos en ${businessDays(terms.reviewAnswerDays)}. Lo que ya estaba facturado vuelve en tu cargo siguiente.`,
  },
  {
    q: "¿Y si un mes mis agentes gastan mucho?",
    a: "Pones un tope de gasto. Te avisamos al acercarte y, al llegar, los casos nuevos pasan a tu equipo. Ningún paciente se queda sin respuesta.",
  },
  {
    q: "¿Qué pasa si no uso el crédito?",
    a: founder
      ? "Como Fundador no pagas cuota: si un mes tus agentes no hacen nada, no pagas nada."
      : `Si en un mes tus agentes usan menos que el crédito, pagas solo los ${m(plan?.plan ?? null)} del plan. El crédito es el de ese mes.`,
  },
  {
    q: "¿La prueba pide tarjeta?",
    a: founder
      ? `No. Pides tu invitación, abres tu clínica y tus agentes empiezan con los ${m(plan?.trialCredit ?? null)} de regalo. La tarjeta no se pide.`
      : `No. Te registras, conectas tus canales y tus agentes trabajan ${days(plan?.trialDays ?? terms.trialDays)} con el crédito de prueba. La tarjeta solo se pide si decides activar el plan.`,
  },
  {
    q: "¿Cada cuánto me cobran?",
    a: `Tu mes empieza el día que activas el plan. Lo que pasa del crédito se factura al cerrar el mes o, si prefieres, dos veces: a los ${days(terms.halfCycleDays)} y al cerrar el mes.`,
  },
  {
    q: "¿WhatsApp cobra aparte?",
    a: "Responder a quien te escribió, dentro de las 24 horas, no tiene costo de Meta. Los mensajes de plantilla los cobra Meta directamente a tu clínica; odentIA te muestra el estimado.",
  },
  {
    q: "¿Y si mi clínica tiene mucho movimiento?",
    a: "Escríbenos. Revisamos tu caso y te damos un precio por acción para tu volumen.",
  },
]

const pageUrl = new URL("/precios", Astro.site).toString()
const product = plan
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      name: founder ? "odentIA · Programa Fundadores" : `${plan.name} · odentIA`,
      description: `Plataforma omnicanal y agéntica para clínicas dentales. ${
        founder ? "Sin cuota mensual" : `El plan de ${m(plan.plan)} al mes vuelve completo como crédito para los agentes`
      }; cada conversación atendida cuesta ${m(plan.conversation)}, cada consulta documentada ${m(plan.consultation)} y cada cita recuperada ${m(plan.recovered)}.`,
      brand: { "@type": "Brand", name: "odentIA" },
      url: pageUrl,
      offers: {
        "@type": "Offer",
        url: pageUrl,
        price: plan.plan.toFixed(2),
        priceCurrency: plan.currency,
        availability: "https://schema.org/InStock",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: plan.plan.toFixed(2),
          priceCurrency: plan.currency,
          unitCode: "MON",
          referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitCode: "MON" },
        },
      },
    }
  : null
const jsonLd = [
  ...(product ? [product] : []),
  faqJsonLd(faq),
  breadcrumbJsonLd(Astro.site, [
    ["Inicio", "/"],
    ["Precios", "/precios"],
  ]),
]
---
<Base title={title} description={description} jsonLd={jsonLd}>
  {prices ? <PricingHero client:load prices={prices} ctaHref={cta.href} ctaLabel={cta.label} lead={lead} /> : null}
  <HowWeCharge />
  <PlanPrices />
  <ValueSection />
  <Difference />
  <Faq items={faq} title="Sobre el precio." />
  <CtaBand
    title={gift ? (founder ? `Los primeros ${gift} los pagamos nosotros.` : `Obtén ${gift} de crédito y pruébalo ${plan?.trialDays} días.`) : "Tu equipo, de vuelta con sus pacientes."}
    text={`Con ese crédito tus agentes trabajan en tu clínica desde el primer día. Precios en ${plan?.currency === "USD" ? "dólares" : (plan?.currency ?? "dólares")}, más los impuestos de tu país.`}
  />
</Base>
