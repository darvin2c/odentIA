---
import CtaBand from "../components/CtaBand.astro"
import Faq from "../components/Faq.astro"
import AgentPrices from "../components/pricing/AgentPrices.astro"
import NeverCharged from "../components/pricing/NeverCharged.astro"
import PricingHero from "../components/pricing/PricingHero.astro"
import ValueSection from "../components/pricing/ValueSection.astro"
// Precios: no pagas por el software, pagas por el trabajo hecho. Todas las cifras salen de lib/pricing.
import Base from "../layouts/Base.astro"
import { breadcrumbJsonLd, type FaqItem, faqJsonLd } from "../lib/faq"
import { businessDays, days, giftOf, money, shownPlan } from "../lib/pricing"
import { WORDS } from "../lib/product"

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const founder = plan !== null && plan === pricing.founders ? pricing.founders : null
const gift = giftOf(pricing)
const m = (value: number | null) => (plan && value !== null ? money(value, plan.currency) : "—")
// Las condiciones comerciales: de la administración, como los precios (issue 167).
const terms = pricing.terms

const title = "Precios: pagas por el trabajo hecho, no por el software"
// Lo que cobra cada agente, de lo más simple a lo que trae pacientes (ADR 0085).
const range = plan ? `desde ${m(plan.tiers.informa)} una respuesta hasta ${m(plan.recovered)} una cita recuperada` : null
const description = !plan
  ? `Software para ${WORDS.audience}: pagas por lo que hacen tus agentes, no por el software. Lo simple cuesta poco y lo que te trae pacientes cuesta más.`
  : founder
    ? `Software para ${WORDS.audience}. Programa Fundadores: sin cuota y con ${m(plan.trialCredit)} de regalo para tus agentes; después pagas solo lo que hacen, ${range}${founder.discountPercent ? ` (${founder.discountPercent} % menos que el precio de lista)` : ""}.`
    : `Software para ${WORDS.audience} con un plan de ${m(plan.plan)} al mes que vuelve como crédito. Pagas por lo que hacen tus agentes, ${range}. Prueba ${plan.trialDays} días sin tarjeta.`
const faq: FaqItem[] = [
  {
    // ADR 0085: reservar ya es «Gestiona»; la cita que se da suma la diferencia hasta «Agenda».
    q: "¿Me cobran si Sofi reserva y el paciente no viene?",
    a: "Sí, como «gestiona»: Sofi hizo el trabajo de agendar. Si el paciente viene, se suma la diferencia hasta «agenda». Si era una cita recuperada por Argos, se cobra solo la cita.",
  },
  {
    q: "¿Y si un mes mis agentes gastan mucho?",
    a: "Pones un presupuesto del mes. Te avisamos al acercarte y, al llegar, Sofi pasa las conversaciones nuevas a tu equipo con un mensaje fijo, Clío no escucha en las atenciones nuevas y Argos no escribe para recuperar. Lo que ya empezó se termina y ningún paciente se queda sin respuesta.",
  },
  {
    q: "¿Cuántas preguntas le puedo hacer a Argos?",
    a: plan?.argos
      ? `${plan.argos.included} al mes vienen incluidas. Al usarlas, Argos te pregunta antes de sumar ${plan.argos.packQuestions} más por ${m(plan.argos.pack)}; si prefieres, se suman solas. Las que no puede responder no cuentan.`
      : "Las que necesites: Argos responde con las cifras de tu clínica.",
  },
  {
    q: "¿Y WhatsApp?",
    a: `WhatsApp lo cobra Meta directamente a tu clínica, con sus propias tarifas, y lo revisas en tu cuenta de Meta. ${WORDS.name} no lo cobra ni lo estima.`,
  },
  {
    q: "¿Por qué no hay planes con más funciones?",
    a: "Porque no vendemos funciones. Todas las clínicas tienen el sistema completo; lo que cambia de una a otra es cuánto trabajo hacen sus agentes, y solo eso se paga.",
  },
  {
    // ADR 0047 y 0054: lo decide el modelo de decisión de toda clínica; si duda, se atiende y cuenta.
    q: "¿Me cobran si alguien escribe algo que no tiene que ver con la clínica?",
    a: "No. El spam (publicidad, cadenas, estafas, quien le vende algo a la clínica) va a una lista aparte: no se responde ni se cobra. Si alguien pregunta, por ejemplo, si venden zapatillas, el agente le responde con un texto fijo que dice en qué puede ayudar, y eso no cuenta como conversación. Si el agente duda, lo atiende como cualquier mensaje y sí cuenta.",
  },
  {
    // ADR 0054: «Pedir revisión», no «reclamo», que es el del Libro de Reclamaciones.
    q: "¿Y si me cobran algo que no debía?",
    a: `Pides revisión desde la fila, en tu cuenta, de lo de este mes o del anterior. ${
      terms.reviewAutoPercent > 0
        ? `Si era spam, se devuelve al instante, hasta el ${terms.reviewAutoPercent} % de tus conversaciones del mes. Lo demás lo revisamos`
        : "Lo revisamos"
    } y te respondemos en ${businessDays(terms.reviewAnswerDays)}. Lo que ya estaba facturado vuelve en tu cargo siguiente.`,
  },
  {
    q: `¿Y si mis ${WORDS.heavyImages} ocupan mucho?`,
    a: plan?.storage
      ? `Tienes ${plan.storage.includedGb} GB incluidos. Desde ahí, cada GB cuesta ${m(plan.storage.perGb)} al mes, y nunca dejamos de guardar.`
      : "Lo que guardas no tiene tope: nunca dejamos de guardar.",
  },
  {
    q: "¿Qué no se cobra?",
    a: "El spam, los mensajes ajenos a tu clínica, lo que responde tu equipo, los recordatorios y avisos de cita, y el borrador que descartas.",
  },
  // Sin un plan publicado no hay cuota ni crédito que explicar.
  ...(plan
    ? [
        {
          q: "¿Qué pasa si no uso el crédito?",
          a: founder
            ? "Como Fundador no pagas cuota: si un mes tus agentes no hacen nada, no pagas nada."
            : `Si en un mes tus agentes usan menos que el crédito, pagas solo los ${m(plan.plan)} del plan. El crédito es el de ese mes.`,
        },
      ]
    : []),
  {
    q: "¿La prueba pide tarjeta?",
    a: founder
      ? `No. Pides tu invitación, abres tu clínica y tus agentes empiezan con los ${m(plan?.trialCredit ?? null)} de regalo. La tarjeta no se pide.`
      : `No. Te registras, conectas tus canales y tus agentes trabajan ${days(plan?.trialDays ?? terms.trialDays)} con el crédito de prueba. La tarjeta solo se pide si decides activar el plan.`,
  },
  {
    q: "¿Cada cuánto me cobran?",
    a: `Tu mes empieza el día que activas el plan. Lo que pasa del crédito se factura al cerrar el mes o, si prefieres, dos veces: a los ${days(terms.halfCycleDays)} y al cerrar el mes.`,
  },
  {
    q: "¿Y si mi clínica tiene mucho movimiento?",
    // ADR 0085: solo se negocian Gestiona, Agenda, Completa y la cita recuperada; lo demás es fijo.
    a: "Escríbenos. Revisamos tu caso y te proponemos un precio para tu volumen en las citas que Sofi gestiona, la consulta en la que Clío arma el presupuesto y la cita recuperada. Lo demás tiene un precio fijo.",
  },
]

const pageUrl = new URL("/precios", Astro.site).toString()
const product = plan
  ? {
      "@context": "https://schema.org",
      "@type": "Product",
      name: founder ? `${WORDS.name} · Programa Fundadores` : `${plan.name} · ${WORDS.name}`,
      description: `Plataforma omnicanal y agéntica para ${WORDS.audience}. ${
        founder ? "Sin cuota mensual" : `El plan de ${m(plan.plan)} al mes vuelve completo como crédito para los agentes`
      }; cada agente cobra por lo que hizo, ${range}.`,
      brand: { "@type": "Brand", name: WORDS.name },
      url: pageUrl,
      offers: {
        "@type": "Offer",
        url: pageUrl,
        price: plan.plan.toFixed(2),
        priceCurrency: plan.currency,
        availability: "https://schema.org/InStock",
        priceSpecification: {
          "@type": "UnitPriceSpecification",
          price: plan.plan.toFixed(2),
          priceCurrency: plan.currency,
          unitCode: "MON",
          referenceQuantity: { "@type": "QuantitativeValue", value: 1, unitCode: "MON" },
        },
      },
    }
  : null
const jsonLd = [
  ...(product ? [product] : []),
  faqJsonLd(faq),
  breadcrumbJsonLd(Astro.site, [
    ["Inicio", "/"],
    ["Precios", "/precios"],
  ]),
]
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <PricingHero />
  <AgentPrices />
  <NeverCharged />
  <ValueSection />
  <div class="faqwrap"><Faq items={faq} title="Sobre el precio." /></div>
  <CtaBand title="Pagas por el trabajo hecho. Empieza hoy.">
    <Fragment slot="text">
      {gift ? (
        founder ? (
          <>Los primeros <span class="gift">{gift}</span> de tus agentes los pagamos nosotros. Sin tarjeta y sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
        ) : (
          <>Obtén <span class="gift">{gift}</span> de crédito y pruébalo {days(plan?.trialDays ?? pricing.terms.trialDays)} sin tarjeta, sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
        )
      ) : (
        `Tus agentes trabajan en ${WORDS.yourClinic} desde el primer día, sin tarjeta y sin límite de ${WORDS.clinicians}, sedes ni usuarios.`
      )}
    </Fragment>
  </CtaBand>
</Base>

<style>
  .faqwrap { background: var(--bg); }
</style>
