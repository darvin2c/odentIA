---
// Documento de cada página: título y descripción propios, datos estructurados, cabecera y pie.
import latidiaFavicon from "../../../../assets/brand/latidia/favicon.svg?url"
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import { MEDICAL, WORDS } from "../lib/product"
import "../styles/web.css"

interface Props {
  title: string
  description: string
  /** Datos estructurados schema.org (Product, FAQPage, BreadcrumbList…). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Cabecera sobre fondo oscuro (portadas) o claro; «none» para una página que lleva el logo dentro
   *  (la solicitud de Fundadores: un formulario, sin menú que distraiga). */
  header?: "dark" | "light" | "none"
  /** «legal»: solo la fila legal del pie, sin el mapa de la web. */
  footer?: "full" | "legal"
  noindex?: boolean
}

const { title, description, jsonLd, header = "dark", footer = "full", noindex = false } = Astro.props
// Al compilar la ruta es el archivo (/precios.html, /index.html); la dirección pública,
// la del mapa del sitio y los enlaces, va sin .html.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/", Astro.site)
const fullTitle = title.includes(WORDS.name) ? title : `${title} · ${WORDS.name}`
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: WORDS.name,
  url: Astro.site?.toString(),
  logo: new URL(MEDICAL ? latidiaFavicon : "/favicon.svg", Astro.site).toString(),
}
const ld = [org, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
---
<!doctype html>
<html lang="es" data-brand={MEDICAL ? "latidia" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_419" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={WORDS.themeColor} />
    {MEDICAL ? (
      <link rel="icon" href={latidiaFavicon} type="image/svg+xml" />
    ) : (
      <>
        <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
        <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
      </>
    )}
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    {header === "none" ? null : <Header variant={header} />}
    <main id="contenido">
      <slot />
    </main>
    <Footer legalOnly={footer === "legal"} />
  </body>
</html>
