---
// Documento de cada página: título y descripción propios, datos estructurados, cabecera y pie.
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import { ICON } from "../lib/logos"
import { BRAND, WORDS } from "../lib/product"
import "../styles/web.css"

interface Props {
  title: string
  description: string
  /** Datos estructurados schema.org (Product, FAQPage, BreadcrumbList…). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Cabecera sobre fondo oscuro (portadas) o claro; «none» para una página que lleva el logo dentro
   *  (la solicitud de Fundadores: un formulario, sin menú que distraiga). */
  header?: "dark" | "light" | "none"
  /** «legal»: solo la fila legal del pie, sin el mapa de la web. */
  footer?: "full" | "legal"
  noindex?: boolean
}

const { title, description, jsonLd, header = "dark", footer = "full", noindex = false } = Astro.props
// Al compilar la ruta es el archivo (/precios.html, /index.html); la dirección pública,
// la del mapa del sitio y los enlaces, va sin .html.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/", Astro.site)
const fullTitle = title.includes(WORDS.name) ? title : `${title} · ${WORDS.name}`
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: WORDS.name,
  url: Astro.site?.toString(),
  logo: new URL(ICON.svg, Astro.site).toString(),
}
const ld = [org, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
---
<!doctype html>
<html lang="es" data-brand={BRAND}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_419" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content={WORDS.themeColor} />
    {ICON.ico ? <link rel="icon" href={ICON.ico} sizes="16x16 32x32 48x48 64x64" /> : null}
    <link rel="icon" href={ICON.svg} type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    {header === "none" ? null : <Header variant={header} />}
    <main id="contenido">
      <slot />
    </main>
    <Footer legalOnly={footer === "legal"} />
    <script is:inline>
      // Cada bloque de una sección entra con suavidad la primera vez que se ve. Solo se prepara lo que
      // al cargar está más abajo de la pantalla: nada de lo que ya se ve se esconde ni salta, y sin
      // JavaScript o con menos movimiento todo está a la vista desde el principio. Es opacidad y un
      // desplazamiento corto dentro del propio bloque: no cambia el alto de nada ni empuja la página.
      ;(() => {
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return
        const blocks = []
        for (const wrap of document.querySelectorAll("main section:not(.hero) > .wrap")) {
          let n = 0
          for (const el of wrap.children) {
            // Las escenas (islas) traen su propio movimiento y las arma React: no se tocan.
            if (el.tagName === "ASTRO-ISLAND" || el.getBoundingClientRect().top < innerHeight) continue
            el.style.setProperty("--rv-d", Math.min(n++, 3) * 70 + "ms")
            el.setAttribute("data-rv", "")
            blocks.push(el)
          }
        }
        if (!blocks.length) return
        const seen = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.setAttribute("data-rv", "in")
              seen.unobserve(entry.target)
            }
          },
          { rootMargin: "0px 0px -6% 0px" },
        )
        for (const el of blocks) seen.observe(el)
      })()
    </script>
  </body>
</html>
