---
// Documento de cada página: título y descripción propios, datos estructurados, cabecera y pie.
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import "../styles/web.css"

interface Props {
  title: string
  description: string
  /** Datos estructurados schema.org (Product, FAQPage, BreadcrumbList…). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Cabecera sobre fondo oscuro (portadas) o claro. */
  header?: "dark" | "light"
  noindex?: boolean
}

const { title, description, jsonLd, header = "dark", noindex = false } = Astro.props
const canonical = new URL(Astro.url.pathname, Astro.site)
const fullTitle = title.includes("odentIA") ? title : `${title} · odentIA`
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  name: "odentIA",
  url: Astro.site?.toString(),
  logo: new URL("/favicon.svg", Astro.site).toString(),
}
const ld = [org, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_419" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#0a2129" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48 64x64" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <Header variant={header} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
  </body>
</html>
