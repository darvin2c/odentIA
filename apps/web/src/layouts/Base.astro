---
// Documento de cada página: título y descripción propios, datos estructurados, cabecera y pie.
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import { ICON } from "../lib/logos"
import { BRAND, ofProduct, WORDS } from "../lib/product"
import "../styles/web.css"

interface Props {
  title: string
  description: string
  /** Datos estructurados schema.org (Product, FAQPage, BreadcrumbList…). */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  /** Cabecera sobre fondo oscuro (portadas) o claro. */
  header?: "dark" | "light"
  noindex?: boolean
  /**
   * La imagen al compartir el enlace, si la página tiene la suya (una guía: su plantilla), y si es un
   * artículo, con sus fechas.
   */
  share?: { image: string; alt: string; article?: { published: string; modified: string } }
}

const { title, description, jsonLd, header = "dark", noindex = false, share } = Astro.props
// Al compilar la ruta es el archivo (/precios.html, /index.html); la dirección pública,
// la del mapa del sitio y los enlaces, va sin .html.
const canonical = new URL(Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/", Astro.site)
const fullTitle = title.includes(WORDS.name) ? title : `${title} · ${WORDS.name}`
// Cómo nos busca la gente: el nombre, el dominio («odentia32») y cómo se escribe sin la «IA» en
// mayúsculas. Google lo lee en WebSite (el nombre del sitio en los resultados) y en Organization, con
// un logo PNG (no lee SVG ni data:) y los perfiles en redes, que le confirman que somos la misma marca.
const identity = ofProduct({
  dental: {
    key: "odentia",
    alternateName: ["odentia32", "Odentia", "odentIA 32"],
    sameAs: [
      "https://www.facebook.com/odentia32",
      "https://www.linkedin.com/company/odentia32",
      "https://www.youtube.com/@odentIA32",
      "https://www.instagram.com/odentia32",
      "https://www.threads.com/@odentia32",
      "https://www.tiktok.com/@odentia32",
    ],
  },
  medical: {
    key: "latidia",
    alternateName: ["latidia72", "Latidia", "latidIA 72"],
    sameAs: ["https://www.facebook.com/latidia72", "https://www.linkedin.com/company/latidia72"],
  },
  optical: { key: "vistia", alternateName: ["vistia20", "Vistia", "vistIA 20"], sameAs: [] },
})
const siteUrl = Astro.site?.toString()
const ogImage = new URL(share?.image ?? `/img/marca/${identity.key}-og.png`, Astro.site).toString()
const org = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": `${siteUrl}#organizacion`,
  name: WORDS.name,
  alternateName: identity.alternateName,
  url: siteUrl,
  logo: new URL(`/img/marca/${identity.key}-logo.png`, Astro.site).toString(),
  ...(identity.sameAs.length ? { sameAs: identity.sameAs } : {}),
}
const site = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: WORDS.name,
  alternateName: identity.alternateName,
  url: siteUrl,
  inLanguage: "es",
  publisher: { "@id": org["@id"] },
}
// El sitio y la organización van en la portada; en las demás páginas basta la organización.
const isHome = canonical.pathname === "/"
const ld = [...(isHome ? [site] : []), org, ...(Array.isArray(jsonLd) ? jsonLd : jsonLd ? [jsonLd] : [])]
---
<!doctype html>
<html lang="es" data-brand={BRAND}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content={share?.article ? "article" : "website"} />
    {share?.article && <meta property="article:published_time" content={share.article.published} />}
    {share?.article && <meta property="article:modified_time" content={share.article.modified} />}
    <meta property="og:locale" content="es_419" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={WORDS.name} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={share?.alt ?? `${WORDS.name}: más que un CRM, un chatbot o un software tradicional. Somos un ARM.`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content={WORDS.themeColor} />
    {ICON.ico ? <link rel="icon" href={ICON.ico} sizes="16x16 32x32 48x48 64x64" /> : null}
    <link rel="icon" href={ICON.svg} type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* «<» va escapado: un texto que llega de afuera (el título de un video) no cierra el script. */}
    {ld.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item).replace(/</g, "\\u003c")} />)}
  </head>
  <body>
    <a class="skip" href="#contenido">Ir al contenido</a>
    <Header variant={header} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script is:inline>
      // Cada bloque de una sección aparece con un fundido la primera vez que asoma. Solo se prepara lo
      // que al cargar está más abajo de la pantalla: nada de lo que ya se ve se esconde, y sin
      // JavaScript o con menos movimiento todo está a la vista desde el principio. Es solo opacidad: no
      // cambia el alto ni la posición de nada.
      ;(() => {
        if (!("IntersectionObserver" in window) || matchMedia("(prefers-reduced-motion: reduce)").matches) return
        const blocks = []
        for (const wrap of document.querySelectorAll("main section:not(.hero) > .wrap")) {
          let n = 0
          for (const el of wrap.children) {
            // Las escenas (islas) traen su propio movimiento y las arma React: no se tocan.
            if (el.tagName === "ASTRO-ISLAND" || el.getBoundingClientRect().top < innerHeight) continue
            el.style.setProperty("--rv-d", Math.min(n++, 3) * 60 + "ms")
            el.setAttribute("data-rv", "")
            blocks.push(el)
          }
        }
        if (!blocks.length) return
        const seen = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue
              entry.target.setAttribute("data-rv", "in")
              seen.unobserve(entry.target)
            }
          },
          { rootMargin: "0px 0px 8% 0px" },
        )
        for (const el of blocks) seen.observe(el)
        // Con el teclado, lo que recibe el foco se ve al instante, aunque aún no haya asomado.
        document.addEventListener("focusin", (event) => {
          const block = event.target instanceof Element ? event.target.closest('[data-rv=""]') : null
          if (block) {
            block.setAttribute("data-rv", "in")
            seen.unobserve(block)
          }
        })
      })()
    </script>
  </body>
</html>
