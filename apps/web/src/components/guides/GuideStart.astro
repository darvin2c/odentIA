---
// El final de una guía y del índice (lienzo, tableros 3 y 4): el cierre de toda la web, con lo que gana
// quien empieza dicho con el tema de la guía. Las cifras salen de Precios, como en el resto de la web.
import CtaBand from "../CtaBand.astro"

interface Props {
  /** «Tu odontograma, sin papel.»: lo que gana quien empieza, dicho con el tema de la guía. */
  title: string
}
const { title } = Astro.props
---
<CtaBand title={title} />
