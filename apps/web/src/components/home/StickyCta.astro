---
// Barra fija de teléfono (≤ 720 px) con la llamada a la acción y un acceso para escribirnos.
// Se aparta mientras está en pantalla un bloque que necesita todo el alto (`data-cta-room`):
// las pestañas de los agentes, el caso, y la cuenta y el día, que traen su propia barra abajo.
// También mientras se ven los botones de la portada: son los mismos y no hace falta repetirlos
// ni tapar la escena. Por eso nace apartada y aparece al pasarlos.
import { ctaOf } from "../../lib/site"
const cta = ctaOf(Astro.locals.pricing)
---
<div class="sticky-cta is-away">
  <a class="btn btn-d" href={cta.href}>{cta.label}</a>
  <a class="btn sticky-msg" href="/contacto" aria-label="Escríbenos"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a8 8 0 0 1-11.6 7.1L4 20l1-4.6A8 8 0 1 1 21 12z"></path></svg></a>
</div>
<noscript>
  <style>
    /* Sin JavaScript la barra no sabe cuándo apartarse: queda siempre a la vista. */
    .home .sticky-cta.is-away { transform: none; visibility: visible; }
  </style>
</noscript>
<script>
  const bar = document.querySelector<HTMLElement>(".home .sticky-cta")
  const blocks = document.querySelectorAll("[data-cta-room], .home .hh-ctas")
  if (bar && blocks.length && "IntersectionObserver" in window) {
    const seen = new Set<Element>()
    // Cuenta como en pantalla lo que asoma por encima del alto que ocupa la barra.
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) seen.add(e.target)
          else seen.delete(e.target)
        }
        bar.classList.toggle("is-away", seen.size > 0)
      },
      { rootMargin: "0px 0px -80px 0px" },
    )
    blocks.forEach((b) => io.observe(b))
  }
</script>
