---
// 05 · El valor y el precio: la cuenta con los números de la clínica, el precio y un día fila por fila.
// Única sección del inicio con cifras de precio; salen de la administración (src/lib/pricing.ts).
import { hours, money, shownPlan, valuePricesOf } from "../../lib/pricing"
import DayRows from "./DayRows"
import ValueCalc from "./ValueCalc"

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const list = pricing.list
const founder = plan !== null && plan === pricing.founders ? pricing.founders : null
const prices = valuePricesOf(plan)
const m = (value: number | null) => (plan && value !== null ? money(value, plan.currency) : "—")
const was = (own: number | null, base: number | null | undefined) =>
  founder && own !== null && base != null && base !== own ? money(base, plan!.currency) : null
// Cada agente cobra por lo que hizo (ADR 0085): la tarjeta dice desde cuánto y la descripción, cada tipo.
const t = plan?.tiers
const cards = plan && t
  ? [
      { tag: "Una conversación de Sofi", from: true, price: t.informa, before: was(t.informa, list?.tiers.informa), desc: `${m(t.informa)} si responde, ${m(t.gestiona)} si reserva, mueve o cancela una cita y ${m(t.agenda)} si el paciente viene. Una por persona cada ${hours(pricing.terms.conversationWindowHours)}, aunque sean veinte mensajes.` },
      { tag: "Una consulta dictada", from: true, price: t.simple, before: was(t.simple, list?.tiers.simple), desc: `${m(t.simple)} una nota, una receta o un control, ${m(t.estandar)} con diagnóstico, odontograma o más de una parte y ${m(t.completa)} si arma el presupuesto. Solo cuando el odontólogo confirma.` },
      { tag: "Cita recuperada", from: false, price: plan.recovered, before: was(plan.recovered, list?.recovered), desc: "Un paciente sin cita ni tratamiento en curso que vuelve por un mensaje de Argos y asiste. Si no asiste, no se cobra.", hi: true },
    ]
  : []
---
<section class="hs hs-night" id="precio">
  <div class="grain" aria-hidden="true"></div>
  <div class="wrap hs-in hs-in-56">
    {/* Sin precios publicados no hay cuenta que hacer: la sección empieza por el precio en vez de un título sin nada debajo. */}
    {prices ? (
      <>
        <div class="sr hs-head">
          <span class="tag tag-d">[ 05 · El valor y el precio ]</span>
          <h2 class="h2">Lo que te cuesta no tenernos.</h2>
          <p class="lead lead-d">Cada mes sin agentes pierdes pacientes que escribieron de noche y no tuvieron respuesta, citas perdidas que nadie volvió a ofrecer y horas de tu equipo en mensajes y notas. Haz la cuenta con los números de tu clínica.</p>
        </div>
        <ValueCalc client:visible prices={prices} />
        <div class="vsep" aria-hidden="true"></div>
      </>
    ) : null}
    <div class="sr hs-head">
      <span class="tag tag-d">{prices ? "[ El precio ]" : "[ 05 · El precio ]"}</span>
      <h2 class="h2">No pagas por el software. Pagas por el trabajo hecho.</h2>
      {founder ? (
        <p class="lead lead-d">Fundadores: entras sin cuota. Los primeros <b class="gift">{m(plan!.trialCredit)}</b> de tus agentes los pagamos nosotros y, después, pagas solo lo que hacen{founder.discountPercent ? <>, con {founder.discountPercent} % menos</> : null}. Todo el sistema incluido, sin límite de odontólogos, sedes ni usuarios.</p>
      ) : plan ? (
        <p class="lead lead-d">Un solo plan de {m(plan.plan)} al mes que vuelve completo como crédito para tus agentes. Todo el sistema incluido, sin límite de odontólogos, sedes ni usuarios. Para probarlo te damos <span class="gift">{m(plan.trialCredit)}</span> de crédito por {plan.trialDays} días.</p>
      ) : (
        <p class="lead lead-d">Todo el sistema incluido, sin límite de odontólogos, sedes ni usuarios. Pagas por lo que hacen tus agentes.</p>
      )}
    </div>
    <div class="pcards">
      {cards.filter((card) => card.price !== null).map((card) => (
        <div class:list={["pcard", { hi: card.hi }]}>
          <span class="tag tag-d">{card.tag}</span>
          <span class="pamt">{card.from ? <small class="pfrom">desde </small> : null}{m(card.price)}{card.before ? <s class="pwas"> {card.before}</s> : null}</span>
          <span class="pdesc">{card.desc}</span>
        </div>
      ))}
    </div>
    {prices ? <DayRows client:visible prices={prices} conversationHours={pricing.terms.conversationWindowHours} /> : null}
    <div class="pfoot">
      <p>Nunca se cobran el spam, los recordatorios ni los avisos a tu equipo, y el sistema no se cobra aparte. Precios en dólares, más los impuestos de tu país. Los mensajes de plantilla de WhatsApp los cobra Meta directamente a la clínica.</p>
      <a class="btn btn-p" href="/precios">{prices ? "Calcula cuánto pagarías" : "Cómo cobramos"}</a>
    </div>
  </div>
</section>
