---
// 05 · El valor y el precio: la cuenta con los números de la clínica, el precio y un día fila por fila.
// Única sección del inicio con cifras de precio; salen de la administración (src/lib/pricing.ts).
import { feeText, offerOf, trialText } from "../../lib/offer"
import { hours, money, shownPlan, valuePricesOf } from "../../lib/pricing"
import GiftText from "../GiftText.astro"
import DayRows from "./DayRows"
import ValueCalc from "./ValueCalc"

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const prices = valuePricesOf(plan)
const m = (value: number | null) => (plan && value !== null ? money(value, plan.currency) : "—")
const { fee, credit } = offerOf(pricing)
const feeLine = feeText(pricing)
const trial = trialText(pricing)
// Cada agente cobra por lo que hizo (ADR 0085): la tarjeta dice desde cuánto y la descripción, cada tipo.
const t = plan?.tiers
const cards = plan && t
  ? [
      { tag: "Una conversación de Sofi", from: true, price: t.informa, desc: `${m(t.informa)} si responde, ${m(t.gestiona)} si reserva, mueve o cancela una cita y ${m(t.agenda)} si el paciente viene. Una por persona cada ${hours(pricing.terms.conversationWindowHours)}, aunque sean veinte mensajes.` },
      { tag: "Una consulta dictada", from: true, price: t.simple, desc: `${m(t.simple)} una nota, una receta o un control, ${m(t.estandar)} con diagnóstico, odontograma o más de una parte y ${m(t.completa)} si arma el presupuesto. Solo cuando el odontólogo confirma.` },
      { tag: "Cita recuperada", from: false, price: plan.recovered, desc: "Un paciente sin cita ni tratamiento en curso que vuelve por un mensaje de Argos y asiste. Si no asiste, no se cobra.", hi: true },
    ]
  : []
---
<section class="hs hs-night" id="precio">
  <div class="grain" aria-hidden="true"></div>
  <div class="wrap hs-in hs-in-56">
    {/* Sin precios publicados no hay cuenta que hacer: la sección empieza por el precio en vez de un título sin nada debajo. */}
    {prices ? (
      <>
        <div class="sr hs-head">
          <span class="tag tag-d">[ 05 · El valor y el precio ]</span>
          <h2 class="h2">Lo que te cuesta no tenernos.</h2>
          <p class="lead lead-d">Cada mes sin agentes pierdes pacientes que escribieron de noche y no tuvieron respuesta, citas perdidas que nadie volvió a ofrecer y horas de tu equipo en mensajes y notas. Haz la cuenta con los números de tu clínica.</p>
        </div>
        {/* `data-cta-room`: mientras se ve, la barra fija del teléfono deja sitio a la de la cuenta. */}
        <div data-cta-room><ValueCalc client:visible prices={prices} /></div>
        <div class="vsep" aria-hidden="true"></div>
      </>
    ) : null}
    <div class="sr hs-head">
      <span class="tag tag-d">{prices ? "[ El precio ]" : "[ 05 · El precio ]"}</span>
      <h2 class="h2">Todo el sistema. Pagas con el trabajo de tus agentes.</h2>
      {plan ? (
        <div class="pchips">
          <span class="pchip">Agenda, historia, odontograma, presupuestos, caja, omnicanal y reportes: <b>incluidos en tu plan</b></span>
        </div>
      ) : null}
      {plan ? (
        <p class="lead lead-d">
          {fee ? `Un solo plan de ${feeLine}.` : `${feeLine}.`}
          {fee && credit ? " Cada trabajo de tus agentes se descuenta de ahí; si un mes hacen más, pagas la diferencia." : null}
          {" "}Sin límite de odontólogos, sedes ni usuarios.
          {trial ? <> Para probarlo: <GiftText text={`${trial}, sin tarjeta.`} /></> : null}
        </p>
      ) : (
        <p class="lead lead-d">Todo el sistema incluido, sin límite de odontólogos, sedes ni usuarios. Pagas por lo que hacen tus agentes.</p>
      )}
    </div>
    <div class="pcards">
      {cards.filter((card) => card.price !== null).map((card) => (
        <div class:list={["pcard", { hi: card.hi }]}>
          <span class="tag tag-d">{card.tag}</span>
          {/* «Desde» del tamaño de un titular, arriba del precio (lienzo «Precios: por lo que hizo»). */}
          <span class="pprice">
            <span class="pfrom">{card.from ? "Desde" : "Solo si viene"}</span>
            <span class="pamt">{m(card.price)}</span>
          </span>
          <span class="pdesc">{card.desc}</span>
        </div>
      ))}
    </div>
    {prices ? <div data-cta-room><DayRows client:visible prices={prices} conversationHours={pricing.terms.conversationWindowHours} /></div> : null}
    <div class="pfoot">
      <p>Nunca se cobran el spam, los recordatorios ni los avisos a tu equipo, y el sistema no se cobra aparte. Precios en dólares, más los impuestos de tu país. Los mensajes de plantilla de WhatsApp los cobra Meta directamente a la clínica.</p>
      <a class="btn btn-p" href="/precios">{prices ? "Calcula cuánto pagarías" : "Cómo cobramos"}</a>
    </div>
  </div>
</section>
