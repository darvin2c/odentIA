---
// Cierre de cada página: una sola llamada a la acción y otra para hablar con una persona.
// Sin otro texto, dice la oferta como el resto de la web (`lib/offer.ts`): con Fundadores, el
// regalo; con el alta abierta, el crédito y los días de prueba.
import { offerOf } from "../lib/offer"
import { ofProduct, WORDS } from "../lib/product"
import { contactHref, ctaOf } from "../lib/site"
const cta = ctaOf(Astro.locals.pricing)

interface Props {
  title?: string
  text?: string
}
const offer = offerOf(Astro.locals.pricing)
// odentIA y vistIA cuentan sedes; latidIA, salas.
const [people, rooms] = ofProduct({
  dental: ["pacientes", "sedes"],
  medical: ["pacientes", "salas"],
  optical: ["clientes", "sedes"],
})
const limits = `sin límite de ${WORDS.clinicians}, ${rooms} ni usuarios`
const { title = `Tu equipo, de vuelta con sus ${people}.`, text } = Astro.props
---
<section class="hero band" id="empezar">
  <div class="grain" aria-hidden="true"></div>
  <div class="wrap in">
    <span class="tag tag-d">[ Empieza hoy ]</span>
    <h2 class="t">{title}</h2>
    {/* El texto puede llegar armado (slot «text»), por ejemplo con el regalo en ámbar. */}
    {Astro.slots.has("text") ? (
      <p class="lead lead-d"><slot name="text" /></p>
    ) : text ? (
      <p class="lead lead-d">{text}</p>
    ) : (
      <p class="lead lead-d">
        {offer.gift && offer.founder ? (
          <>Los primeros <b class="gift">{offer.gift}</b> de tus agentes los pagamos nosotros. {offer.noFee ? "Sin cuota, sin tarjeta" : "Sin tarjeta"} y {limits}.</>
        ) : offer.gift ? (
          <>Obtén <b class="gift">{offer.gift}</b> de crédito y pruébalo {offer.trial} sin tarjeta, {limits}.</>
        ) : (
          <>Tus agentes trabajan en {WORDS.yourClinic} desde el primer día, sin tarjeta y {limits}.</>
        )}
      </p>
    )}
    <div class="ctas">
      <a class="btn btn-p" href={cta.href}>{cta.label}</a>
      <a class="btn btn-g" href={contactHref}>Habla con nosotros</a>
    </div>
  </div>
</section>

<style>
  .band { padding: 128px 0 112px; }
  .in { position: relative; display: flex; flex-direction: column; gap: 26px; align-items: center; text-align: center; }
  .t { font-size: clamp(38px, 5.6vw, 80px); line-height: 1; letter-spacing: -.045em; font-weight: 800; max-width: 980px; text-wrap: balance; }
  .lead { max-width: 620px; }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; justify-content: center; }
  @media (max-width: 720px) { .band { padding: 72px 0 64px; } .ctas .btn { flex: 1 1 100%; } }
</style>
