---
// /agenda-odontologica de odentIA: la misma estructura que la agenda de latidIA, con la pantalla de la
// app dental. Portada con la agenda del día por unidad dental, los controles que se repiten (la
// limpieza de cada 6 meses), Argos invitando a volver, los recordatorios, las preguntas y el cierre.
// Título, descripción, migas, enlaces relacionados y preguntas son los de PAGES.agenda; lo que se
// promete es lo que hace la app (Agenda, pestaña Plan, «Invitar a volver», Su enlace).
import Base from "../../layouts/Base.astro"
import { breadcrumbJsonLd, faqJsonLd } from "../../lib/faq"
import { PAGES } from "../../lib/pages-data"
import { days, giftOf, shownPlan } from "../../lib/pricing"
import { WORDS } from "../../lib/product"
import { ctaOf } from "../../lib/site"
import CtaBand from "../CtaBand.astro"
import Faq from "../Faq.astro"
import Related from "../pages/Related.astro"
import DayAgenda from "./DayAgenda"
import RecurringControl from "./RecurringControl"
import ReturnInvite from "./ReturnInvite"

const page = PAGES.agenda
const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const founder = plan !== null && plan === pricing.founders
const gift = giftOf(pricing)
const cta = ctaOf(pricing)
const jsonLd = [
  breadcrumbJsonLd(Astro.site, [
    ["Inicio", "/"],
    [page.crumb, page.path],
  ]),
  faqJsonLd(page.faq),
]

const how = [
  { title: "Lo indicas una vez", text: "Al terminar la limpieza eliges cada 1, 3, 6 o 12 meses." },
  { title: "Queda indicado el siguiente", text: "Al completar un control, el próximo ya está en el plan, con su fecha." },
  { title: "Argos invita a reservar", text: "Le escribe a tiempo y la cita se reserva con su sí." },
]

const reminders: { title: string; text: string; link?: { href: string; label: string } }[] = [
  { title: "Un día antes y tres horas antes", text: "Argos recuerda cada cita por su canal, con la hora y el odontólogo. Es una tarea que se puede apagar." },
  {
    title: "Cambia o cancela sin llamar",
    text: "Desde su enlace, y el horario queda libre para otra persona.",
    link: { href: "/portal-del-paciente", label: "Ver Su enlace" },
  },
  { title: "Por unidad dental y odontólogo", text: "Vista de día, de semana o en lista; un odontólogo o todos, en la sede que elijas." },
  { title: "Cada servicio, con quien lo atiende", text: "La agenda ofrece cada tratamiento solo a quien lo hace, en sus horarios libres." },
  { title: "Sofi agenda por cualquier canal", text: "Agenda, mueve o cancela citas con el sí del paciente, también de noche.", link: { href: "/agentes/recepcion", label: "Conoce a Sofi" } },
  {
    title: "Tratamientos por fases",
    text: "El plan ordena las fases y cuenta las sesiones de cada tratamiento; el paciente elige el horario desde su enlace.",
    link: { href: "/historia-clinica-y-odontograma", label: "Ver la historia clínica" },
  },
]
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <div class="ag">
    <section class="hero ag-hero">
      <div class="grain" aria-hidden="true"></div>
      <div class="wrap ag-hero-in">
        <div class="ag-copy">
          <span class="tag tag-d ag-tag rise">[ Agenda y controles ]</span>
          <h1 class="ag-h1 rise d1">Agenda odontológica para tu clínica, <span class="acc">por unidad dental y odontólogo.</span></h1>
          <p class="ag-lead rise d2">Ves quién llegó, quién espera y a quién están atendiendo en cada unidad dental. Sofi agenda con el sí del paciente y la limpieza de cada 6 meses queda indicada sola.</p>
          <div class="ag-ctas rise d3">
            <a class="btn btn-p" href={cta.href}>{cta.label}</a>
            <a class="btn btn-g" href="#controles">Ver los controles</a>
          </div>
        </div>
        <div class="ag-demo rise d2">
          <DayAgenda client:load />
        </div>
      </div>
    </section>

    <section class="ag-sec" id="controles">
      <div class="wrap ag-in">
        <div class="ag-head">
          <span class="tag ag-tag">[ Controles que se repiten ]</span>
          <h2 class="ag-h2">Rosa vuelve a su limpieza cada 6 meses sin que nadie lo anote.</h2>
          <p class="ag-p">Indicas el control una vez, cada 1, 3, 6 o 12 meses. Al completarlo queda indicado el siguiente, hasta que decidas dejar de repetirlo. Argos invita al paciente a reservar a tiempo. Prueba los botones: es una demostración con datos de ejemplo.</p>
        </div>
        <div class="ag-split">
          <div class="ag-ctl">
            <RecurringControl client:visible />
          </div>
          <ol class="ag-how">
            {how.map((item, i) => (
              <li>
                <span class="ag-n">{String(i + 1).padStart(2, "0")}</span>
                <span class="ag-step"><b>{item.title}</b><span>{item.text}</span></span>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>

    <section class="ag-sec white">
      <div class="wrap ag-argos">
        <div class="ag-argos-copy">
          <span class="tag ag-tag argos">[ Argos · invitar a volver ]</span>
          <h2 class="ag-h2 s">A los 6 meses sin venir, Argos lo invita a volver.</h2>
          <p class="ag-p s">Le escribe por su canal, dentro de tu horario de recontacto, con un botón para reservar. Si no hay cómo escribirle, deja a recepción una tarea de llamada. A quien faltó o canceló le ofrece otra fecha.</p>
          <a class="ag-link" href="/agentes/administrador">Conoce a Argos</a>
        </div>
        <div class="ag-argos-demo">
          <ReturnInvite client:visible />
        </div>
      </div>
    </section>

    <section class="ag-sec">
      <div class="wrap ag-in">
        <div class="ag-head">
          <span class="tag ag-tag">[ Recordatorios y reservas ]</span>
          <h2 class="ag-h2">Menos citas perdidas, sin llamar a nadie.</h2>
        </div>
        <div class="ag-grid">
          {reminders.map((item) => (
            <div class="ag-card">
              <h3>{item.title}</h3>
              <p>{item.text}{item.link && <> <a href={item.link.href}>{item.link.label}</a></>}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <Related hrefs={page.related} white />
    <div class="ag-faq"><Faq items={page.faq} /></div>
    <CtaBand title="Una agenda que se llena y se recuerda sola.">
      <Fragment slot="text">
        {gift ? (
          founder ? (
            <>Los primeros <span class="gift">{gift}</span> de tus agentes los pagamos nosotros. Sin tarjeta y sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
          ) : (
            <>Obtén <span class="gift">{gift}</span> de crédito y pruébalo {days(plan?.trialDays ?? pricing.terms.trialDays)} sin tarjeta, sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
          )
        ) : (
          `Tus agentes trabajan en ${WORDS.yourClinic} desde el primer día, sin tarjeta y sin límite de ${WORDS.clinicians}, sedes ni usuarios.`
        )}
      </Fragment>
    </CtaBand>
  </div>
</Base>

<style>
  .ag { background: var(--paper); }
  /* La cabecera del sitio va absoluta encima: 88 px de cabecera y 56 de aire. */
  .ag-hero { padding: 144px 0 96px; }
  .ag-hero-in { position: relative; display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .ag-copy { flex: 1 1 380px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .ag-demo { flex: 1.35 1 560px; min-width: 0; }
  .ag-tag { font-size: 13px; letter-spacing: .12em; }
  .ag-h1 { font-size: clamp(36px, 3.8vw, 50px); line-height: 1.03; letter-spacing: -.045em; font-weight: 800; text-wrap: balance; }
  .acc { color: var(--sky-2); }
  .ag-lead { font-size: 19px; line-height: 1.55; color: var(--on-night-2); text-wrap: pretty; }
  .ag-ctas { display: flex; flex-wrap: wrap; gap: 12px; }

  .ag-sec { padding: 96px 0; background: var(--bg); }
  .ag-sec.white { background: var(--paper); }
  .ag-in { display: flex; flex-direction: column; gap: 40px; }
  .ag-head { display: flex; flex-direction: column; gap: 14px; max-width: 880px; }
  .ag-h2 { font-size: clamp(34px, 4vw, 48px); line-height: 1.04; letter-spacing: -.035em; font-weight: 800; text-wrap: balance; }
  .ag-h2.s { font-size: clamp(32px, 3.6vw, 44px); }
  .ag-p { font-size: 18px; line-height: 1.55; color: var(--muted); text-wrap: pretty; }
  .ag-p.s { font-size: 17px; }
  .ag-split { display: flex; flex-wrap: wrap; gap: 24px; align-items: flex-start; }
  .ag-ctl { flex: 1.2 1 480px; min-width: 0; }
  .ag-how { flex: 1 1 360px; min-width: 0; margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .ag-how li { display: flex; gap: 16px; align-items: flex-start; background: var(--paper); border-radius: 18px; padding: 18px 20px; }
  .ag-n { font-family: var(--agent-font); font-size: 12px; color: var(--teal); padding-top: 3px; }
  .ag-step { display: flex; flex-direction: column; gap: 4px; }
  .ag-step b { font-size: 17px; }
  .ag-step span { font-size: 15px; line-height: 1.5; color: var(--muted); }

  .ag-argos { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .ag-argos-copy { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 16px; }
  .ag-argos-demo { flex: 1 1 440px; min-width: 0; }
  .ag-tag.argos { color: #8a5d0e; }
  .ag-link { font-weight: 700; align-self: flex-start; padding: 10px 0; }

  .ag-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; }
  .ag-card { background: var(--paper); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .ag-card h3 { font-size: 20px; line-height: 1.25; letter-spacing: -.01em; }
  .ag-card p { font-size: 16px; line-height: 1.5; color: var(--muted); }
  .ag-card a { font-weight: 700; }

  .ag-faq { background: var(--paper); padding-bottom: 8px; }

  @media (max-width: 720px) {
    .ag-hero { padding: 104px 0 56px; }
    .ag-hero-in { gap: 32px; }
    .ag-lead { font-size: 17px; }
    .ag-ctas :global(.btn) { flex: 1 1 100%; }
    .ag-sec { padding: 64px 0; }
    .ag-in { gap: 28px; }
    .ag-p { font-size: 16px; }
    .ag-split, .ag-argos { gap: 24px; }
    .ag-ctl, .ag-how, .ag-argos-copy, .ag-argos-demo, .ag-demo, .ag-copy { flex-basis: 100%; }
    .ag-how li { padding: 16px; gap: 12px; }
  }
</style>
