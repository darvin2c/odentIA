---
// /reportes de odentIA (lienzo del paso 3, tablero Reportes), con la misma estructura que la de latidIA:
// Argos de protagonista en la portada, respondiendo con las cifras de Clínica Sonrisa Norte; las cinco
// pestañas de Reportes con su réplica (el embudo con el presupuesto, lo cobrado por tratamiento, la
// agenda ocupada) y la captura real de Finanzas; por qué confiar en su respuesta, las preguntas y el
// cierre. Los dos componentes de la demostración son los de latidIA con `variant="dental"`
// (components/latidia/reports). Título, descripción, migas y las preguntas de siempre salen de
// PAGES.reportes (lib/pages-data.ts). Ningún precio en el código: lo que se pagó por los agentes y las
// preguntas de Argos salen del plan que se muestra (Astro.locals.pricing).
import Base from "../../layouts/Base.astro"
import { breadcrumbJsonLd, type FaqItem, faqJsonLd } from "../../lib/faq"
import { PAGES } from "../../lib/pages-data"
import { days, giftOf, money, shownPlan } from "../../lib/pricing"
import { WORDS } from "../../lib/product"
import { AGENT_COLORS, contactHref, ctaOf } from "../../lib/site"
import FeatureGrid from "../agents/FeatureGrid.astro"
import SplitHero from "../agents/SplitHero.astro"
import CtaBand from "../CtaBand.astro"
import Faq from "../Faq.astro"
import ArgosAsk from "../latidia/reports/ArgosAsk"
import ReportsTabs from "../latidia/reports/ReportsTabs"

const page = PAGES.reportes
const pricing = Astro.locals.pricing
const cta = ctaOf(pricing)
const gift = giftOf(pricing)
const plan = shownPlan(pricing)
const founder = plan !== null && plan === pricing.founders
const trail: [string, string][] = [
  ["Inicio", "/"],
  [page.crumb, page.path],
]
// El ámbar de Argos sobre claro no llega al contraste de un texto de 13 px; el tablero usa uno más oscuro.
const argosTag = "#9a6a12"

// Lo que se pagó por los agentes en el mes de ejemplo de la pestaña Agente, con los precios publicados:
// Sofi atendió 377 conversaciones (214 informan, 92 gestionan y 71 agendan), Clío ordenó 164 consultas
// dictadas (70 simples, 66 estándar y 28 completas) y Argos recuperó 9 citas; sus preguntas caben en las
// incluidas. Sin precios de todos los tipos, no hay cifra.
const MONTH = { informa: 214, gestiona: 92, agenda: 71, simple: 70, estandar: 66, completa: 28, recovered: 9 }
const agentCost = (() => {
  if (!plan || plan.recovered === null) return null
  const t = plan.tiers
  const parts = [
    [t.informa, MONTH.informa],
    [t.gestiona, MONTH.gestiona],
    [t.agenda, MONTH.agenda],
    [t.simple, MONTH.simple],
    [t.estandar, MONTH.estandar],
    [t.completa, MONTH.completa],
    [plan.recovered, MONTH.recovered],
  ] as const
  if (parts.some(([price]) => price === null)) return null
  const total = parts.reduce((sum, [price, n]) => sum + (price ?? 0) * n, 0)
  return {
    total: money(total, plan.currency),
    note: `Cuenta de ejemplo con los precios publicados del plan ${plan.name}: 377 conversaciones, 164 consultas dictadas y 9 citas recuperadas.`,
  }
})()

// Las preguntas a Argos, del plan que se muestra; sin plan publicado, no hay cifras.
const argosAnswer = plan?.argos
  ? `Con el plan ${plan.name}, ${plan.argos.included} preguntas al mes están incluidas, y cada ${plan.argos.packQuestions} más cuestan ${money(plan.argos.pack, plan.currency)}. Si Argos no puede responder con tus datos, esa pregunta no cuenta.`
  : "Los precios se publican pronto. Escríbenos y te los contamos. Si Argos no puede responder con tus datos, esa pregunta no cuenta."

const faq: FaqItem[] = [
  ...page.faq,
  {
    q: "¿Argos inventa las cifras?",
    a: `No. Usa las mismas cuentas de Reportes y debajo de cada respuesta dice cómo lo calculó: qué contó, de qué periodo y de qué sedes. Si ${WORDS.name} no registra ese dato, te lo dice y te ofrece lo más cercano.`,
  },
  { q: "¿Cuántas preguntas le puedo hacer a Argos?", a: argosAnswer },
]
const jsonLd = [breadcrumbJsonLd(Astro.site, trail), faqJsonLd(faq)]
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <SplitHero
    tag="Reportes con Argos"
    color={AGENT_COLORS.administrador.dark}
    h1="Reportes de tu clínica dental sin armar planillas: lo cobrado por tratamiento, quién debe, quién no vino y cada sede, y Argos para todo lo demás."
    lead="Escribes la pregunta como se la harías a tu administrador. Argos responde con las mismas cuentas de Reportes y te dice cómo lo calculó. Si no registras ese dato, te lo dice."
  >
    <p class="sh-title">Pregúntale a <span style={`color: ${AGENT_COLORS.administrador.dark}`}>tu clínica.</span></p>
    <Fragment slot="actions">
      <a class="btn btn-p" href={cta.href}>{cta.label}</a>
    </Fragment>
    <ArgosAsk slot="demo" client:load variant="dental" />
  </SplitHero>

  <section class="section section-white">
    <div class="wrap rp-in">
      <div class="rp-head">
        <span class="tag rp-tag">[ Las cinco pestañas ]</span>
        <h2 class="rp-h2">Cinco pestañas, sin copiar nada a una planilla.</h2>
        <p class="rp-lead">Salen de lo que ya pasa en la clínica: la agenda, las conversaciones, la historia y la caja. Cada cifra se compara con palabras, no solo con un color.</p>
      </div>
      <ReportsTabs client:visible variant="dental" agentCost={agentCost} contactHref={contactHref} />
      <figure class="rp-shot">
        <img
          src="/img/product/reports-finance.jpg"
          width="1000"
          height="896"
          loading="lazy"
          decoding="async"
          alt="Reportes › Finanzas: lo cobrado, lo que deja el mes, las comisiones, lo que te deben y la cascada de lo cobrado a lo que deja, con el impuesto aparte."
        />
        <figcaption>Captura real de Reportes › Finanzas, con datos de prueba.</figcaption>
      </figure>
    </div>
  </section>

  <FeatureGrid
    tag="Por qué confiar en su respuesta"
    tagColor={argosTag}
    title="Argos no adivina: cuenta."
    min={240}
    small
    items={[
      { title: "La cifra oficial", text: "Usa las mismas cuentas de Reportes, y te lo dice debajo de la respuesta." },
      { title: "«Así lo calculé»", text: "Cada respuesta dice qué contó, de qué periodo y de qué sedes." },
      { title: "Sin nombres para la IA", text: "El modelo nunca ve los nombres de tus pacientes; la lista la arma tu sistema." },
      { title: "Lo que no sabe, lo dice", text: `Si ${WORDS.name} no registra ese dato, te ofrece lo más cercano. Y no cuenta como pregunta.` },
    ]}
  >
    <p class="more"><a href="/agentes/administrador">Lo que hace Argos →</a></p>
  </FeatureGrid>

  <div class="faqwrap">
    <Faq items={faq} title="Sobre los reportes y Argos." />
  </div>
  <CtaBand title="Pregúntale a tu clínica desde hoy.">
    <Fragment slot="text">
      {gift ? (
        founder ? (
          <>Los primeros <b class="gift">{gift}</b> de tus agentes los pagamos nosotros. Sin tarjeta y sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
        ) : (
          <>Obtén <b class="gift">{gift}</b> de crédito y pruébalo {days(plan?.trialDays ?? pricing.terms.trialDays)} sin tarjeta, sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
        )
      ) : (
        `Tus agentes trabajan en ${WORDS.yourClinic} desde el primer día, sin tarjeta y sin límite de ${WORDS.clinicians}, sedes ni usuarios.`
      )}
    </Fragment>
  </CtaBand>
</Base>

<style>
  .rp-in { display: flex; flex-direction: column; gap: 36px; }
  .rp-head { display: flex; flex-direction: column; gap: 14px; max-width: 860px; }
  .rp-tag { font-size: 13px; letter-spacing: .12em; }
  .rp-h2 { font-size: clamp(34px, 4vw, 48px); line-height: 1.04; letter-spacing: -.035em; font-weight: 800; text-wrap: balance; }
  .rp-lead { font-size: 18px; line-height: 1.55; color: var(--muted); }
  .rp-shot { margin: 0; display: flex; flex-direction: column; gap: 8px; max-width: 720px; width: 100%; align-self: center; }
  .rp-shot img { width: 100%; height: auto; border-radius: 20px; border: 1px solid var(--line); box-shadow: 0 30px 60px -30px rgba(10, 33, 41, .35); }
  .rp-shot figcaption { font-size: 13px; color: var(--soft); }
  .more { font-size: 15px; }
  .more a { font-weight: 700; display: inline-block; padding: 10px 0; }
  .faqwrap { background: var(--paper); }
  @media (max-width: 720px) {
    .rp-in { gap: 24px; }
    .rp-lead { font-size: 16px; }
  }
</style>
