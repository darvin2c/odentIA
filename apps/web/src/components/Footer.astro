---
// Pie: el mapa completo de la web y las páginas legales.
import { WORDS } from "../lib/product"
import { footerGroups, legalLinks } from "../lib/site"
---
<footer class="foot">
  <div class="wrap grid">
    <div class="brand">
      <span class="name">{WORDS.name}</span>
      <span>Omnicanal y agéntica, para {WORDS.audience} de habla hispana.</span>
    </div>
    {footerGroups.map((g) => (
      <nav aria-label={g.title}>
        <span class="t">{g.title}</span>
        {g.links.map((l) => <a href={l.href}>{l.label}</a>)}
      </nav>
    ))}
  </div>
  <div class="wrap legal">
    <nav aria-label="Legal">{legalLinks.map((l) => <a href={l.href}>{l.label}</a>)}</nav>
    <span>Precios en dólares, más los impuestos de tu país.</span>
  </div>
</footer>

<style>
  .foot { background: var(--night-2); color: #9fb8bf; padding: 64px 0 40px; }
  .grid { display: grid; grid-template-columns: 1.4fr repeat(4, minmax(0, 1fr)); gap: 32px; }
  .brand { display: flex; flex-direction: column; gap: 12px; font-size: 14.5px; line-height: 1.6; max-width: 320px; }
  .name { font-weight: 800; font-size: 20px; color: #eef6f8; }
  nav { display: flex; flex-direction: column; gap: 4px; }
  .t { font-family: var(--mono); font-size: 11.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--sky-2); margin-bottom: 6px; }
  a { color: #cfe7ec; text-decoration: none; font-size: 14.5px; padding: 6px 0; }
  a:hover { color: #fff; }
  .legal { margin-top: 40px; padding-top: 24px; border-top: 1px solid rgba(255,255,255,.1); display: flex; flex-wrap: wrap; gap: 12px 24px; justify-content: space-between; font-size: 13px; }
  .legal nav { flex-direction: row; flex-wrap: wrap; gap: 4px 22px; }
  .legal a { font-size: 13px; padding: 4px 0; }
  @media (max-width: 960px) { .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .brand { grid-column: 1 / -1; } }
  @media (max-width: 480px) { .grid { grid-template-columns: 1fr; } }
</style>
