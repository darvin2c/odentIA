---
// «Cuánto cobra Sofi / Clío / Argos» de latidIA (tableros Sofi, Clio y Argos): el texto a la izquierda y,
// a la derecha, el precio de cada tipo (ADR 0085) del plan que se muestra, con el de lista tachado si es
// Fundadores. Como AgentCharges de odentIA, pero con los tres agentes y las palabras de un consultorio
// (Clío: simple, estándar y completa según lo que quedó en la atención). Ninguna cifra vive aquí: salen
// de Astro.locals.pricing. Sin plan publicado, la tarjeta dice que los precios se publican pronto.
import { money, shownPlan } from "../../../lib/pricing"
import { contactHref } from "../../../lib/site"

interface Props {
  agent: "sofi" | "clio" | "argos"
  title: string
  text: string
  /** Fondo de la sección: blanco o lila suave (la tarjeta toma el otro). */
  white?: boolean
}
const { agent, title, text, white = false } = Astro.props

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const list = pricing.list
const founder = plan !== null && plan === pricing.founders
const currencyCode = plan?.currency ?? ""
// «0,05», «1,00»: sin la moneda (va en la nota) y siempre con dos decimales, como en Precios.
const cut = (value: number) => {
  const shown = money(value, currencyCode).replace(`${currencyCode} `, "")
  return shown.includes(",") ? shown : `${shown},00`
}
const struck = (own: number | null, base: number | null | undefined) =>
  founder && own !== null && base !== null && base !== undefined && base !== own ? cut(base) : null

type Row = { label: string; text: string; price: number | null; before?: string | null; word?: string }
const t = plan?.tiers
const lt = list?.tiers
const rows: Row[] = !plan || !t
  ? []
  : agent === "sofi"
    ? [
        { label: "Informa", text: "Respondió, dio la dirección, el horario o el precio de la consulta.", price: t.informa, before: struck(t.informa, lt?.informa) },
        { label: "Gestiona", text: "Reservó, movió o canceló una cita, aunque el paciente no venga.", price: t.gestiona, before: struck(t.gestiona, lt?.gestiona) },
        { label: "Agenda", text: "La consulta que reservó se dio.", price: t.agenda, before: struck(t.agenda, lt?.agenda) },
      ]
    : agent === "clio"
      ? [
          { label: "Simple", text: "La nota: el motivo y lo que te contó el paciente.", price: t.simple, before: struck(t.simple, lt?.simple) },
          { label: "Estándar", text: "La nota con el examen físico o un diagnóstico.", price: t.estandar, before: struck(t.estandar, lt?.estandar) },
          {
            label: "Completa",
            text: "Además dejó indicado lo que sigue: la receta, una orden, el descanso o el próximo control.",
            price: t.completa,
            before: struck(t.completa, lt?.completa),
          },
        ]
      : [
          { label: "Cita recuperada", text: "Solo si el paciente vino. Si no, no se cobra.", price: plan.recovered, before: struck(plan.recovered, list?.recovered) },
          ...(plan.argos
            ? [
                { label: `${plan.argos.included} preguntas al mes`, text: "Las que no pudo responder no cuentan.", price: null, word: "incluidas" },
                {
                  label: `${plan.argos.packQuestions} preguntas más`,
                  text: "Argos te pregunta antes de sumarlas.",
                  price: plan.argos.pack,
                  before: struck(plan.argos.pack, list?.argos?.pack),
                },
              ]
            : []),
        ]
const shown = rows.filter((row) => row.price !== null || row.word)
const currency = plan?.currency === "USD" ? "dólares" : plan?.currency
const anyStruck = shown.some((row) => row.before)
---
<section class:list={["la-sec ap", { white }]} id="cobra">
  <div class="wrap la-split">
    <div class="ap-copy">
      <span class="tag la-tag">[ Cuánto cobra {agent === "sofi" ? "Sofi" : agent === "clio" ? "Clío" : "Argos"} ]</span>
      <h2 class="la-h2 s">{title}</h2>
      <p class="la-lead s">{text}</p>
      <a class="la-more" href="/precios">Todos los precios →</a>
    </div>
    {shown.length > 0 ? (
      <div class="ap-card">
        <dl class="ap-rows">
          {shown.map((row) => (
            <div class="ap-row">
              <dt><b>{row.label}</b><span>{row.text}</span></dt>
              <dd class:list={{ word: row.price === null }}>
                {row.price !== null ? cut(row.price) : row.word}
                {row.before ? <s>{row.before}</s> : null}
              </dd>
            </div>
          ))}
        </dl>
        <span class="ap-note">
          Precios en {currency} más impuestos.{founder && anyStruck ? " Precio Fundadores; tachado, el de lista." : ""}
        </span>
      </div>
    ) : (
      <div class="ap-card">
        <p class="ap-soon">Los precios se publican pronto. <a href={contactHref}>Escríbenos</a> y te los contamos.</p>
      </div>
    )}
  </div>
</section>

<style>
  .ap-copy { flex: 1 1 400px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .ap-card { flex: 1 1 520px; min-width: 0; background: var(--paper); border: 1px solid var(--la-line); border-radius: 22px; padding: 26px; display: flex; flex-direction: column; gap: 4px; }
  .white .ap-card { background: var(--la-soft); }
  .ap-rows { margin: 0; display: flex; flex-direction: column; }
  .ap-row { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 16px; align-items: center; padding: 14px 0; border-bottom: 1px solid var(--la-line); }
  .ap-row:last-child { border-bottom: 0; }
  .ap-row dt { display: flex; flex-direction: column; gap: 2px; }
  .ap-row dt span { color: var(--muted); font-size: 15px; line-height: 1.45; }
  .ap-row dd { margin: 0; font-size: 24px; font-weight: 800; letter-spacing: -.02em; white-space: nowrap; display: flex; align-items: baseline; gap: 6px; }
  .ap-row dd.word { font-size: 20px; }
  .ap-row s { font-size: 13px; font-weight: 600; letter-spacing: 0; color: var(--soft); }
  .ap-note { font-family: var(--agent-font); font-size: 12px; line-height: 1.5; color: var(--soft); padding-top: 4px; }
  .ap-soon { font-size: 17px; line-height: 1.55; color: var(--muted); }
  .ap-soon a { font-weight: 700; }
  @media (max-width: 720px) {
    .ap-card { padding: 18px; border-radius: 18px; }
    .ap-row dt span { font-size: 14px; }
    .ap-row dd { font-size: 20px; flex-direction: column; align-items: flex-end; gap: 0; }
  }
</style>
