---
// Inicio de latidIA (issue 229, decisión 18): la web mínima de un consultorio. Lo que se cuenta
// aquí es lo que el sistema ya hace (entregas 1 a 10); lo demás llega después, con su página.
import { CalmPulseScene } from "@odentia/brand-scene"
import CtaBand from "../CtaBand.astro"
import Faq from "../Faq.astro"
import PageHero from "../PageHero.astro"
import type { FaqItem } from "../../lib/faq"
import { shownPlan } from "../../lib/pricing"
import { AGENT_COLORS } from "../../lib/site"

const plan = shownPlan(Astro.locals.pricing)

const agents = [
  {
    name: "Sofi",
    role: "recepción",
    color: AGENT_COLORS.recepcion.light,
    text: "Responde a cualquier hora por WhatsApp, Instagram, Messenger, el chat de tu web y el correo. Agenda, mueve y confirma citas, y ante una señal de alarma da el número de emergencias y pasa el caso a tu equipo.",
  },
  {
    name: "Clío",
    role: "clínica",
    color: AGENT_COLORS.clinico.light,
    text: "Dictas mientras atiendes y ordena la consulta: el motivo, los signos vitales, el examen por sistemas, el diagnóstico, la receta, los controles y el descanso médico. Nada entra a la historia hasta que lo confirmas.",
  },
  {
    name: "Argos",
    role: "administración",
    color: AGENT_COLORS.administrador.light,
    text: "Te dice cómo va tu consultorio con sus cifras, invita a volver a quien no viene hace un año, avisa su control a quien le toca y ofrece otro horario a quien faltó o canceló.",
  },
]

const system = [
  { title: "Una ficha por persona", text: "Todos sus canales y su única historia clínica, aunque escriba por WhatsApp y después por correo." },
  { title: "Examen físico y signos vitales", text: "El examen por sistemas, donde lo no examinado queda «No examinado», y la presión y el peso de cada consulta en el tiempo." },
  { title: "Receta que revisa", text: "Avisa si choca con una alergia o un embarazo, pide el peso de un niño y deja fuera lo que va en receta oficial." },
  { title: "Descanso médico", text: "Firmado y numerado; el diagnóstico va solo si la persona lo autoriza." },
  { title: "Controles que se repiten", text: "Un control cada 1, 3, 6 o 12 meses hasta que lo detienes, con su invitación a tiempo." },
  { title: "Agenda, caja y reportes", text: "Por sala y por profesional, con los cobros de cada consulta y lo que te deja cada mes." },
]

const faq: FaqItem[] = [
  {
    q: "¿Para qué especialidades sirve?",
    a: "Para medicina general, medicina familiar, medicina interna, pediatría y ginecología y obstetricia: el consultorio nace con esas especialidades y una biblioteca de servicios, con su código oficial donde tu país lo pide.",
  },
  {
    q: "¿Tengo que dictar?",
    a: "No. Puedes escribir la consulta como siempre. Dictar es una vía más: Clío ordena lo que dices y tú confirmas cada cosa antes de que entre a la historia.",
  },
  {
    q: "¿Cómo se cobra?",
    a: "Pagas por lo que hacen tus agentes, no por el software: lo simple cuesta poco y lo que te trae pacientes cuesta más. Los precios están en la página de Precios.",
  },
]
---
<PageHero
  tag="latidIA · para consultorios médicos"
  title="Tú atiendes. Tus agentes"
  accent="hacen el resto."
  lead="WhatsApp, Instagram, correo y el chat de tu web en una sola ficha por persona, con agentes de IA que agendan, ordenan la consulta que dictas y traen de vuelta a tus pacientes."
  secondary={{ href: "/precios", label: "Ver precios" }}
>
  <CalmPulseScene slot="visual" className="pulse" />
</PageHero>

<section class="section section-white" id="agentes">
  <div class="wrap in">
    <div class="head">
      <span class="tag">[ Tres agentes ]</span>
      <h2 class="h2">Uno en la recepción, uno en la consulta y uno en la administración.</h2>
      <p class="lead">Cada uno hace lo que le encargas, y tú decides qué puede hacer.</p>
    </div>
    <ul class="agents">
      {agents.map((agent) => (
        <li class="card agent">
          <span class="who"><span class="dot" style={`background:${agent.color}`} aria-hidden="true"></span>{agent.name} · {agent.role}</span>
          <p>{agent.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="section" id="sistema">
  <div class="wrap in">
    <div class="head">
      <span class="tag">[ El sistema ]</span>
      <h2 class="h2">Lo que necesita un consultorio, sin módulos aparte.</h2>
    </div>
    <ul class="grid-auto feats">
      {system.map((item) => (
        <li class="card feat">
          <h3>{item.title}</h3>
          <p>{item.text}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<Faq items={faq} tag="Preguntas" />
<CtaBand
  text={plan
    ? `Pruébalo ${plan.trialDays} días: tus agentes trabajan en tu consultorio desde el primer día. Sin límite de médicos, sedes ni usuarios.`
    : "Tus agentes trabajan en tu consultorio desde el primer día. Sin límite de médicos, sedes ni usuarios."}
/>

<style>
  .in { display: flex; flex-direction: column; gap: 44px; }
  .head { display: flex; flex-direction: column; gap: 18px; max-width: 860px; }
  .agents { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .agent { padding: 28px; display: flex; flex-direction: column; gap: 14px; }
  .who { display: inline-flex; align-items: center; gap: 10px; font-family: var(--mono); font-size: 13px; text-transform: uppercase; letter-spacing: .06em; color: var(--ink-2); }
  .dot { width: 10px; height: 10px; border-radius: 999px; }
  .agent p, .feat p { margin: 0; color: var(--muted); line-height: 1.6; }
  .feats { list-style: none; margin: 0; padding: 0; gap: 16px; }
  .feat { padding: 26px; display: flex; flex-direction: column; gap: 10px; }
  .feat h3 { margin: 0; font-size: 19px; letter-spacing: -.01em; }
  :global(.pulse) { width: 100%; height: auto; max-width: 560px; justify-self: center; }
  @media (max-width: 960px) { .agents { grid-template-columns: 1fr; } }
</style>
