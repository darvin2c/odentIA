---
// /portal-del-paciente de odentIA: la misma estructura que la de latidIA, con la pantalla de Su enlace de
// la app dental. Portada con el teléfono de Andrea, cómo entra, lo que resuelve cada paciente, las
// preguntas y el cierre. Título, descripción, migas, enlaces relacionados y preguntas son los de
// PAGES.enlace. Lo que se promete es lo que hacen hoy Su enlace (`/reserva`), el portal (`/portal`) y el
// registro (`/registro`): Su enlace lleva lo pendiente (reservar, cambiar o cancelar, responder el
// presupuesto, sus datos, leer y firmar el consentimiento y «Tus mensajes»); cada papel le llega en PDF
// por WhatsApp o por correo al tocar «Enviar»; el portal, con el acceso que se da en la clínica, muestra
// todo lo suyo sin vencer y se vuelve con la huella o la cara. Debajo, el registro por QR o enlace con
// las preguntas que elige la clínica, y su logo y su color.
import Base from "../../layouts/Base.astro"
import { breadcrumbJsonLd, faqJsonLd } from "../../lib/faq"
import { PAGES } from "../../lib/pages-data"
import { days, giftOf, shownPlan } from "../../lib/pricing"
import { WORDS } from "../../lib/product"
import { ctaOf } from "../../lib/site"
import CtaBand from "../CtaBand.astro"
import Faq from "../Faq.astro"
import Related from "../pages/Related.astro"
import PasskeyLogin from "./PasskeyLogin"
import PatientPhone from "./PatientPhone"

const page = PAGES.enlace
const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const founder = plan !== null && plan === pricing.founders
const gift = giftOf(pricing)
const cta = ctaOf(pricing)
const jsonLd = [
  breadcrumbJsonLd(Astro.site, [
    ["Inicio", "/"],
    [page.crumb, page.path],
  ]),
  faqJsonLd(page.faq),
]

const steps = [
  {
    title: "Le llega por su canal",
    text: "Sofi se lo envía cuando pide una cita, y Argos cuando le toca su control.",
  },
  { title: "Lo abre en el navegador", text: "No descarga nada ni crea una contraseña." },
  {
    title: "Vuelve con su huella o su cara",
    text: "Si tu clínica le da acceso al portal, la primera vez guarda su acceso en el teléfono. Si su enlace venció, responde el mensaje y recibe uno nuevo.",
  },
]

const decides: { title: string; text: string; link?: { href: string; label: string } }[] = [
  {
    title: "Su cita",
    text: "Reserva, cambia o cancela en los horarios libres, y aparece en la agenda de la sede. Si es su primera cita, después de elegir se le piden unos datos.",
    link: { href: "/agenda-odontologica", label: "Ver la agenda" },
  },
  {
    title: "Su presupuesto",
    text: "Ve las opciones, acepta la que prefiere o solo una parte, y elige el horario ahí mismo.",
    link: { href: "/presupuestos-dentales", label: "Ver los presupuestos" },
  },
  { title: "Sus consentimientos y datos", text: "Lee y firma el consentimiento con calma y completa sus datos y su salud antes de llegar. Lo que declara queda como declarado por él." },
  { title: "Sus papeles, en PDF", text: "La receta, la orden, el consentimiento firmado y el comprobante le llegan en PDF por WhatsApp o por correo cuando tocas «Enviar»." },
  { title: "Su portal, sin vencer", text: "Con el acceso que le das en la clínica ve todo lo suyo cuando quiera: sus citas, sus presupuestos, su cuenta y sus documentos, también las radiografías con su informe." },
  { title: "Sus mensajes", text: "Elige qué mensajes recibe: recordatorios, controles y novedades. Los avisos de su cita y sus papeles le llegan siempre." },
]

// Antes de la primera cita: el registro por QR o enlace y la marca de la clínica en lo que ve el paciente.
const yours = [
  { title: "Se registra con un QR o un enlace", text: "Con el código QR de recepción o el enlace de tu clínica, llena sus datos y su salud en su celular. Sofi se lo envía a quien aún no es paciente." },
  { title: "Tú eliges qué preguntar", text: "Dato por dato: «No preguntar», «Opcional» u «Obligatorio». Al lado ves lo que verá el paciente." },
  { title: "Tu logo y tu color", text: "Subes tu logo y eliges el color de tu marca: tus pacientes lo ven en su registro, su enlace y la reserva." },
]
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <div class="pt">
    <section class="hero pt-hero">
      <div class="grain" aria-hidden="true"></div>
      <div class="wrap pt-hero-in">
        <div class="pt-copy">
          <span class="tag tag-d pt-tag rise">[ Su enlace ]</span>
          <h1 class="pt-h1 rise d1">Reserva de citas online para dentistas, <span class="acc">con Su enlace.</span></h1>
          <p class="pt-lead rise d2">Cada paciente tiene su propio enlace: reserva y cambia su cita, responde su presupuesto, completa sus datos y firma su consentimiento. Sin llamar y sin contraseña.</p>
          <div class="pt-ctas rise d3">
            <a class="btn btn-p" href={cta.href}>{cta.label}</a>
            <a class="btn btn-g" href="#entrar">Cómo entra</a>
          </div>
          <span class="pt-hint rise d3">Toca los botones del teléfono: es una demostración con datos de ejemplo.</span>
        </div>
        <div class="pt-phone rise d2">
          <PatientPhone client:load />
        </div>
      </div>
    </section>

    <section class="pt-sec white" id="entrar">
      <div class="wrap pt-enter">
        <div class="pt-enter-copy">
          <div class="pt-head">
            <span class="tag pt-tag">[ Cómo entra ]</span>
            <h2 class="pt-h2">Un enlace propio, sin aplicación y sin contraseña.</h2>
          </div>
          <ol class="pt-steps">
            {steps.map((step, i) => (
              <li>
                <span class="pt-n">{String(i + 1).padStart(2, "0")}</span>
                <span class="pt-step"><b>{step.title}</b><span>{step.text}</span></span>
              </li>
            ))}
          </ol>
        </div>
        <div class="pt-login">
          <PasskeyLogin client:visible />
        </div>
      </div>
    </section>

    <section class="pt-sec">
      <div class="wrap pt-in">
        <div class="pt-head">
          <span class="tag pt-tag">[ Qué resuelve ]</span>
          <h2 class="pt-h2">Lo que antes era una llamada, ahora es un toque.</h2>
          <p class="pt-p">Su enlace lleva lo que tiene pendiente. Sus papeles le llegan en PDF. Y en su portal, con el acceso que le das en la clínica, ve todo lo suyo sin que venza.</p>
        </div>
        <div class="pt-grid">
          {decides.map((item) => (
            <div class="pt-card">
              <h3>{item.title}</h3>
              <p>{item.text}{item.link && <> <a href={item.link.href}>{item.link.label}</a></>}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="pt-sec white">
      <div class="wrap pt-yours">
        <div class="pt-yours-copy">
          <div class="pt-head">
            <span class="tag pt-tag">[ Con tu marca ]</span>
            <h2 class="pt-h2">Se registra solo, con tu logo y tu color.</h2>
          </div>
          <ul class="pt-list">
            {yours.map((item) => (
              <li><b>{item.title}</b><span>{item.text}</span></li>
            ))}
          </ul>
        </div>
        {/* Ilustración de la hoja del registro y del color de la marca: no son controles de esta página. */}
        <div class="pt-sheet" role="img" aria-label="Ejemplo: la hoja de registro de Clínica Sonrisa Norte con su código QR y, debajo, los colores de la marca con el botón «Usar este color»">
          <span class="pt-sheet-org"><i aria-hidden="true">SN</i>Clínica Sonrisa Norte</span>
          <b class="pt-sheet-t">Registro de paciente</b>
          <span class="pt-qr" aria-hidden="true"></span>
          <span class="pt-sheet-sub">Escanéalo con la cámara de tu celular.</span>
          <span class="pt-sw">
            <span class="pt-sw-h">Color de la marca</span>
            <span class="pt-sw-row" aria-hidden="true"><i class="on" style="background:#0e7490"></i><i style="background:#b45309"></i><i style="background:#7c3aed"></i><i style="background:#be185d"></i><i style="background:#15803d"></i></span>
            <span class="pt-sw-btn">Usar este color</span>
          </span>
        </div>
      </div>
    </section>

    <Related hrefs={page.related} />
    <div class="pt-faq"><Faq items={page.faq} /></div>
    <CtaBand title="Que tus pacientes resuelvan sin llamar.">
      <Fragment slot="text">
        {gift ? (
          founder ? (
            <>Los primeros <span class="gift">{gift}</span> de tus agentes los pagamos nosotros. Sin tarjeta y sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
          ) : (
            <>Obtén <span class="gift">{gift}</span> de crédito y pruébalo {days(plan?.trialDays ?? pricing.terms.trialDays)} sin tarjeta, sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
          )
        ) : (
          `Tus agentes trabajan en ${WORDS.yourClinic} desde el primer día, sin tarjeta y sin límite de ${WORDS.clinicians}, sedes ni usuarios.`
        )}
      </Fragment>
    </CtaBand>
  </div>
</Base>

<style>
  .pt { background: var(--paper); }
  /* La cabecera del sitio va absoluta encima: 88 px de cabecera y 56 de aire. */
  .pt-hero { padding: 144px 0 96px; }
  .pt-hero-in { position: relative; display: flex; flex-wrap: wrap; gap: 48px 64px; align-items: center; justify-content: center; }
  .pt-copy { flex: 1 1 440px; min-width: 0; display: flex; flex-direction: column; gap: 22px; }
  .pt-phone { flex: 0 1 380px; min-width: 0; max-width: 100%; }
  .pt-tag { font-size: 13px; letter-spacing: .12em; }
  .pt-h1 { font-size: clamp(36px, 4.2vw, 56px); line-height: 1.02; letter-spacing: -.045em; font-weight: 800; text-wrap: balance; }
  .acc { color: var(--sky-2); }
  .pt-lead { font-size: 19px; line-height: 1.55; color: var(--on-night-2); text-wrap: pretty; }
  .pt-ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .pt-hint { font-size: 14px; color: var(--on-night-3); }

  .pt-sec { padding: 96px 0; background: var(--bg); }
  .pt-sec.white { background: var(--paper); }
  .pt-in { display: flex; flex-direction: column; gap: 36px; }
  .pt-head { display: flex; flex-direction: column; gap: 14px; max-width: 860px; }
  .pt-h2 { font-size: clamp(34px, 4vw, 48px); line-height: 1.04; letter-spacing: -.035em; font-weight: 800; text-wrap: balance; }
  .pt-p { font-size: 18px; line-height: 1.55; color: var(--muted); text-wrap: pretty; }

  .pt-enter { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .pt-enter-copy { flex: 1.3 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .pt-login { flex: 0 1 340px; min-width: 0; max-width: 100%; margin: 0 auto; }
  .pt-steps { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .pt-steps li { display: flex; gap: 16px; align-items: flex-start; background: var(--bg); border-radius: 18px; padding: 18px 20px; }
  .pt-n { font-family: var(--agent-font); font-size: 12px; color: var(--teal); padding-top: 3px; }
  .pt-step { display: flex; flex-direction: column; gap: 4px; }
  .pt-step b { font-size: 17px; }
  .pt-step span { font-size: 15px; line-height: 1.5; color: var(--muted); }

  .pt-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr)); gap: 16px; }
  .pt-card { background: var(--paper); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; gap: 8px; }
  .pt-card h3 { font-size: 20px; line-height: 1.25; letter-spacing: -.01em; }
  .pt-card p { font-size: 16px; line-height: 1.5; color: var(--muted); }
  .pt-card a { font-weight: 700; }

  .pt-yours { display: flex; flex-wrap: wrap; gap: 48px; align-items: center; }
  .pt-yours-copy { flex: 1.3 1 460px; min-width: 0; display: flex; flex-direction: column; gap: 24px; }
  .pt-list { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; }
  .pt-list li { display: flex; flex-direction: column; gap: 4px; background: var(--bg); border-radius: 18px; padding: 18px 20px; }
  .pt-list b { font-size: 17px; }
  .pt-list span { font-size: 15px; line-height: 1.5; color: var(--muted); }
  .pt-sheet { flex: 0 1 340px; min-width: 0; max-width: 100%; margin: 0 auto; box-sizing: border-box; background: var(--bg); border: 1px solid var(--line); border-radius: 26px; padding: 22px; display: flex; flex-direction: column; align-items: center; gap: 12px; text-align: center; }
  .pt-sheet-org { display: inline-flex; align-items: center; gap: 8px; font-size: 14px; font-weight: 700; color: var(--ink-2); }
  .pt-sheet-org i { width: 28px; height: 28px; border-radius: 8px; background: var(--teal); color: #fff; font-style: normal; font-size: 12px; display: inline-flex; align-items: center; justify-content: center; }
  .pt-sheet-t { font-size: 19px; line-height: 1.25; }
  /* Un dibujo de QR, no un código que se pueda leer. */
  .pt-qr { width: 132px; height: 132px; box-sizing: border-box; border-radius: 12px; border: 10px solid var(--paper); background-color: var(--paper); background-image: repeating-conic-gradient(var(--ink) 0 25%, transparent 0 50%), repeating-conic-gradient(var(--ink) 0 25%, transparent 0 50%); background-size: 22px 22px, 38px 38px; background-position: 0 0, 7px 5px; }
  .pt-sheet-sub { font-size: 13px; color: var(--muted); }
  .pt-sw { align-self: stretch; margin-top: 4px; background: var(--paper); border-radius: 16px; padding: 14px; display: flex; flex-direction: column; align-items: center; gap: 10px; }
  .pt-sw-h { font-size: 13px; font-weight: 700; color: var(--ink-2); }
  .pt-sw-row { display: flex; gap: 10px; }
  .pt-sw-row i { width: 26px; height: 26px; border-radius: 50%; }
  .pt-sw-row i.on { box-shadow: 0 0 0 3px var(--paper), 0 0 0 5px var(--teal); }
  .pt-sw-btn { font-size: 14px; font-weight: 700; color: #fff; background: var(--teal); border-radius: 999px; padding: 9px 18px; }

  .pt-faq { background: var(--paper); padding-bottom: 8px; }

  @media (max-width: 720px) {
    .pt-hero { padding: 104px 0 56px; }
    .pt-hero-in { gap: 32px; }
    .pt-lead { font-size: 17px; }
    .pt-ctas :global(.btn) { flex: 1 1 100%; }
    .pt-copy, .pt-phone, .pt-enter-copy, .pt-login, .pt-yours-copy { flex-basis: 100%; }
    .pt-yours { gap: 28px; }
    .pt-list li { padding: 16px; }
    .pt-sec { padding: 64px 0; }
    .pt-in { gap: 28px; }
    .pt-enter { gap: 32px; }
    .pt-p { font-size: 16px; }
    .pt-steps li { padding: 16px; gap: 12px; }
  }
</style>
