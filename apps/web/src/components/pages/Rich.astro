---
// Texto plano que resalta los marcadores «[Por confirmar…]» para que nadie los pase por alto antes de publicar.
interface Props {
  text: string
}
const parts = Astro.props.text.split(/(\[Por confirmar[^\]]*\])/)
---
{parts.map((p) => (p.startsWith("[Por confirmar") ? <mark class="tbc">{p}</mark> : p))}

<style>
  .tbc { background: #fff1d6; color: #7a4a00; padding: 1px 6px; border-radius: 6px; font-family: var(--mono); font-size: .86em; }
</style>
