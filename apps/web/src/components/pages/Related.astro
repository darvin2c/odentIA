---
// «Sigue por aquí»: enlaces a las páginas relacionadas (agente ↔ módulo ↔ precios).
import { LINKS } from "../../lib/pages-data"

interface Props {
  hrefs: string[]
  white?: boolean
}
const { hrefs, white = false } = Astro.props
const items = hrefs.flatMap((href) => (LINKS[href] ? [{ href, ...LINKS[href] }] : []))
---
<section class:list={["section", "rel", { "section-white": white }]} aria-labelledby="rel-t">
  <div class="wrap">
    <div class="head">
      <span class="tag">[ Sigue por aquí ]</span>
      <h2 class="h2" id="rel-t">Lo que va con esto.</h2>
    </div>
    <ul class="list">
      {items.map((l) => (
        <li>
          <a href={l.href} class:list={["lk", { price: l.href === "/precios" }]}>
            <strong>{l.label}</strong>
            <span>{l.text}</span>
            <span class="arr" aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .head { display: flex; flex-direction: column; gap: 18px; margin-bottom: 40px; }
  .list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(300px, 100%), 1fr)); gap: 12px; }
  .lk { position: relative; display: flex; flex-direction: column; gap: 6px; height: 100%; padding: 20px 52px 20px 22px; border-radius: 18px; background: var(--paper); color: var(--ink); text-decoration: none; box-shadow: inset 0 0 0 1px var(--line); transition: box-shadow .2s ease, transform .2s ease; }
  .section-white .lk { background: var(--bg); }
  .lk:hover { color: var(--ink); box-shadow: inset 0 0 0 1.5px var(--teal); transform: translateY(-1px); }
  .lk strong { font-size: 17px; }
  .lk span { color: var(--muted); font-size: 15px; line-height: 1.5; }
  .lk .arr { position: absolute; right: 20px; top: 50%; transform: translateY(-50%); color: var(--teal); font-size: 20px; }
  /* Precios va siempre en oscuro, también dentro de una sección blanca. */
  .lk.price, .section-white .lk.price { background: var(--night); box-shadow: none; }
  .lk.price strong { color: #fff; }
  .lk.price span { color: var(--on-night-2); }
  .lk.price .arr { color: var(--sky); }
  .lk.price:hover { box-shadow: inset 0 0 0 1.5px var(--sky); }
</style>
