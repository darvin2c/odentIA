---
// Documento legal de la web: título, fecha de la versión, índice con anclas, secciones numeradas, tablas y
// marcadores «[Por completar…]» / «[Por confirmar…]» resaltados. Los textos viven en src/lib/legal/.
// Una página va con noindex mientras su texto conserve algún marcador.
//
// `page` (sin `doc`) mantiene la plantilla breve de las páginas que aún no tienen texto propio
// (LEGAL en src/lib/pages-data.ts); esas van siempre sin indexar.
import Base from "../../layouts/Base.astro"
import { breadcrumbJsonLd } from "../../lib/faq"
import { hasPending, LEGAL_UPDATED, LEGAL_UPDATED_ISO, type LegalDoc } from "../../lib/legal/types"
import type { LegalPageData } from "../../lib/pages-data"
import { contactEmail, legalLinks } from "../../lib/site"
import LegalText from "./LegalText.astro"

type Props = { doc: LegalDoc; page?: never } | { page: LegalPageData; doc?: never }

const props = Astro.props
const doc: LegalDoc = props.doc ?? {
  path: props.page.path,
  title: props.page.title,
  description: props.page.description,
  intro: [
    props.page.covers,
    `Si tienes una pregunta, escríbenos a [${contactEmail}](mailto:${contactEmail}).`,
  ],
  sections: [],
}
const noindex = props.doc ? hasPending(props.doc) : true
const trail: [string, string][] = [
  ["Inicio", "/"],
  [doc.title, doc.path],
]
const jsonLd = breadcrumbJsonLd(Astro.site, trail)
const others = legalLinks.filter((l) => l.href !== doc.path)
const hasToc = doc.sections.length > 1
---
<Base title={doc.title} description={doc.description} jsonLd={jsonLd} header="light" noindex={noindex}>
  <nav class="wrap crumbs" aria-label="Migas de pan">
    <ol>
      {trail.map(([name, path], i) => (
        <li>{i < trail.length - 1 ? <a href={path}>{name}</a> : <span aria-current="page">{name}</span>}</li>
      ))}
    </ol>
  </nav>
  <article class="wrap legal">
    <header class="head">
      <span class="tag">[ Legal ]</span>
      <h1 class="h2">{doc.title}</h1>
      {props.doc && <p class="updated">Última actualización: <time datetime={LEGAL_UPDATED_ISO}>{LEGAL_UPDATED}</time></p>}
      <p class="draft" role="note">Esta versión puede cambiar antes del lanzamiento.</p>
      {doc.intro.map((p) => <p class="intro"><LegalText text={p} /></p>)}
    </header>

    <div class:list={["layout", { "with-toc": hasToc }]}>
      {hasToc && (
        <nav class="toc" aria-labelledby="indice">
          <h2 id="indice" class="toc-t">Índice</h2>
          <ol>
            {doc.sections.map((s, i) => (
              <li><a href={`#${s.id}`}><span class="n">{i + 1}.</span> {s.title}</a></li>
            ))}
          </ol>
        </nav>
      )}

      <div class="body">
        {doc.sections.map((s, i) => (
          <section id={s.id} aria-labelledby={`${s.id}-t`}>
            <h2 id={`${s.id}-t`} class="sec-t"><span class="n">{i + 1}.</span> {s.title}</h2>
            {s.blocks.map((b) =>
              typeof b === "string" ? (
                <p><LegalText text={b} /></p>
              ) : "h" in b ? (
                <h3 class="sub">{b.h}</h3>
              ) : "list" in b ? (
                b.ordered ? (
                  <ol class="items">{b.list.map((it) => <li><LegalText text={it} /></li>)}</ol>
                ) : (
                  <ul class="items">{b.list.map((it) => <li><LegalText text={it} /></li>)}</ul>
                )
              ) : "table" in b ? (
                <table class="tbl">
                  <caption>{b.table.caption}</caption>
                  <thead>
                    <tr>{b.table.head.map((h) => <th scope="col">{h}</th>)}</tr>
                  </thead>
                  <tbody>
                    {b.table.rows.map((row) => (
                      <tr>
                        {row.map((cell, c) =>
                          c === 0 ? (
                            <th scope="row" data-label={b.table.head[c]}><LegalText text={cell} /></th>
                          ) : (
                            <td data-label={b.table.head[c]}><LegalText text={cell} /></td>
                          ),
                        )}
                      </tr>
                    ))}
                  </tbody>
                </table>
              ) : (
                <p class="callout"><LegalText text={b.note} /></p>
              ),
            )}
          </section>
        ))}

        <nav aria-labelledby="otras" class="others">
          <h2 id="otras" class="tag">Otras páginas legales</h2>
          <ul>{others.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
        </nav>
      </div>
    </div>
  </article>
</Base>

<style>
  .crumbs ol { list-style: none; margin: 0; padding: 18px 0 0; display: flex; flex-wrap: wrap; gap: 6px; font-size: 13.5px; color: var(--soft); }
  .crumbs li + li::before { content: "/"; margin-right: 6px; color: #cbd5e1; }
  .crumbs a { color: var(--soft); text-decoration: none; display: inline-block; padding: 6px 0; }
  .crumbs a:hover { color: var(--teal); }
  .crumbs span { display: inline-block; padding: 6px 0; color: var(--ink-2); }

  .legal { padding-top: 40px; padding-bottom: 112px; }
  .head { display: flex; flex-direction: column; gap: 16px; max-width: 820px; }
  .updated { color: var(--soft); font-size: 15px; }
  .draft { align-self: flex-start; padding: 10px 16px; border-radius: 12px; background: #fff4dc; color: #7a4a00; box-shadow: inset 0 0 0 1.5px var(--amber); font-size: 15px; font-weight: 600; }
  .intro { font-size: 18px; line-height: 1.6; color: var(--ink-2); }

  .layout { margin-top: 48px; display: grid; gap: 40px; }
  .layout.with-toc { grid-template-columns: 260px minmax(0, 1fr); align-items: start; }
  .toc { position: sticky; top: 24px; max-height: calc(100vh - 48px); overflow-y: auto; padding: 20px; border-radius: 16px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line); }
  .toc-t { font-family: var(--mono); font-size: 12px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--teal); margin-bottom: 10px; }
  .toc ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .toc a { display: flex; gap: 6px; padding: 6px 0; font-size: 14.5px; line-height: 1.35; color: var(--ink-2); text-decoration: none; }
  .toc a:hover, .toc a:focus-visible { color: var(--teal); text-decoration: underline; }
  .n { color: var(--soft); font-variant-numeric: tabular-nums; }

  .body { min-width: 0; max-width: 780px; display: flex; flex-direction: column; gap: 44px; }
  .body section { display: flex; flex-direction: column; gap: 14px; scroll-margin-top: 24px; }
  .sec-t { font-size: clamp(22px, 2vw, 26px); line-height: 1.2; letter-spacing: -.02em; font-weight: 800; color: var(--ink); }
  .sec-t .n { color: var(--teal); }
  .sub { font-size: 17px; font-weight: 700; color: var(--ink); margin-top: 8px; }
  .body p, .items { font-size: 16.5px; line-height: 1.65; color: var(--ink-2); overflow-wrap: break-word; }
  .items { margin: 0; padding-left: 1.3em; display: flex; flex-direction: column; gap: 8px; }
  .body a { color: var(--teal); font-weight: 600; overflow-wrap: anywhere; }
  .callout { padding: 14px 18px; border-radius: 12px; background: var(--teal-soft); }

  .tbl { width: 100%; border-collapse: collapse; font-size: 15px; line-height: 1.5; color: var(--ink-2); background: var(--paper); border-radius: 12px; overflow: hidden; box-shadow: inset 0 0 0 1px var(--line); }
  .tbl caption { text-align: left; caption-side: top; padding-bottom: 8px; font-size: 14px; color: var(--soft); }
  .tbl th, .tbl td { text-align: left; vertical-align: top; padding: 12px 14px; border-bottom: 1px solid var(--line); overflow-wrap: break-word; }
  .tbl thead th { font-size: 13px; font-weight: 700; color: var(--ink); background: #f1f5f9; }
  .tbl tbody th { font-weight: 700; color: var(--ink); }
  .tbl tbody tr:last-child > * { border-bottom: 0; }

  .others { display: flex; flex-direction: column; gap: 10px; padding-top: 24px; border-top: 1px solid var(--line); }
  .others ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 4px 20px; }
  .others a { display: inline-block; padding: 8px 0; }

  @media (max-width: 960px) {
    .layout.with-toc { grid-template-columns: minmax(0, 1fr); }
    .toc { position: static; max-height: none; }
  }
  @media (max-width: 720px) {
    .legal { padding-top: 24px; padding-bottom: 72px; }
    .layout { margin-top: 32px; gap: 32px; }
    .body { gap: 36px; }
    /* En el móvil, cada fila de la tabla es una tarjeta con la etiqueta de cada columna. */
    .tbl, .tbl tbody, .tbl tr, .tbl th, .tbl td { display: block; }
    .tbl { background: none; box-shadow: none; }
    .tbl thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
    .tbl tbody tr { margin-bottom: 12px; border-radius: 12px; background: var(--paper); box-shadow: inset 0 0 0 1px var(--line); }
    .tbl tbody th, .tbl td { border-bottom: 1px solid var(--line); padding: 10px 14px; }
    .tbl tbody tr > :last-child { border-bottom: 0; }
    .tbl td::before { content: attr(data-label); display: block; font-size: 12px; font-weight: 700; color: var(--soft); text-transform: uppercase; letter-spacing: .04em; margin-bottom: 2px; }
    .tbl caption { display: block; }
  }
</style>
