---
// Presupuestos (lienzo del paso 3): la portada con el presupuesto de Carlos que se acepta, el paso a
// paso del dictado a la cita, lo que ve el paciente en Su enlace, las preguntas y el cierre.
// Título, descripción y preguntas son los de PAGES.presupuestos; los montos en soles son del ejemplo.
import Base from "../../layouts/Base.astro"
import { breadcrumbJsonLd, faqJsonLd } from "../../lib/faq"
import { PAGES } from "../../lib/pages-data"
import { days, giftOf, shownPlan } from "../../lib/pricing"
import { WORDS } from "../../lib/product"
import { ctaOf } from "../../lib/site"
import CtaBand from "../CtaBand.astro"
import Faq from "../Faq.astro"
import BudgetDemo from "./BudgetDemo"

const page = PAGES.presupuestos
const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const founder = plan !== null && plan === pricing.founders
const gift = giftOf(pricing)
const cta = ctaOf(pricing)
const jsonLd = [
  breadcrumbJsonLd(Astro.site, [
    ["Inicio", "/"],
    [page.crumb, page.path],
  ]),
  faqJsonLd(page.faq),
]

const steps: Array<{ n: string; who: string; tone: "clio" | "team" | "argos"; title: string; text: string }> = [
  { n: "01", who: "Clío", tone: "clio", title: "Dictas el plan", text: "«Resina en la 36, o si no una corona.»" },
  { n: "02", who: "Tú", tone: "team", title: "Confirmas las opciones", text: "Con los precios de tu tarifario; puedes ajustar una línea con su motivo." },
  { n: "03", who: "Al cerrar", tone: "team", title: "«¿Enviárselo ahora?»", text: "Le llega por WhatsApp con su enlace." },
  { n: "04", who: "El paciente", tone: "team", title: "Elige desde su celular", text: "Una opción o solo una parte, y elige el horario ahí mismo." },
  { n: "05", who: "Argos", tone: "argos", title: "Retoma lo pendiente", text: "A los dos días sin respuesta, y avisa si se aceptó sin cita." },
]
---
<Base title={page.title} description={page.description} jsonLd={jsonLd}>
  <section class="hero ph">
    <div class="grain" aria-hidden="true"></div>
    <div class="wrap in">
      <div class="copy">
        <span class="tag tag-d rise">[ Presupuestos ]</span>
        <h1 class="t rise d1">Presupuestos dentales claros, <span class="acc">con hasta tres opciones.</span></h1>
        <p class="lead lead-d rise d2">
          Salen del plan y del odontograma con los precios de tu tarifario. El paciente elige desde su celular y, si no
          responde, Argos lo retoma.
        </p>
        <div class="ctas rise d3">
          <a class="btn btn-p" href={cta.href}>{cta.label}</a>
          <a class="btn btn-g" href="/agentes/administrador">Conoce a Argos</a>
        </div>
      </div>
      <div class="demo rise d2">
        <BudgetDemo client:load />
      </div>
    </div>
  </section>

  <section class="section steps-s">
    <div class="wrap col">
      <div class="head">
        <span class="tag">[ Paso a paso ]</span>
        <h2 class="h2 t2">Del dictado a la cita, sin escribir montos a mano.</h2>
      </div>
      <ol class="steps">
        {steps.map((step) => (
          <li class="step">
            <span class:list={["who", step.tone]}>{step.n} · {step.who}</span>
            <b>{step.title}</b>
            <span class="txt">{step.text}</span>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="section section-white sees">
    <div class="wrap row">
      <div class="side">
        <span class="tag">[ Lo que ve el paciente ]</span>
        <h2 class="h2 t3">Compara con calma y decide sin llamar.</h2>
        <p class="lead">En Su enlace, sin contraseña. Si prefiere escribir, Sofi anota su sí o su no en la conversación.</p>
      </div>
      {/* Ilustración de la pantalla del paciente: no son controles de esta página. */}
      <div class="phone" role="img" aria-label="Ejemplo de Su enlace: el presupuesto con la opción A recomendada, por S/ 300, y la opción B, por S/ 1.070">
        <span class="ph-org">Clínica Sonrisa Norte · Su enlace</span>
        <b class="ph-t">Tu presupuesto</b>
        <div class="ph-opt ph-pick">
          <span class="ph-row"><b>Opción A · Resina</b><b>S/ 300</b></span>
          <span class="ph-sub">Recomendada por la Dra. Paredes</span>
        </div>
        <div class="ph-opt"><span class="ph-row"><b>Opción B · Corona</b><b>S/ 1.070</b></span></div>
        <span class="ph-sub">Puedes aceptar solo una parte.</span>
        <span class="ph-btn">Aceptar la opción A</span>
        <span class="ph-link">Elegir horario</span>
      </div>
    </div>
  </section>

  <div class="faqwrap"><Faq items={page.faq} /></div>

  <CtaBand title="Presupuestos que se entienden y no se olvidan.">
    <Fragment slot="text">
      {gift ? (
        founder ? (
          <>Los primeros <span class="gift">{gift}</span> de tus agentes los pagamos nosotros. Sin tarjeta y sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
        ) : (
          <>Obtén <span class="gift">{gift}</span> de crédito y pruébalo {days(plan?.trialDays ?? pricing.terms.trialDays)} sin tarjeta, sin límite de {WORDS.clinicians}, sedes ni usuarios.</>
        )
      ) : (
        `Tus agentes trabajan en ${WORDS.yourClinic} desde el primer día, sin tarjeta y sin límite de ${WORDS.clinicians}, sedes ni usuarios.`
      )}
    </Fragment>
  </CtaBand>
</Base>

<style>
  /* La cabecera va encima, absoluta: el espacio de arriba es el suyo. */
  .ph { padding: 152px 0 88px; }
  .in { position: relative; z-index: 2; display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1fr); gap: 48px; align-items: center; }
  .copy { display: flex; flex-direction: column; gap: 22px; }
  .t { font-size: clamp(38px, 4.4vw, 54px); line-height: 1.02; letter-spacing: -.045em; font-weight: 800; text-wrap: balance; }
  .acc { color: var(--sky-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .demo { min-width: 0; }

  .steps-s { padding: 96px 0; background: var(--bg); }
  .col { display: flex; flex-direction: column; gap: 32px; }
  .head { display: flex; flex-direction: column; gap: 14px; max-width: 860px; }
  .t2 { font-size: clamp(34px, 4vw, 48px); }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(auto-fit, minmax(min(210px, 100%), 1fr)); gap: 12px; }
  .step { background: var(--paper); border-radius: 18px; padding: 20px; display: flex; flex-direction: column; gap: 8px; }
  .who { font-family: var(--agent-font); font-size: 12px; letter-spacing: .04em; text-transform: uppercase; color: var(--teal); }
  .who.clio { color: #1f7f63; }
  .who.argos { color: #9a6a12; }
  .step b { font-size: 17px; line-height: 1.3; }
  .txt { font-size: 15px; line-height: 1.45; color: var(--muted); }

  .sees { padding: 96px 0 120px; }
  .row { display: flex; flex-wrap: wrap; gap: 56px; align-items: center; }
  .side { flex: 1 1 420px; min-width: 0; display: flex; flex-direction: column; gap: 14px; }
  .t3 { font-size: clamp(32px, 3.6vw, 44px); }
  .side .lead { font-size: 17px; }
  .phone { flex: 0 1 340px; width: 340px; max-width: 100%; background: var(--bg); border: 1px solid var(--line); border-radius: 30px; padding: 18px; display: flex; flex-direction: column; gap: 12px; }
  .ph-org { font-family: var(--agent-font); font-size: 11px; letter-spacing: .08em; text-transform: uppercase; color: var(--soft); }
  .ph-t { font-size: 20px; }
  .ph-opt { background: var(--paper); border: 1px solid #cbd5e1; border-radius: 16px; padding: 14px; display: flex; flex-direction: column; gap: 6px; }
  .ph-pick { border: 2px solid var(--teal); padding: 13px; }
  .ph-row { display: flex; justify-content: space-between; gap: 12px; }
  .ph-sub { font-size: 13px; color: var(--muted); }
  .ph-btn { text-align: center; font-weight: 700; color: #fff; background: var(--night); border-radius: 999px; padding: 14px; }
  .ph-link { text-align: center; font-weight: 700; color: var(--teal); padding: 6px; }

  .faqwrap { background: var(--bg); }

  @media (max-width: 960px) {
    .ph { padding: 110px 0 64px; }
    .in { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 720px) {
    .copy { gap: 18px; }
    .ctas .btn { flex: 1 1 100%; }
    .steps-s { padding: 64px 0; }
    .col { gap: 24px; }
    .steps { gap: 10px; }
    .step { padding: 16px; }
    .sees { padding: 64px 0 72px; }
    .row { gap: 28px; }
    .phone { width: 100%; flex-basis: 100%; }
  }
</style>
