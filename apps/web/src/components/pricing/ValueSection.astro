---
// La tarjeta del plan al lado de «Calcula tu mes»: la calculadora se hidrata al entrar en pantalla y
// recibe la tarjeta (armada aquí, en el servidor) para ponerla a su lado.
import { shownPlan, valuePricesOf } from "../../lib/pricing"
import PlanCard from "./PlanCard.astro"
import ValueCalculator from "./ValueCalculator"

const plan = shownPlan(Astro.locals.pricing)
const prices = valuePricesOf(plan)
---
{/* Sin plan publicado no hay tarjeta ni cuenta: la sección no se dibuja en vez de quedar vacía. */}
{plan ? (
  <section class="section section-white month">
    <div class="wrap">
      {prices ? (
        <ValueCalculator client:visible prices={prices}>
          <PlanCard />
        </ValueCalculator>
      ) : (
        <PlanCard />
      )}
    </div>
  </section>
) : null}

<style>
  .month { padding: 96px 0; }
  @media (max-width: 720px) { .month { padding: 56px 0; } }
</style>
