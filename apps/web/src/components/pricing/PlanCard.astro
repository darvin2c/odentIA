---
// La tarjeta del plan que se muestra: su cuota, que vuelve como crédito, y la prueba. Si el plan no
// tiene cuota, lo dice. Va al lado de «Calcula tu mes». Lienzo «Precios: por lo que hizo».
import { trialText } from "../../lib/offer"
import { money, shownPlan } from "../../lib/pricing"
import { ctaOf } from "../../lib/site"
import GiftText from "../GiftText.astro"

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const cta = ctaOf(pricing)
const trial = trialText(pricing)
---
{plan ? (
  <div class="plan">
    <span class="tag tag-d">{plan.name}</span>
    <div class="amount">
      {plan.plan > 0 ? (
        <><span class="big">{money(plan.plan, plan.currency)}</span><span class="per">al mes</span></>
      ) : (
        <span class="big">Sin cuota</span>
      )}
    </div>
    {plan.plan > 0 && plan.credit > 0 ? (
      <p class="back">Te devolvemos {`${plan.credit === plan.plan ? "los " : ""}${money(plan.credit, plan.currency)}`} en crédito para lo que hagan tus agentes. Es lo mínimo que pagas en un mes.</p>
    ) : plan.plan > 0 ? (
      <p class="back">Es lo mínimo que pagas en un mes; lo que hacen tus agentes se suma.</p>
    ) : (
      <p class="back">Pagas solo lo que hacen tus agentes.</p>
    )}
    <a class="btn btn-p cta" href={cta.href}>{cta.label}</a>
    {trial ? <span class="mono trial"><GiftText text={`${trial}, sin tarjeta.`} /></span> : null}
  </div>
) : null}

<style>
  .plan { border-radius: 26px; padding: 36px; background: var(--night); color: var(--on-night); display: flex; flex-direction: column; gap: 18px; }
  .tag { letter-spacing: .1em; }
  .amount { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .big { font-size: clamp(48px, 6vw, 72px); font-weight: 800; letter-spacing: -.05em; line-height: .9; }
  .per { color: var(--on-night-2); font-size: 18px; font-weight: 600; }
  .back { font-size: 18px; line-height: 1.5; color: var(--on-night-2); }
  .cta { align-self: flex-start; }
  .trial { font-size: 13px; line-height: 1.5; color: var(--on-night-3); }
  @media (max-width: 720px) {
    .plan { border-radius: 20px; padding: 22px 20px; gap: 14px; }
    .back { font-size: 16px; }
    .cta { align-self: stretch; }
  }
</style>
