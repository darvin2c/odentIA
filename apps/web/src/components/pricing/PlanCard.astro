---
// La tarjeta del plan que se muestra: su cuota, que vuelve como crédito, y la prueba, con su calendario
// (hoy, la prueba y el día que empieza el plan) para que nadie descubra la cuota el día 31. Si el plan
// no tiene cuota, lo dice. Va al lado de «Calcula tu mes». Lienzo «Precios: por lo que hizo».
import { trialText } from "../../lib/offer"
import { days, money, shownPlan } from "../../lib/pricing"
import { ctaOf } from "../../lib/site"
import GiftText from "../GiftText.astro"

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const cta = ctaOf(pricing)
const trial = trialText(pricing)
---
{plan ? (
  <div class="plan">
    <span class="tag tag-d">{plan.name}</span>
    <div class="amount">
      {plan.plan > 0 ? (
        <><span class="big">{money(plan.plan, plan.currency)}</span><span class="per">al mes</span></>
      ) : (
        <span class="big">Sin cuota</span>
      )}
    </div>
    {plan.plan > 0 && plan.credit > 0 ? (
      <p class="back">Te devolvemos {`${plan.credit === plan.plan ? "los " : ""}${money(plan.credit, plan.currency)}`} en crédito para lo que hagan tus agentes. Es lo mínimo que pagas en un mes.</p>
    ) : plan.plan > 0 ? (
      <p class="back">Es lo mínimo que pagas en un mes; lo que hacen tus agentes se suma.</p>
    ) : (
      <p class="back">Pagas solo lo que hacen tus agentes.</p>
    )}
    {plan.trialDays > 0 ? (
      <ol class="steps" aria-label="Cómo empiezas">
        <li><span class="k">Hoy</span><span>Creas tu cuenta y abres tu clínica, sin tarjeta.</span></li>
        <li><span class="k">Días 1 a {plan.trialDays}</span><span>{plan.trialCredit > 0 ? <>Tus agentes trabajan con <b class="gift">{money(plan.trialCredit, plan.currency)}</b> de regalo.</> : `Pruebas todo ${days(plan.trialDays)}.`}</span></li>
        <li><span class="k">Día {plan.trialDays + 1}</span><span>{plan.plan > 0 ? `Eliges tu plan: ${money(plan.plan, plan.currency)} al mes. Si no, solo lectura, sin perder datos.` : "Eliges tu plan. Si no, solo lectura, sin perder datos."}</span></li>
      </ol>
    ) : null}
    <a class="btn btn-p cta" href={cta.href}>{cta.label}</a>
    {/* Sin calendario (un plan sin prueba), la prueba en una línea; con él, ya lo dice arriba. */}
    {trial && plan.trialDays <= 0 ? <span class="mono trial"><GiftText text={`${trial}, sin tarjeta.`} /></span> : null}
  </div>
) : null}

<style>
  .plan { border-radius: 26px; padding: 36px; background: var(--night); color: var(--on-night); display: flex; flex-direction: column; gap: 18px; }
  .tag { letter-spacing: .1em; }
  .amount { display: flex; flex-wrap: wrap; align-items: baseline; gap: 10px; }
  .big { font-size: clamp(48px, 6vw, 72px); font-weight: 800; letter-spacing: -.05em; line-height: .9; }
  .per { color: var(--on-night-2); font-size: 18px; font-weight: 600; }
  .back { font-size: 18px; line-height: 1.5; color: var(--on-night-2); }
  .steps { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; }
  .steps li { border-radius: 14px; padding: 14px; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .14); display: flex; flex-direction: column; gap: 4px; font-size: 15px; line-height: 1.4; }
  .steps .gift { color: var(--amber); }
  .k { font-family: var(--agent-font); font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--sky-2); }
  .cta { align-self: flex-start; }
  .trial { font-size: 13px; line-height: 1.5; color: var(--on-night-3); }
  @media (max-width: 720px) {
    .plan { border-radius: 20px; padding: 22px 20px; gap: 14px; }
    .back { font-size: 16px; }
    .steps { grid-template-columns: 1fr; }
    .steps li { flex-direction: row; align-items: baseline; gap: 10px; padding: 10px 12px; }
    .k { flex: none; min-width: 92px; }
    .cta { align-self: stretch; }
  }
</style>
