---
// Portada de Precios: «Todo el sistema. Pagas con el trabajo de tus agentes.», la cuota del plan que
// se muestra y que vuelve como crédito, lo que cuesta cada trabajo, lo incluido y la prueba. Al lado,
// la cuenta de un jueves que se llena fila por fila (isla WorkDayLedger). Si el plan no tiene cuota,
// la cifra es el trabajo más barato («Desde»). Sin un plan publicado, la misma portada sin cifras ni
// cuenta: el h1 sigue en su sitio. Lienzo «Precios: por lo que hizo».
import { offerOf, trialText } from "../../lib/offer"
import { money, shownPlan, valuePricesOf } from "../../lib/pricing"
import { HAS_CLIO, WORDS } from "../../lib/product"
import { SHOWS_VALUE } from "../../lib/value"
import { contactHref, ctaOf } from "../../lib/site"
import GiftText from "../GiftText.astro"
import WorkDayLedger from "./WorkDayLedger"

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const prices = valuePricesOf(plan)
const cta = ctaOf(pricing)
const { fee, credit } = offerOf(pricing)
const trial = trialText(pricing)
/** El trabajo más barato: una respuesta de Sofi o, donde Clío trabaja, una consulta simple suya. */
const cheapest = (p: typeof plan) => {
  const prices = [p?.tiers.informa, HAS_CLIO ? p?.tiers.simple : null].filter((value): value is number => value != null)
  return prices.length ? Math.min(...prices) : null
}
const from = cheapest(plan)
/** «una respuesta de Sofi, USD 0,20; una receta de Clío, USD 0,10»: lo que cuesta cada trabajo simple. */
const examples = (() => {
  const sofi = plan?.tiers.informa ?? null
  const clio = HAS_CLIO ? (plan?.tiers.simple ?? null) : null
  if (!plan) return null
  const parts = [
    sofi !== null ? `una respuesta de Sofi, ${money(sofi, plan.currency)}` : null,
    clio !== null ? `una receta de Clío, ${money(clio, plan.currency)}` : null,
  ].filter(Boolean)
  return parts.length ? parts.join("; ") : null
})()
/** «Sofi, Clío y Argos»: los agentes que trabajan en este producto. */
const names = HAS_CLIO ? "Sofi, Clío y Argos" : "Sofi y Argos"
/** Con cuota: lo que cuesta cada trabajo y de dónde se descuenta. Sin cuota (rama genérica): solo lo que cuesta. */
const explain = (() => {
  if (!plan) return null
  const work = examples ? `: ${examples}; lo que te trae ${WORDS.patients}, más.` : "."
  if (fee && credit) return `Cada trabajo de ${names} se descuenta de tus ${credit}${work} Si un mes hacen más, pagas la diferencia.`
  if (fee) return `Además, cada trabajo de ${names} tiene su precio${work}`
  return `Sin cuota: pagas solo lo que hacen ${names}${work}`
})()
/** «al mes, que vuelven enteros como crédito», o lo que diga el plan si el crédito no es toda la cuota. */
const feePer =
  plan && fee ? (credit && plan.credit === plan.plan ? "al mes, que vuelven enteros como crédito" : credit ? `al mes, con ${credit} de crédito para tus agentes` : "al mes") : null
const people = `${WORDS.clinicians.charAt(0).toUpperCase()}${WORDS.clinicians.slice(1)}, sedes y usuarios`
---
<section class:list={["hero", "ph", { split: prices }]}>
  <div class="grain" aria-hidden="true"></div>
  <div class="wrap in">
    <div class="copy">
      <span class="tag tag-d rise">[ Precios ]</span>
      <h1 class="t rise d1">Todo el sistema. <span class="acc">Pagas con el trabajo de tus agentes.</span></h1>
      {plan && fee ? (
        <div class="from rise d2">
          <div class="from-row">
            <span class="from-amt">{fee}</span>
            <span class="from-per">{feePer}</span>
          </div>
          {explain ? <span class="from-what">{explain}</span> : null}
        </div>
      ) : plan && from !== null ? (
        <div class="from rise d2">
          <span class="from-word">Desde</span>
          <div class="from-row">
            <span class="from-amt">{money(from, plan.currency)}</span>
            <span class="from-per">por trabajo</span>
          </div>
          {explain ? <span class="from-what">{explain}</span> : null}
        </div>
      ) : (
        <p class="lead lead-d rise d2">
          Cada cosa que hace un agente es un trabajo con su precio: lo simple cuesta poco y lo que te trae {WORDS.patients} cuesta
          más. El sistema completo viene incluido, sin límite de {WORDS.clinicians}, sedes ni usuarios.
        </p>
      )}
      {plan ? (
        <div class="chips rise d2">
          <a class="chip" href="#incluido">Agenda, historia, caja y omnicanal <b>incluidos</b></a>
          <span class="chip">{people} <b>sin límite</b></span>
        </div>
      ) : null}
      <div class="ctas rise d3">
        <a class="btn btn-p" href={cta.href}>{cta.label}</a>
        {prices && SHOWS_VALUE ? <a class="btn btn-g" href="#calcula">Calcula tu mes</a> : null}
      </div>
      <p class="mono note rise d4">
        {trial ? (
          <GiftText text={`${trial}, sin tarjeta. Si no sigues, tus datos quedan y solo se pueden leer.`} />
        ) : (
          // Sin plan publicado, lo mismo que las páginas de cada agente: no hay cifras que esconder.
          <>Los precios se publican pronto. <a href={contactHref}>Escríbenos</a> y te los contamos.</>
        )}
      </p>
    </div>
    {prices && plan ? (
      <div class="ledger rise d2">
        <WorkDayLedger
          client:load
          prices={prices}
          currency={plan.currency}
          note={`Ejemplo con los precios del ${plan.name}.`}
        />
      </div>
    ) : null}
  </div>
</section>

<style>
  /* La cabecera va encima, absoluta: el espacio de arriba es el suyo. */
  .ph { padding: 124px 0 72px; }
  .in { position: relative; z-index: 2; display: grid; gap: 56px; align-items: center; }
  .split .in { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); }
  .copy { display: flex; flex-direction: column; gap: 18px; max-width: 640px; }
  .t { font-size: clamp(36px, 4vw, 52px); line-height: 1.02; letter-spacing: -.045em; font-weight: 800; text-wrap: balance; }
  .acc { color: var(--sky-2); }
  .ctas { display: flex; flex-wrap: wrap; gap: 12px; }
  .note { font-size: 13px; color: var(--on-night-3); line-height: 1.5; }
  .note a { color: var(--sky-2); text-decoration: underline; text-underline-offset: 3px; }
  /* «Desde» del tamaño de un titular: es lo primero que se lee del precio. */
  .from { display: flex; flex-direction: column; gap: 4px; }
  .from-word { font-size: clamp(22px, 2vw, 28px); font-weight: 700; letter-spacing: -.02em; color: var(--on-night-2); }
  .from-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 14px; }
  .from-amt { font-size: clamp(56px, 5.6vw, 80px); font-weight: 800; letter-spacing: -.055em; line-height: .9; }
  .from-per { font-size: 20px; font-weight: 600; color: var(--on-night-2); }
  .from-what { font-size: 16px; line-height: 1.45; color: var(--on-night-2); }
  .chips { display: flex; flex-wrap: wrap; gap: 10px; }
  .chip { border-radius: 999px; padding: 9px 14px; font-size: 15px; font-weight: 600; color: var(--on-night); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--sky-2) 40%, transparent); text-decoration: none; }
  .chip b { color: var(--mint); }
  :global(:root[data-brand="latidia"]) .chip b { color: #ece4fb; }
  :global(:root[data-brand="vistia"]) .chip b { color: #dcfce7; }
  a.chip:hover { background: color-mix(in srgb, var(--sky-2) 10%, transparent); }
  .ledger { min-width: 0; }
  @media (max-width: 960px) {
    .ph { padding: 110px 0 64px; }
    .split .in { grid-template-columns: 1fr; gap: 36px; }
  }
  @media (max-width: 720px) {
    .copy { gap: 18px; }
    .from-per { font-size: 16px; }
    .from-what { font-size: 15px; }
      .ctas .btn { flex: 1 1 100%; }
  }
</style>
