---
// «Un plan, y cada agente cobra por lo que hizo» (ADR 0085, tablero W1): el plan mensual, que vuelve
// como crédito, y el precio de cada tipo por agente. Mientras se entra por invitación y el plan
// Fundadores se publica, la tarjeta es la del Fundador: sin cuota, con el regalo y cada precio con el
// de lista tachado.
import { businessDays, hours, money, shownPlan } from "../../lib/pricing"
import { MEDICAL, WORDS } from "../../lib/product"
import { ctaOf } from "../../lib/site"

const pricing = Astro.locals.pricing
const plan = shownPlan(pricing)
const list = pricing.list
const founder = plan !== null && plan === pricing.founders ? pricing.founders : null
const cta = ctaOf(pricing)
// Las condiciones comerciales: de la administración, como los precios.
const terms = pricing.terms
const cut = (value: number) => {
  const text = money(value, plan!.currency).replace(`${plan!.currency} `, "")
  return text.includes(",") ? text : `${text},00`
}
const struck = (own: number | null, base: number | null | undefined) =>
  founder && own !== null && base !== null && base !== undefined && base !== own ? cut(base) : null

type Row = { label: string; price: number | null; before?: string | null; text?: string }
const agents: Array<{ name: string; does: string; when: string; href: string; rows: Row[] }> = plan
  ? [
      {
        name: "Sofi",
        does: "Atiende",
        when: `Una vez por persona cada ${hours(terms.conversationWindowHours)}, según lo que pasó en tu agenda.`,
        href: "/agentes/recepcion",
        rows: [
          { label: "Respondió o confirmó", price: plan.tiers.informa, before: struck(plan.tiers.informa, list?.tiers.informa) },
          { label: "Reservó, movió o canceló una cita", price: plan.tiers.gestiona, before: struck(plan.tiers.gestiona, list?.tiers.gestiona) },
          { label: "El paciente vino", price: plan.tiers.agenda, before: struck(plan.tiers.agenda, list?.tiers.agenda) },
        ],
      },
      {
        name: "Clío",
        does: "Documenta",
        when: `Una vez por atención, cuando el ${WORDS.clinician} confirma.`,
        href: "/agentes/asistente-clinico",
        rows: [
          // ADR 0085: simple es una sola parte; estándar, un diagnóstico, el odontograma o dos partes o más.
          // En latidIA, lo que lo hace estándar es más de una parte (el examen, el diagnóstico) y completa, dejar indicado lo que sigue.
          { label: "Una nota, receta o control", price: plan.tiers.simple, before: struck(plan.tiers.simple, list?.tiers.simple) },
          { label: MEDICAL ? "Nota con examen o diagnóstico" : "Diagnóstico, odontograma o más de una parte", price: plan.tiers.estandar, before: struck(plan.tiers.estandar, list?.tiers.estandar) },
          { label: MEDICAL ? "Dejó indicado lo que sigue" : "Armó el presupuesto", price: plan.tiers.completa, before: struck(plan.tiers.completa, list?.tiers.completa) },
        ],
      },
      {
        name: "Argos",
        does: "Recupera",
        when: "Cuando el paciente que no tenía cita ni tratamiento en curso vuelve y viene.",
        href: "/agentes/administrador",
        rows: [
          { label: "Cita recuperada", price: plan.recovered, before: struck(plan.recovered, list?.recovered) },
          ...(plan.argos
            ? [
                { label: `${plan.argos.included} preguntas al mes`, price: null, text: "incluidas" },
                { label: `${plan.argos.packQuestions} preguntas más`, price: plan.argos.pack, before: struck(plan.argos.pack, list?.argos?.pack) },
              ]
            : []),
        ],
      },
    ]
  : []
---
<section class="wrap sec" id="precio">
  <div class="head">
    <span class="tag">[ El precio ]</span>
    <h2 class="h2">{founder ? "Fundadores: entras gratis." : "Un plan, y cada agente cobra por lo que hizo."}</h2>
  </div>
  {plan ? (
    <div class="grid">
      <div class="plan">
        <span class="tag tag-d">{founder ? "Programa Fundadores" : plan.name}</span>
        <div class="amount">
          <span class="big">{money(plan.plan, plan.currency)}</span><span class="per">al mes</span>
          {founder && list && list.plan !== plan.plan ? <s class="per">{money(list.plan, list.currency)}</s> : null}
        </div>
        {founder ? (
          <p class="back">
            Sin cuota. Los primeros <b class="gift">{money(plan.trialCredit, plan.currency)}</b> de tus agentes los pagamos nosotros y, después, pagas solo lo que hacen
            {founder.discountPercent ? <>, con <b>{founder.discountPercent} % menos</b></> : null}.
          </p>
        ) : (
          <p class="back">Te devolvemos los {money(plan.credit, plan.currency)} en crédito para lo que hagan tus agentes. Es lo mínimo que pagas en un mes.</p>
        )}
        <ul class="feats">
          {founder?.guaranteeMonths ? <li>Estas condiciones se mantienen {founder.guaranteeMonths} meses desde que entras.</li> : null}
          <li>El sistema completo, igual para todas las clínicas, sin límite de {WORDS.clinicians}, sedes ni usuarios.</li>
          {plan.argos || plan.storage ? (
            <li>
              {[plan.argos ? `${plan.argos.included} preguntas a Argos al mes` : null, plan.storage ? `${plan.storage.includedGb} GB` : null].filter(Boolean).join(" y ")} incluidos.
            </li>
          ) : null}
          <li>Un presupuesto del mes que eliges tú, con aviso antes de llegar.</li>
          <li>Pagas al cerrar tu mes, después de usar.</li>
        </ul>
        <a class="btn btn-p cta" href={cta.href}>{cta.label}</a>
        <span class="mono trial">
          {founder
            ? `Sin tarjeta. Se entra por invitación: te respondemos en ${businessDays(terms.waitlistAnswerDays)}.`
            : <>{plan.trialDays} días gratis, con <span class="gift">{money(plan.trialCredit, plan.currency)}</span> de crédito para tus agentes.</>}
        </span>
      </div>
      <div class="acts">
        {agents.map((agent) => (
          <div class="card act">
            <span class="ag-name">{agent.name} · {agent.does}</span>
            <span class="d">{agent.when}</span>
            <dl class="rows">
              {agent.rows.filter((row) => row.price !== null || row.text).map((row) => (
                <div class="row">
                  <dt>{row.label}</dt>
                  <dd>
                    {row.price !== null ? cut(row.price) : row.text}
                    {row.before ? <s class="was">{row.before}</s> : null}
                  </dd>
                </div>
              ))}
            </dl>
            {/* latidIA aún no tiene una página por agente: su inicio los cuenta. */}
            {MEDICAL ? null : <a class="ag" href={agent.href}>Lo que hace {agent.name} →</a>}
          </div>
        ))}
        <p class="mono nt">Precios en {plan.currency === "USD" ? "dólares" : plan.currency} más impuestos.{plan.storage ? ` Desde el GB ${plan.storage.includedGb + 1}, ${money(plan.storage.perGb, plan.currency)} por GB al mes.` : ""}</p>
      </div>
    </div>
  ) : (
    <p class="lead">Los precios se publican en un momento. <a href="/contacto">Escríbenos</a> y te los contamos.</p>
  )}
</section>

<style>
  .sec { padding-top: 104px; padding-bottom: 104px; display: flex; flex-direction: column; gap: 40px; }
  .head { display: flex; flex-direction: column; gap: 18px; max-width: 820px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(360px, 100%), 1fr)); gap: 20px; }
  .plan { border-radius: 26px; padding: 36px; background: var(--night); color: var(--on-night); display: flex; flex-direction: column; gap: 22px; }
  .amount { display: flex; align-items: baseline; gap: 10px; }
  .big { font-size: 76px; font-weight: 800; letter-spacing: -.05em; line-height: .9; }
  .per { font-size: 17px; color: #9fb8bf; }
  .back { font-size: 19px; line-height: 1.5; color: #d6e8ec; }
  .feats { margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px; font-size: 16px; line-height: 1.5; color: #cfe2e7; }
  .cta { align-self: flex-start; }
  .trial { font-size: 13px; color: var(--on-night-3); }
  .acts { display: flex; flex-direction: column; gap: 14px; }
  .act { padding: 24px 26px; display: flex; flex-direction: column; gap: 8px; }
  .ag-name { font-family: var(--mono); font-size: 13px; font-weight: 700; letter-spacing: .06em; text-transform: uppercase; color: var(--teal); }
  .rows { margin: 4px 0 0; display: flex; flex-direction: column; gap: 6px; }
  .row { display: flex; align-items: baseline; justify-content: space-between; gap: 16px; }
  .row dt { font-size: 16px; line-height: 1.4; }
  .row dd { margin: 0; font-size: 22px; font-weight: 800; letter-spacing: -.02em; white-space: nowrap; display: flex; align-items: baseline; gap: 8px; }
  .was { font-size: 14px; font-weight: 600; letter-spacing: 0; color: var(--soft); }
  .d { color: var(--muted); line-height: 1.5; }
  .nt { font-size: 13px; color: var(--soft); }
  .ag { align-self: flex-start; font-size: 14px; font-weight: 700; text-decoration: none; padding: 6px 0; min-height: 32px; }
  .ag:hover { text-decoration: underline; }
  @media (max-width: 720px) {
    .sec { padding-top: 56px; padding-bottom: 40px; gap: 14px; }
    .head { gap: 14px; }
    .h2 { font-size: 34px; }
    .grid { gap: 14px; }
    .plan { border-radius: 20px; padding: 22px 20px; gap: 14px; }
    .big { font-size: 56px; }
    .per { font-size: 15px; }
    .back { font-size: 16px; }
    .feats { font-size: 14.5px; gap: 6px; }
    .cta { align-self: stretch; }
    .act { border-radius: 16px; padding: 16px; gap: 6px; }
    .row dt { font-size: 14.5px; }
    .row dd { font-size: 19px; }
    .d { font-size: 14px; }
    .nt { font-size: 12px; }
  }
</style>
