---
// Cabecera: se superpone a la portada oscura de cada página; en teléfono, un menú desplegable.
// «Ingresar» está siempre a la vista, en cualquier ancho: quien ya es cliente entra en un toque, sin
// abrir el menú. En escritorio va junto al botón principal; en teléfono y tableta, junto al menú.
// A mitad de una página, al subir, la cabecera vuelve fija arriba (y se va al bajar): se pone encima
// de la página, sin correr nada. La clara (páginas legales) queda pegada arriba siempre.
// Una entrada con `menu` («Agentes» y «El sistema») abre su desplegable con clic o Enter, y se
// cierra con Esc o afuera; solo uno abierto a la vez.
import { LOGO } from "../lib/logos"
import { WORDS } from "../lib/product"
import { ctaOf, loginUrl, mainNav, type NavEntry } from "../lib/site"
const cta = ctaOf(Astro.locals.pricing)

interface Props {
  variant?: "dark" | "light"
}
const { variant = "dark" } = Astro.props
const path = Astro.url.pathname.replace(/\/$/, "") || "/"
const current = (href: string) => path === href || path.startsWith(`${href}/`)
// En la página a la que lleva el botón principal (pedir la invitación) el botón sobra: ya está ahí.
const showCta = !current(cta.href)
/** Un desplegable está en curso si lo está su página que reúne todo o cualquiera de sus filas. */
const inMenu = (l: NavEntry) => Boolean(l.menu && ((l.menu.all && current(l.menu.all.href)) || l.menu.items.some((i) => current(i.href))))
const logo = LOGO[variant]
---
<header class:list={["site-head", variant]}>
  <div class="wrap row">
    <a href="/" class="logo" aria-label={`${WORDS.name}, inicio`} set:html={logo} />
    <nav class="nav" aria-label="Principal">
      {mainNav.map((l) =>
        l.menu ? (
          <details class="dd" data-dd>
            <summary class:list={["navlink", { cur: inMenu(l) }]}>
              {l.label}
              <svg width="12" height="12" viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M2.5 4.5 6 8l3.5-3.5" /></svg>
            </summary>
            <div class:list={["panel", { two: l.menu.columns === 2 }]}>
              <div class="items">
                {l.menu.items.map((a) => (
                  <a href={a.href} class:list={["ag", { plain: !a.color }]} aria-current={current(a.href) ? "page" : undefined}>
                    {a.color ? <i style={`background: ${a.color}`} aria-hidden="true" /> : null}
                    <span><b>{a.label}</b><span>{a.text}</span></span>
                    {a.color ? <span aria-hidden="true" style={`color: ${a.color}`}>→</span> : null}
                  </a>
                ))}
              </div>
              {l.menu.all ? (
                <a href={l.menu.all.href} class="all" aria-current={path === l.menu.all.href ? "page" : undefined}><span>{l.menu.all.label}</span><span aria-hidden="true">→</span></a>
              ) : null}
            </div>
          </details>
        ) : (
          <a href={l.href} class:list={["navlink", { cur: current(l.href) }]} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a>
        ),
      )}
    </nav>
    <div class="acts">
      <a class="login" href={loginUrl}><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="7" r="3.2" /><path d="M3.8 16.5c.8-3 3.2-4.6 6.2-4.6s5.4 1.6 6.2 4.6" /></svg>Ingresar</a>
      {showCta ? <a class="btn btn-p btn-sm" href={cta.href}>{cta.label}</a> : null}
    </div>
    <a class="login login-m" href={loginUrl}><svg width="16" height="16" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="10" cy="7" r="3.2" /><path d="M3.8 16.5c.8-3 3.2-4.6 6.2-4.6s5.4 1.6 6.2 4.6" /></svg>Ingresar</a>
    <details class="menu" data-dd>
      <summary aria-label="Abrir menú"><svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M3 6h14M3 10h14M3 14h14" /></svg></summary>
      <div class="sheet">
        {/* También es lo primero del menú: quien lo abre buscando su cuenta la encuentra arriba. */}
        <a class="enter" href={loginUrl}>Ingresar a tu cuenta <span aria-hidden="true">→</span></a>
        {mainNav.map((l) =>
          l.menu ? (
            <>
              <span class="st">{l.label}</span>
              {l.menu.items.map((a) => (
                <a href={a.href} class="sa" aria-current={current(a.href) ? "page" : undefined}>{a.color ? <i style={`background: ${a.color}`} aria-hidden="true" /> : null}{a.label}</a>
              ))}
              {l.menu.all ? <a href={l.menu.all.href} class="sub" aria-current={path === l.menu.all.href ? "page" : undefined}>{l.menu.all.short}</a> : null}
            </>
          ) : (
            <a href={l.href} aria-current={current(l.href) ? "page" : undefined}>{l.label}</a>
          ),
        )}
        {showCta ? <a class="btn btn-d" href={cta.href}>{cta.label}</a> : null}
      </div>
    </details>
  </div>
</header>

<script>
  // Al subir a mitad de la página, la cabecera oscura vuelve fija arriba; al bajar se esconde. Fuera del
  // flujo desde siempre, fijarla no mueve nada; vuelve a su lugar al llegar arriba del todo.
  const head = document.querySelector<HTMLElement>(".site-head.dark")
  if (head) {
    let lastY = window.scrollY
    let queued = false
    const update = () => {
      queued = false
      const y = window.scrollY
      if (y <= 2) head.classList.remove("pinned", "shown")
      else if (y > head.offsetHeight + 240) head.classList.add("pinned")
      if (head.classList.contains("pinned")) {
        if (y < lastY - 6) head.classList.add("shown")
        else if (y > lastY + 6 && !head.contains(document.activeElement)) {
          head.classList.remove("shown")
          for (const dd of head.querySelectorAll<HTMLDetailsElement>("details[open]")) dd.open = false
        }
      }
      lastY = y
    }
    window.addEventListener(
      "scroll",
      () => {
        if (queued) return
        queued = true
        requestAnimationFrame(update)
      },
      { passive: true },
    )
    // Con el teclado, la cabecera aparece al recibir el foco.
    head.addEventListener("focusin", () => {
      if (head.classList.contains("pinned")) head.classList.add("shown")
    })
  }

  // Cada desplegable se cierra con Esc (vuelve el foco a su botón), al hacer clic afuera y al abrir otro.
  const menus = [...document.querySelectorAll<HTMLDetailsElement>("[data-dd]")]
  for (const dd of menus) {
    dd.addEventListener("toggle", () => {
      if (dd.open) for (const other of menus) if (other !== dd) other.open = false
    })
    dd.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && dd.open) {
        dd.open = false
        dd.querySelector("summary")?.focus()
      }
    })
    document.addEventListener("click", (event) => {
      if (dd.open && !dd.contains(event.target as Node)) dd.open = false
    })
    // Con el teclado, al salir del desplegable se cierra: así no queda abierto tapando lo que sigue.
    dd.addEventListener("focusout", (event) => {
      if (dd.open && !dd.contains(event.relatedTarget as Node | null)) dd.open = false
    })
  }
</script>

<style>
  /* Con nombre propio en la transición entre páginas, la cabecera no se funde con el resto. */
  .site-head { position: absolute; top: 0; left: 0; right: 0; z-index: 10; view-transition-name: site-head; }
  .site-head.light { position: sticky; top: 0; background: var(--paper); border-bottom: 1px solid var(--line); }
  /* Fija al subir: escondida arriba hasta que se sube, y entra deslizándose sobre la página. */
  .site-head.pinned { position: fixed; background: color-mix(in srgb, var(--night) 94%, transparent); backdrop-filter: blur(10px); box-shadow: 0 10px 30px -18px rgba(0, 0, 0, .6); transform: translateY(-110%); transition: transform .25s ease; }
  .site-head.pinned.shown { transform: none; }
  .site-head.pinned .row { padding-top: 10px; padding-bottom: 10px; }
  @media (prefers-reduced-motion: reduce) { .site-head.pinned { transition: none; } }
  .row { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding-top: 22px; padding-bottom: 22px; }
  /* El logo se toca en 44 px de alto aunque se vea más chico. */
  .logo { display: flex; align-items: center; width: 150px; min-height: 44px; }
  .logo :global(svg) { width: 150px; height: auto; }
  .nav { display: flex; gap: 28px; }
  .acts { display: flex; align-items: center; gap: 12px; }
  .navlink { color: #cfe7ec; text-decoration: none; font-weight: 600; font-size: 15px; padding: 10px 4px; }
  .navlink:hover { color: #fff; }
  .navlink.cur { color: #fff; box-shadow: inset 0 -2px 0 var(--sky); }
  .light .navlink { color: var(--ink-2); }
  .light .navlink:hover, .light .navlink.cur { color: var(--teal); }
  /* «Ingresar»: un contorno que se distingue del menú sin competir con el botón principal. */
  .login { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 16px; border-radius: 999px; color: #e7f5f8; text-decoration: none; font-weight: 700; font-size: 15px; white-space: nowrap; box-shadow: inset 0 0 0 1.5px rgba(231, 245, 248, .38); transition: box-shadow .2s ease, color .2s ease; }
  .login:hover { color: #fff; box-shadow: inset 0 0 0 1.5px rgba(231, 245, 248, .9); }
  .light .login { color: var(--ink); box-shadow: inset 0 0 0 1.5px #cbd5e1; }
  .light .login:hover { color: var(--teal); box-shadow: inset 0 0 0 1.5px var(--teal); }
  .login-m { display: none; }
  .menu { display: none; position: relative; }
  .menu summary { list-style: none; width: 44px; height: 44px; border-radius: 12px; display: flex; align-items: center; justify-content: center; cursor: pointer; background: rgba(255,255,255,.08); color: #e7f5f8; }
  .light .menu summary { background: #eef4f7; color: var(--ink); }
  .menu summary::-webkit-details-marker { display: none; }
  .sheet { position: absolute; right: 0; top: 52px; width: min(320px, calc(100vw - 32px)); padding: 12px; border-radius: 18px; background: var(--paper); box-shadow: 0 20px 50px -20px rgba(0,0,0,.45); display: flex; flex-direction: column; gap: 2px; }
  .sheet a:not(.btn) { color: var(--ink); text-decoration: none; font-weight: 700; padding: 12px; border-radius: 10px; }
  .sheet a:not(.btn):hover, .sheet a[aria-current] { background: #eef4f7; }
  .sheet .btn { margin-top: 8px; }
  .sheet a.enter { display: flex; justify-content: space-between; color: var(--teal); background: var(--teal-soft); margin-bottom: 4px; }
  .st { padding: 12px 12px 4px; font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--soft); }
  .sheet a.sa { display: flex; align-items: center; gap: 10px; }
  .sa i, .ag i { width: 10px; height: 10px; border-radius: 50%; flex: none; }
  .sheet a.sub { padding-left: 32px; font-weight: 600; color: var(--teal); }
  .dd { position: relative; }
  .dd summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 6px; }
  .dd summary::-webkit-details-marker { display: none; }
  .dd summary svg { transition: transform .2s; }
  .dd[open] summary svg { transform: rotate(180deg); }
  .panel { position: absolute; left: 50%; top: calc(100% + 14px); transform: translateX(-50%); width: 560px; padding: 12px; border-radius: 20px; background: var(--paper); box-shadow: 0 30px 70px -30px rgba(0,0,0,.6); display: flex; flex-direction: column; gap: 2px; }
  .panel.two { width: 640px; }
  .items { display: flex; flex-direction: column; gap: 2px; }
  .two .items { display: grid; grid-template-columns: 1fr 1fr; }
  .ag.plain { grid-template-columns: 1fr; }
  .ag { display: grid; grid-template-columns: 12px 1fr auto; gap: 14px; align-items: center; padding: 14px 16px; border-radius: 14px; color: var(--ink); text-decoration: none; }
  .ag > span:not([aria-hidden]) { display: flex; flex-direction: column; gap: 2px; }
  .ag b { font-size: 16px; }
  .ag > span:not([aria-hidden]) > span { font-size: 14px; line-height: 1.45; color: var(--muted); }
  .ag:hover, .ag[aria-current] { background: var(--teal-soft); }
  .all { display: flex; justify-content: space-between; margin-top: 6px; padding: 12px 16px; border-top: 1px solid var(--line); color: var(--teal); text-decoration: none; font-weight: 700; font-size: 15px; }
  .all:hover { color: var(--teal-hover); }
  @media (max-width: 960px) {
    .nav, .acts { display: none; }
    .menu { display: block; }
    .login-m { display: inline-flex; margin-left: auto; padding: 0 14px; font-size: 14.5px; }
    .row { padding-top: 14px; padding-bottom: 14px; gap: 10px; }
    .logo, .logo :global(svg) { width: 120px; }
  }
</style>
