---
// La escena de la portada de /comparar y de cada /comparar/<alternativa>: las mismas tareas de un día
// con la alternativa (a la izquierda, cómo quedan con ella) y en el ARM (los agentes las van marcando
// como hechas, con su nombre y la hora). Cada alternativa cuenta lo suyo y con justicia: el chatbot sí
// responde, pero no agenda ni sigue; el software espera a que alguien lo use; el cuaderno depende de que
// alguien se acuerde. Solo tareas que los agentes de cada producto hacen hoy (ver lib/arm.ts). Es CSS:
// con menos movimiento, todo aparece hecho desde el principio.
import type { AltKey } from "../../lib/arm"
import { ofProduct, WORDS } from "../../lib/product"

interface Props {
  /** La alternativa de la tarjeta de la izquierda; en /comparar, el CRM. */
  alt?: AltKey
}
const { alt = "crm" } = Astro.props

/** Qué clase de tarea es, para decir cómo queda con cada alternativa. */
type Kind = "reply" | "book" | "note" | "followup" | "remind"
/** Cómo queda cada tarea con la alternativa; `half` marca lo que sí hace, a medias. */
const THEM: Record<AltKey, { name: string; status: Record<Kind, string>; half?: Kind[] }> = {
  crm: {
    name: "Tu CRM",
    status: {
      reply: "Esperando a alguien",
      book: "Esperando a alguien",
      note: "Esperando a alguien",
      followup: "Esperando a alguien",
      remind: "Esperando a alguien",
    },
  },
  chatbot: {
    name: "Tu chatbot",
    status: {
      reply: "Respondió y lo dejó ahí",
      book: "Se lo pasó a alguien",
      note: "No entra a la consulta",
      followup: "Se olvidó al cerrar el chat",
      remind: "Se olvidó al cerrar el chat",
    },
    half: ["reply"],
  },
  software: {
    name: "Tu software",
    status: {
      reply: "En un celular, fuera del sistema",
      book: "Alguien tiene que anotarla",
      note: "La escribes al final del día",
      followup: "Un reporte que nadie leyó",
      remind: "Alguien tiene que llamar",
    },
  },
  manual: {
    name: "Tu cuaderno",
    status: {
      reply: "Lo verán mañana",
      book: "En el cuaderno, si alguien se acuerda",
      note: "En papel",
      followup: "Se pierde",
      remind: "Si alguien se acuerda",
    },
  },
}
const them = THEM[alt]

type Agent = "sofi" | "clio" | "argos"
interface Task {
  todo: string
  kind: Kind
  agent: Agent
  done: string
}
const NAMES: Record<Agent, string> = { sofi: "Sofi", clio: "Clío", argos: "Argos" }

const tasks: Task[] = ofProduct<Task[]>({
  dental: [
    { todo: "Responder a Rosa por WhatsApp", kind: "reply", agent: "sofi", done: "Le respondió · 23:40" },
    { todo: "Agendar su limpieza", kind: "book", agent: "sofi", done: "Agendó con su sí · 23:42" },
    { todo: "Pasar la nota de la consulta", kind: "note", agent: "clio", done: "Preparó la nota · falta tu sí" },
    { todo: "Retomar su presupuesto", kind: "followup", agent: "argos", done: "Lo retomó · 10:00" },
  ],
  medical: [
    { todo: "Responder a Rosa por WhatsApp", kind: "reply", agent: "sofi", done: "Le respondió · 23:40" },
    { todo: "Agendar su consulta", kind: "book", agent: "sofi", done: "Agendó con su sí · 23:42" },
    { todo: "Pasar la nota de la consulta", kind: "note", agent: "clio", done: "Ordenó tu dictado · falta tu sí" },
    { todo: "Recuperar a quien faltó", kind: "followup", agent: "argos", done: "Le ofreció otro horario · 10:00" },
  ],
  optical: [
    { todo: "Responder a Rosa por WhatsApp", kind: "reply", agent: "sofi", done: "Le respondió · 23:40" },
    { todo: "Agendar su examen de la vista", kind: "book", agent: "sofi", done: "Agendó con su sí · 23:42" },
    { todo: "Recordarle su cita", kind: "remind", agent: "argos", done: "Se la recordó un día antes" },
    { todo: "Invitarla a su control", kind: "followup", agent: "argos", done: "La invitó · 10:00" },
  ],
})
---
<div class="av" role="img" aria-label={`Las mismas tareas: con ${them.name.toLowerCase()} quedan a medias o para tu equipo; en ${WORDS.name}, los agentes las hacen`}>
  <div class="av-card av-crm" aria-hidden="true">
    <div class="av-h">
      <strong>{them.name}</strong>
      <span class="av-count">{tasks.filter((t) => !them.half?.includes(t.kind)).length} pendientes</span>
    </div>
    <ul>
      {tasks.map((t) => (
        <li class:list={{ half: them.half?.includes(t.kind) }}>
          <span class="box">{them.half?.includes(t.kind) && <svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg>}</span>
          <span class="txt">{t.todo}</span>
          <span class="who">{them.status[t.kind]}</span>
        </li>
      ))}
    </ul>
  </div>
  <div class="av-card av-arm" aria-hidden="true">
    <div class="av-h">
      <strong>{WORDS.name} <span class="av-tag">ARM</span></strong>
      <span class="av-count av-live"><span class="dot"></span>Trabajando</span>
    </div>
    <ul>
      {tasks.map((t, i) => (
        <li class={t.agent} style={`--i:${i}`}>
          <span class="box"><svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"></path></svg></span>
          <span class="txt">{t.todo}</span>
          <span class="who"><b>{NAMES[t.agent]}</b> · {t.done}</span>
        </li>
      ))}
    </ul>
  </div>
</div>

<style>
  .av { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: 16px; align-items: center; }
  .av-card { border-radius: 20px; padding: 20px; display: flex; flex-direction: column; gap: 14px; }
  .av-crm { background: rgba(255, 255, 255, .04); border: 1px dashed rgba(255, 255, 255, .16); color: var(--on-night-3); }
  .av-arm {
    background: rgba(255, 255, 255, .07);
    border: 1px solid color-mix(in srgb, var(--sky) 55%, transparent);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--sky) 10%, transparent), 0 30px 60px -30px rgba(0, 0, 0, .6);
    color: var(--on-night);
  }
  .av-h { display: flex; justify-content: space-between; align-items: center; gap: 8px; font-size: 15px; }
  .av-tag { margin-left: 6px; font: 700 11px/1 var(--agent-font); letter-spacing: .08em; padding: 4px 7px; border-radius: 999px; background: var(--sky); color: var(--night); vertical-align: 2px; }
  .av-count { font: 12px/1 var(--agent-font); color: var(--on-night-3); white-space: nowrap; }
  .av-live { display: inline-flex; align-items: center; gap: 6px; color: var(--sky-2); }
  .dot { width: 7px; height: 7px; border-radius: 50%; background: var(--sky); animation: av-pulse 1.6s ease-in-out infinite; }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 10px; }
  li { display: grid; grid-template-columns: 20px minmax(0, 1fr); column-gap: 10px; row-gap: 2px; align-items: start; }
  .txt { font-size: 14px; line-height: 1.35; }
  .who { grid-column: 2; font: 11.5px/1.35 var(--agent-font); }
  .box { width: 18px; height: 18px; margin-top: 1px; border-radius: 6px; border: 1.5px solid rgba(255, 255, 255, .22); display: grid; place-items: center; }
  .av-crm .who { color: rgba(255, 255, 255, .35); }
  .av-crm .txt { color: var(--on-night-3); }
  /* Lo que la alternativa sí hace, a medias: la marca apagada. */
  .av-crm li.half .box { border-color: rgba(255, 255, 255, .35); }
  .av-crm li.half svg { width: 12px; height: 12px; fill: none; stroke: rgba(255, 255, 255, .55); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  .av-arm li { --c: #4fc3d7; }
  .av-arm li.clio { --c: #6ee7b7; }
  .av-arm li.argos { --c: #f5c46b; }
  .av-arm .who { color: var(--on-night-2); }
  .av-arm .who b { color: var(--c); }
  .av-arm .box { border-color: var(--c); background: var(--c); }
  .av-arm svg { width: 12px; height: 12px; fill: none; stroke: var(--night); stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }

  /* Cada tarea se marca una tras otra y el ciclo vuelve a empezar. */
  @media (prefers-reduced-motion: no-preference) {
    .av-arm li { animation: av-row 9s ease-in-out infinite; animation-delay: calc(var(--i) * 1.1s); }
    .av-arm li .box { animation: av-check 9s ease-in-out infinite; animation-delay: calc(var(--i) * 1.1s); }
  }
  @keyframes av-row {
    0%, 4% { opacity: .35; }
    10%, 88% { opacity: 1; }
    96%, 100% { opacity: .35; }
  }
  @keyframes av-check {
    0%, 6% { background: transparent; transform: scale(.85); }
    11% { transform: scale(1.15); }
    14%, 88% { background: var(--c); transform: none; }
    96%, 100% { background: transparent; }
  }
  @keyframes av-pulse { 50% { opacity: .3; } }

  @media (max-width: 640px) {
    .av { grid-template-columns: minmax(0, 1fr); }
    .av-crm li:nth-child(n + 3) { display: none; }
  }
</style>
