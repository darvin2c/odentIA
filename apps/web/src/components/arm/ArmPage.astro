---
// /comparar, la misma en las tres webs: el producto frente a un CRM, un chatbot, el software de siempre
// y WhatsApp con cuaderno. Primero la tabla general (quién hace qué) y después cada alternativa fila por
// fila, en pestañas (sin JavaScript se ven todas). Los textos salen de lib/arm.ts, como «¿Qué es un ARM?»
// de las portadas.
import Base from "../../layouts/Base.astro"
import { ALT_PAGES, ALTERNATIVES, AREAS, ARM_PATH, armFaq, type Mark, MATRIX } from "../../lib/arm"
import { breadcrumbJsonLd, type FaqItem, faqJsonLd } from "../../lib/faq"
import { ofProduct, WORDS } from "../../lib/product"
import CtaBand from "../CtaBand.astro"
import Faq from "../Faq.astro"
import PageHero from "../PageHero.astro"
import ArmVisual from "./ArmVisual.astro"
import CompareTable from "./CompareTable.astro"

const title = `${WORDS.name} frente a un CRM, un chatbot y el software de siempre`
const description = `${WORDS.name} es un ARM (Agentic Relationship Management): agentes de IA que responden, agendan y traen de vuelta a tus ${WORDS.patients}. Compáralo con un CRM, un chatbot, el software de siempre y WhatsApp con cuaderno.`
const MARK: Record<Mark, string> = { si: "Sí", medias: "A medias", no: "No" }
const agents = ofProduct({ dental: "Sofi, Clío y Argos", medical: "Sofi, Clío y Argos", optical: "Sofi y Argos" })

const reasons = [
  {
    title: "Nació con agentes",
    text: `${agents} no son un chat pegado encima: hacen el cambio en tu agenda y tus seguimientos, y queda registrado quién lo hizo.`,
  },
  {
    title: ofProduct({ dental: "Una persona, una historia", medical: "Una persona, una historia", optical: "Una persona, una ficha" }),
    text: `WhatsApp, Instagram, Messenger, Telegram, el chat de tu web y el correo llegan a la misma ficha. Nada de fichas repetidas por canal.`,
  },
  {
    title: "Tú tienes el control",
    text: `Cada tarea se prende o se apaga con un toque. Lo que un agente no puede resolver, se lo deja a una persona de ${WORDS.yourClinic} y le dice por qué.`,
  },
]

const faq: FaqItem[] = [
  armFaq,
  {
    q: "¿Los agentes deciden por mí?",
    a: `No. Hacen lo que tú les permites, y lo clínico lo decide siempre el ${WORDS.clinician}. Lo que no pueden resolver se lo dejan a tu equipo, con el resumen de lo que pasó.`,
  },
  {
    q: "¿En qué se diferencia de un chatbot?",
    a: `Un chatbot responde y deja el resto para una persona. Los agentes de ${WORDS.name} hacen el cambio en tu sistema, y queda registrado quién lo hizo.`,
  },
]

const trail: [string, string][] = [
  ["Inicio", "/"],
  ["Compara", ARM_PATH],
]
const jsonLd = [breadcrumbJsonLd(Astro.site, trail), faqJsonLd(faq)]
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <PageHero
    tag="Agentic Relationship Management"
    title="No somos un CRM ni un chatbot."
    accent="Somos un ARM."
    lead={`Un CRM te pide trabajo, un chatbot solo conversa y el software de siempre espera a que alguien lo use. En ${WORDS.name}, agentes de IA hacen el trabajo en ${AREAS} de ${WORDS.yourClinic}, y tú decides qué agentes trabajan. Nacimos así.`}
    secondary={{ href: "#comparacion", label: "Compáranos" }}
  >
    <ArmVisual slot="visual" />
  </PageHero>

  <section class="section section-white" id="comparacion" aria-labelledby="arm-cmp">
    <div class="wrap arm">
      <div class="arm-head">
        <span class="tag">[ Frente a todo lo demás ]</span>
        <h2 class="h2" id="arm-cmp">Lo que tu {WORDS.clinic} necesita. <span class="arm-acc">{WORDS.name} hace todo esto.</span></h2>
        <p class="lead">Ponlo al lado de lo que usas hoy.</p>
      </div>
      <div class="mx-scroll">
        <table class="mx-t">
          <thead>
            <tr>
              <th scope="col"><span class="sr-only">Qué</span></th>
              <th scope="col" class="us">{WORDS.name}</th>
              {ALTERNATIVES.map((a) => <th scope="col"><a class="mx-link" href={ALT_PAGES[a.key].path}>{a.label}</a></th>)}
            </tr>
          </thead>
          <tbody>
            {MATRIX.map((r) => (
              <tr>
                <th scope="row">{r.task}</th>
                <td class="us" data-label={WORDS.name}><span class="mk si" role="img" aria-label="Sí"></span></td>
                {ALTERNATIVES.map((a) => (
                  <td data-label={a.label}>{r.marks[a.key] === "medias" ? <span class="mk medias">A medias</span> : <span class:list={["mk", r.marks[a.key]]} role="img" aria-label={MARK[r.marks[a.key]]}></span>}</td>
                ))}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="mx-note">Cada columna es lo habitual en esa clase de herramienta, sin nombrar a ninguna.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="arm-alt">
    <div class="wrap arm">
      <div class="arm-head">
        <span class="tag">[ Uno por uno ]</span>
        <h2 class="h2" id="arm-alt">¿Qué usas hoy? <span class="arm-acc">Mira lo que ganas.</span></h2>
      </div>
      <div class="alt-tabs" role="tablist" aria-label="Compara con" hidden data-alt-tabs>
        {ALTERNATIVES.map((a, i) => (
          <button type="button" role="tab" id={`tab-${a.key}`} aria-controls={`alt-${a.key}`} aria-selected={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1}>{a.label}</button>
        ))}
      </div>
      {ALTERNATIVES.map((a) => (
        <div class="alt-panel" role="tabpanel" id={`alt-${a.key}`} aria-labelledby={`tab-${a.key}`}>
          <p class="alt-pitch">{a.pitch}</p>
          <CompareTable alt={a} />
          <a class="alt-go" href={ALT_PAGES[a.key].path}>Ver {WORDS.name} vs {a.inline} <span aria-hidden="true">→</span></a>
        </div>
      ))}
    </div>
  </section>

  <section class="section" aria-labelledby="arm-why">
    <div class="wrap arm">
      <div class="arm-head">
        <span class="tag">[ Por qué {WORDS.name} es un ARM ]</span>
        <h2 class="h2" id="arm-why">No le agregamos IA a un CRM. <span class="arm-acc">Nacimos agénticos.</span></h2>
      </div>
      <div class="arm-why">
        {reasons.map((r) => (
          <div class="card arm-r">
            <h3 class="h3">{r.title}</h3>
            <p>{r.text}</p>
          </div>
        ))}
      </div>
      <a class="arm-more" href="/agentes">Conoce a tus agentes <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <Faq items={faq} />
  <CtaBand title={`Deja de perseguir. Que tus agentes trabajen por ${WORDS.yourClinic}.`} />
</Base>

<script>
  // Pestañas de «Uno por uno»: sin JavaScript se ven todas las comparaciones y la barra queda oculta.
  // Con flechas se pasa de una a otra; #chatbot (o #crm, #software, #manual) abre la suya.
  for (const list of document.querySelectorAll<HTMLElement>("[data-alt-tabs]")) {
    const tabs = [...list.querySelectorAll<HTMLButtonElement>('[role="tab"]')]
    const show = (tab: HTMLButtonElement, focus = false) => {
      for (const t of tabs) {
        const on = t === tab
        t.setAttribute("aria-selected", String(on))
        t.tabIndex = on ? 0 : -1
        const panel = document.getElementById(t.getAttribute("aria-controls") ?? "")
        if (panel) panel.hidden = !on
      }
      if (focus) tab.focus()
    }
    list.hidden = false
    const fromHash = tabs.find((t) => t.id === `tab-${location.hash.slice(1)}`)
    show(fromHash ?? tabs[0])
    for (const [i, tab] of tabs.entries()) {
      tab.addEventListener("click", () => show(tab))
      tab.addEventListener("keydown", (e) => {
        const step = e.key === "ArrowRight" ? 1 : e.key === "ArrowLeft" ? -1 : 0
        if (!step) return
        e.preventDefault()
        show(tabs[(i + step + tabs.length) % tabs.length], true)
      })
    }
  }
</script>

<style>
  /* En la portada, el título grande y cada frase en su línea: «No somos un CRM.» / «Somos un ARM.» */
  :global(.ph h1) { font-size: clamp(46px, 4.6vw, 64px); }
  :global(.ph h1 .acc) { display: block; }
  .arm { display: flex; flex-direction: column; gap: 40px; }
  .arm-head { display: flex; flex-direction: column; gap: 16px; max-width: 760px; }
  .arm-acc { color: var(--teal); }
  .arm > * { min-width: 0; }
  .mx-scroll { max-width: 100%; overflow-x: auto; -webkit-overflow-scrolling: touch; }
  .mx-t { width: 100%; min-width: 760px; border-collapse: separate; border-spacing: 0; font-size: 16px; line-height: 1.4; }
  .mx-t th, .mx-t td { padding: 16px 14px; border-bottom: 1px solid var(--line); text-align: center; vertical-align: middle; }
  .mx-t thead th { font-size: 14px; font-weight: 800; color: var(--muted); }
  .mx-t tbody th { text-align: left; font-weight: 700; color: var(--ink); width: 35%; }
  .mx-t thead th + th { width: 13%; }
  .mx-t .us { background: var(--teal-soft); }
  .mx-t thead .us { color: var(--teal); font-size: 17px; border-radius: 16px 16px 0 0; }
  .mx-t tbody tr:last-child .us { border-radius: 0 0 16px 16px; }
  .mk { display: inline-grid; place-items: center; }
  .mk.si { width: 28px; height: 28px; border-radius: 50%; background: var(--teal); }
  .mk.si::after { content: ""; width: 12px; height: 7px; border: solid #fff; border-width: 0 0 2.5px 2.5px; transform: translateY(-2px) rotate(-45deg); }
  .mk.no { width: 14px; height: 2px; background: var(--line); border-radius: 2px; }
  .mk.medias { font-size: 13px; font-weight: 600; color: var(--soft); white-space: nowrap; }
  .mx-note { font-size: 13px; color: var(--soft); }
  /* En el celular cada fila es una tarjeta: lo que la clínica necesita arriba y, debajo, una línea por
     herramienta con su marca, empezando por la nuestra. */
  @media (max-width: 720px) {
    .mx-t, .mx-t tbody, .mx-t tr, .mx-t th, .mx-t td { display: block; width: auto; min-width: 0; }
    .mx-t thead { display: none; }
    .mx-t tr { margin-bottom: 14px; border: 1px solid var(--line); border-radius: 16px; overflow: hidden; }
    .mx-t tbody th { width: auto; padding: 14px 16px 10px; border-bottom: 0; font-size: 16px; }
    .mx-t td { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 8px 16px; border-bottom: 0; font-size: 14px; }
    .mx-t td::before { content: attr(data-label); color: var(--muted); font-weight: 600; text-align: left; }
    .mx-t td.us { padding-block: 10px; }
    .mx-t td.us::before { color: var(--teal); font-weight: 800; }
    .mx-t tbody tr:last-child .us { border-radius: 0; }
    .mk.si { width: 24px; height: 24px; }
  }
  .alt-tabs { display: flex; flex-wrap: wrap; gap: 8px; }
  .alt-tabs[hidden] { display: none; }
  .alt-tabs button { font: 700 15px/1 var(--font); padding: 12px 18px; border-radius: 999px; border: 1px solid var(--line); background: var(--paper); color: var(--ink-2); cursor: pointer; }
  .alt-tabs button[aria-selected="true"] { background: var(--teal); border-color: var(--teal); color: #fff; }
  .alt-tabs button:focus-visible { outline: 3px solid color-mix(in srgb, var(--teal) 40%, transparent); outline-offset: 2px; }
  .alt-panel { display: flex; flex-direction: column; gap: 20px; }
  .alt-panel[hidden] { display: none; }
  .mx-link { color: inherit; text-decoration: none; }
  .mx-link:hover { color: var(--teal); text-decoration: underline; }
  .alt-go { align-self: flex-start; font-weight: 800; color: var(--teal); text-decoration: none; }
  .alt-go:hover { text-decoration: underline; }
  .alt-pitch { font-size: clamp(22px, 2.2vw, 30px); font-weight: 800; letter-spacing: -.02em; color: var(--ink); }
  .arm-why { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .arm-r { padding: 28px; display: flex; flex-direction: column; gap: 12px; }
  .arm-r p { color: var(--muted); line-height: 1.55; }
  .arm-more { font-weight: 800; color: var(--teal); text-decoration: none; }
  .arm-more:hover { text-decoration: underline; }
  @media (max-width: 860px) {
    .arm-why { grid-template-columns: minmax(0, 1fr); }
  }
</style>
