// Las webs de marketing en Cloudflare Workers (ADR 0136): la de odentIA y, con
// `CLOUDFLARE_ENV=latidia` o `CLOUDFLARE_ENV=vistia` al compilar, la de latidIA o la de vistIA. El build de Astro arma desde aquí el
// `dist/server/wrangler.json` que publica `wrangler deploy`. Sin `routes`: las rutas de cada dominio
// viven en el panel de Cloudflare (docs/deployment.md), porque wrangler no sabe ponerles Fail open y
// publicar sin `routes` no las toca.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "odentia-web",
  "compatibility_date": "2026-10-01",
  // `process.env` y lo que React usa de Node al armar la página en el servidor.
  "compatibility_flags": ["nodejs_compat"],
  // Solo en su dominio: en workers.dev no hay caché y cada visita gastaría CPU del plan.
  "workers_dev": false,
  "preview_urls": false,
  // Registros de cada visita (lo que antes daba el servidor): el plan gratuito guarda 3 días.
  "observability": { "enabled": true },
  "env": {
    "latidia": {
      "name": "latidia-web",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true }
    },
    "vistia": {
      "name": "vistia-web",
      "workers_dev": false,
      "preview_urls": false,
      "observability": { "enabled": true }
    }
  }
}
