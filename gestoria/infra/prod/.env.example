# gestorIA en producción: estas variables van en el entorno de su proyecto de OpenShip (o en
# `.env` en esta carpeta, para Compose). Mientras el proyecto no exista, gestorIA no corre.

# La base `gestoria` en el PostgreSQL de las clínicas (crear-base.sh), por la red de las clínicas.
GESTORIA_DATABASE_URL=postgres://gestoria:<contraseña>@postgres:5432/gestoria
GESTORIA_APP_DATABASE_URL=postgres://gestoria_app:<contraseña>@postgres:5432/gestoria

# La entrada a la cuenta en el dominio de gestorIA.
GESTORIA_ACCOUNT_URL=https://api.gestoria24.com
# El mismo que GESTORIA_ACCOUNT_EVENTS_SECRET en la API y el worker de las clínicas.
GESTORIA_ACCOUNT_EVENTS_SECRET=whsec_<32 bytes en base64>

GESTORIA_WEB_URL=https://app.gestoria24.com
GESTORIA_PORT=3201

# El link de pago (B4): la dirección pública de este servidor (adonde avisa Mercado Pago) y la
# llave con que se cifran las credenciales de cada tienda (openssl rand -base64 32). Sin ellas
# el link de pago no se puede conectar; lo demás funciona.
GESTORIA_API_URL=https://servidor.gestoria24.com
GESTORIA_SECRETS_KEY=<32 bytes en base64>

# El nombre de la red del proyecto de las clínicas en el servidor (para llegar a su PostgreSQL).
GESTORIA_CLINICS_NETWORK=odentia-prod_default
