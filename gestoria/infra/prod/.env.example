# gestorIA en producción: estas variables van en el entorno de su proyecto de OpenShip (o en
# `.env` en esta carpeta, para Compose). Mientras el proyecto no exista, gestorIA no corre.

# La base `gestoria` en el PostgreSQL compartido (crear-base.sh). El host es el nombre que el
# enlace de OpenShip le da al servicio `postgres` de las clínicas: `shared-<id del servicio>`.
GESTORIA_DATABASE_URL=postgres://gestoria:<contraseña>@shared-<id del servicio postgres>:5432/gestoria
GESTORIA_APP_DATABASE_URL=postgres://gestoria_app:<contraseña>@shared-<id del servicio postgres>:5432/gestoria

# La entrada a la cuenta en el dominio de gestorIA.
GESTORIA_ACCOUNT_URL=https://api.gestoria24.com
# El mismo que GESTORIA_ACCOUNT_EVENTS_SECRET en la API y el worker de las clínicas.
GESTORIA_ACCOUNT_EVENTS_SECRET=whsec_<32 bytes en base64>
# El acuerdo con la administración (B7): el mismo GESTORIA_CONTRACT_SECRET que la API de las
# clínicas (otro que el de los avisos). Vacío, no le avisa ni le pregunta nada: lo que pasa se
# guarda y sale al configurarlo, y la tienda y Sofi siguen trabajando.
GESTORIA_CONTRACT_SECRET=

GESTORIA_WEB_URL=https://app.gestoria24.com
GESTORIA_PORT=3201

# El link de pago (B4): la dirección pública de este servidor (adonde avisa Mercado Pago) y la
# llave con que se cifran las credenciales de cada tienda (openssl rand -base64 32). Sin ellas
# el link de pago no se puede conectar; lo demás funciona.
GESTORIA_API_URL=https://servidor.gestoria24.com
GESTORIA_SECRETS_KEY=<32 bytes en base64>
# Cobros: la aplicación de gestorIA en Mercado Pago (Tus integraciones), con la que cada tienda
# conecta su cuenta entrando a ella. Su dirección de regreso es <GESTORIA_WEB_URL>/mercadopago/vuelta
# y su aviso de «Vinculación de aplicaciones» (mp-connect) va a <GESTORIA_API_URL>/avisos/mercadopago.
# Contacto técnico de la aplicación: soporte@gestoria24.com. Vacías: no se ofrece conectar.
GESTORIA_MERCADOPAGO_CLIENT_ID=
GESTORIA_MERCADOPAGO_CLIENT_SECRET=


# Sofi (B5): la clave de OpenAI con que responde y mide. Sin ella, Sofi no responde (ni en la
# prueba); lo demás funciona. GESTORIA_LLM_MODEL vacío usa el modelo de las clínicas
# (gpt-6-luna); «fake» no arranca en producción.
GESTORIA_OPENAI_API_KEY=<clave de OpenAI>
GESTORIA_LLM_MODEL=

# Los avisos al celular (tablero 15): el par de claves VAPID de gestorIA, propio (no el de las
# clínicas), con `npx web-push generate-vapid-keys`. No se cambian una vez en uso: los celulares
# activados con otras claves dejan de recibir hasta que se activen otra vez. Vacías: los avisos
# al celular no se ofrecen y no se envía nada.
GESTORIA_VAPID_PUBLIC_KEY=<clave pública VAPID>
GESTORIA_VAPID_PRIVATE_KEY=<clave privada VAPID>
GESTORIA_VAPID_SUBJECT=mailto:<correo del equipo de gestorIA>
