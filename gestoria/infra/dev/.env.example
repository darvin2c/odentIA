# gestorIA en desarrollo: copia este archivo como `.env` en esta carpeta. Los nombres llevan
# GESTORIA_ para que nunca se cruce con la base o la cuenta de las clínicas.

# La base `gestoria` (crear-base.sh, o un PostgreSQL propio): el dueño y el rol de la aplicación.
GESTORIA_DATABASE_URL=postgres://gestoria:gestoria@localhost:5432/gestoria
GESTORIA_APP_DATABASE_URL=postgres://gestoria_app:gestoria_app@localhost:5432/gestoria

# La entrada a la cuenta en el dominio de gestorIA (la API de las clínicas con GESTORIA_DOMAIN).
GESTORIA_ACCOUNT_URL=http://api.gestoria.localhost:3001
# El mismo secreto que GESTORIA_ACCOUNT_EVENTS_SECRET en la API de las clínicas (whsec_ + 32 bytes en base64).
GESTORIA_ACCOUNT_EVENTS_SECRET=
# El acuerdo con la administración (B7): el mismo GESTORIA_CONTRACT_SECRET que la API de las
# clínicas. Vacío, «Plan y pagos» muestra lo de la tienda de ejemplo y nada se envía.
GESTORIA_CONTRACT_SECRET=

# La app (vite) y el puerto del servidor.
GESTORIA_WEB_URL=http://app.gestoria.localhost:5181
GESTORIA_PORT=3201

# El link de pago (B4): la dirección pública de este servidor y la llave de las credenciales
# (openssl rand -base64 32). Mercado Pago solo avisa a una dirección pública con https.
GESTORIA_API_URL=http://localhost:3201
GESTORIA_SECRETS_KEY=

# La tienda de ejemplo deja una invitación de Dueño para este correo (seed:dev).
GESTORIA_SEMILLA_CORREO=

# Sofi (B5): la clave de OpenAI de gestorIA (la misma cuenta del Grupo Sallca, nunca escrita en
# el repositorio). Sin ella Sofi no responde; con GESTORIA_LLM_MODEL=fake responde por reglas,
# sin red, para ver la pantalla en local.
GESTORIA_OPENAI_API_KEY=
GESTORIA_LLM_MODEL=fake

# Los avisos al celular (tablero 15): el par de claves VAPID de gestorIA, propio (no el de las
# clínicas), con `npx web-push generate-vapid-keys`, y a quién escribir si un servicio de push
# tiene un problema. Vacías: los avisos al celular no se ofrecen. El navegador los acepta en
# localhost; en otra dirección, solo con https.
GESTORIA_VAPID_PUBLIC_KEY=
GESTORIA_VAPID_PRIVATE_KEY=
GESTORIA_VAPID_SUBJECT=

# Las fotos y los videos del producto (ADR 0236): un bucket propio de gestorIA en el RustFS de
# desarrollo (`infra/dev/compose.yaml` de la raíz, puerto 9000). `seed:dev` lo crea si no está.
# Vacías: no se suben fotos ni videos.
GESTORIA_S3_ENDPOINT=http://127.0.0.1:9000
GESTORIA_S3_REGION=us-east-1
GESTORIA_S3_ACCESS_KEY=minioadmin
GESTORIA_S3_SECRET_KEY=minioadmin
GESTORIA_S3_BUCKET=gestoria-medios
