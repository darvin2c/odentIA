---
// El chat de WhatsApp como lo ve la clienta (web v4): hecho en código, con la conversación de la
// tienda de ejemplo (semilla de Calzados Rosa, Valeria Soto). La clienta escribe a la derecha, en
// verde; Sofi responde por la tienda a la izquierda. Sin script se ven todos los mensajes; con
// script (src/scripts/inicio.ts) entran uno por uno, con «escribiendo…» antes de cada respuesta.
// Sin número de teléfono ni de casa (regla de la web: calle y distrito, nada más).

import { MENSAJES } from "../../lib/venta"
---
<div class="wa" data-wa>
  <div class="wa__phone">
    <div class="wa__island" aria-hidden="true"></div>
    <div class="wa__status" aria-hidden="true"><span>9:45</span><span class="wa__status-icons"><i></i><i></i><i></i></span></div>
    <div class="wa__head">
      <span class="wa__back" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"></path></svg>
      </span>
      <span class="wa__avatar" aria-hidden="true">CR</span>
      <span class="wa__who"><b>Calzados Rosa</b><small data-wa-estado>en línea</small></span>
    </div>
    <ol class="wa__chat" aria-label="Conversación de ejemplo por WhatsApp entre Valeria y Sofi, de Calzados Rosa">
      <li class="wa__day" aria-hidden="true"><span>Hoy</span></li>
      {MENSAJES.map((m, i) => (
        <li class:list={["wa__msg", m.de === "clienta" ? "wa__msg--out" : "wa__msg--in"]} data-msg={i}>
          <span class="sr-only">{m.de === "clienta" ? "Valeria:" : "Sofi:"}</span>
          {m.texto}
          <span class="wa__meta" aria-hidden="true">{m.hora}{m.de === "clienta" && <svg class="wa__ticks" viewBox="0 0 18 12"><path d="M1 6.5l3 3 6-7"></path><path d="M7 9.5l1 1 6-8"></path></svg>}</span>
        </li>
      ))}
      <li class="wa__typing" data-wa-typing aria-hidden="true"><i></i><i></i><i></i></li>
    </ol>
    <div class="wa__input" aria-hidden="true">
      <span class="wa__field">Mensaje</span>
      <span class="wa__mic"><svg viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="12" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg></span>
    </div>
  </div>
  <ul class="wa__hizo" aria-label="Lo que hizo Sofi en la app mientras respondía">
    {MENSAJES.filter((m) => m.hizo).map((m) => (
      <li data-hizo={MENSAJES.indexOf(m)}><span class="wa__hizo-dot" aria-hidden="true"></span>{m.hizo}</li>
    ))}
  </ul>
  <button class="wa__pausa" type="button" data-wa-pausa aria-pressed="false" aria-label="Pausar la conversación">
    <svg class="wa__pausa-i" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3v10M11 3v10"></path></svg>
    <svg class="wa__play-i" viewBox="0 0 16 16" aria-hidden="true"><path d="M5 3l8 5-8 5z"></path></svg>
  </button>
</div>
