---
// La barra de abajo en el celular (dirección C del estudio): como la de una app, con las partes de la
// página, «Entrar» y el botón principal. Marca la parte que se está leyendo, para que en una página
// larga se sepa dónde se está y se salte a lo que importa con el pulgar. Es la `nav.actionbar` de
// tasteskill: system.js la muestra cuando el botón del hero ya pasó y la esconde mientras la
// pantalla ya muestra lo mismo. Solo bajo 640 px.
import { cta, hrefOf, LOGIN_URL, SITE_MAP } from "../lib/sitio"

const tabs = [
  { page: SITE_MAP.producto[0], label: "La venta", icon: "chat" },
  { page: SITE_MAP.empresa[0], label: "Precio", icon: "tag" },
]
  .map((t) => ({ ...t, href: hrefOf(t.page) }))
  .filter((t) => t.href)
---
<nav class="actionbar barra" aria-label="Accesos rápidos">
  {tabs.map((t) => (
    <a class="barra__tab" href={t.href} data-barra={t.href?.split("#")[1]}>
      {t.icon === "chat" ? (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 5.5h16v10H9l-5 4z"></path></svg>
      ) : (
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M3.5 12.5 12 4h7.5v7.5L11 20z"></path><circle cx="15.5" cy="8" r="1.4"></circle></svg>
      )}
      <span>{t.label}</span>
    </a>
  ))}
  <a class="barra__tab" href={LOGIN_URL}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8.5" r="3.5"></circle><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"></path></svg>
    <span>Entrar</span>
  </a>
  <a class="btn btn--primary" href={cta.href}>{cta.short}</a>
</nav>
<script is:inline>
  // La parte que se está leyendo: su pestaña queda marcada (aria-current), sin mover la página.
  ;(() => {
    const tabs = [...document.querySelectorAll(".barra__tab[data-barra]")]
    const parts = tabs.map((t) => document.getElementById(t.dataset.barra)).filter(Boolean)
    if (!parts.length || !("IntersectionObserver" in window)) return
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const tab = tabs.find((t) => t.dataset.barra === e.target.id)
          if (!tab) continue
          if (e.isIntersecting) tab.setAttribute("aria-current", "location")
          else tab.removeAttribute("aria-current")
        }
      },
      { rootMargin: "-45% 0px -45% 0px" },
    )
    for (const p of parts) io.observe(p)
  })()
</script>
