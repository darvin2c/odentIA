---
// Quién hace qué (web v5): el pedido pasa por sus estados, de la primera pregunta a entregado, en
// tres carriles. Sofi hace casi todo y va de estado en estado; tu equipo hace tres cosas chiquitas
// en el centro (confirmar una captura, empacar y entregar); Argos te dice lo que te toca. En
// computadora la escena se fija y el pedido avanza con el scroll (`proceso()` de scripts/agentes.ts);
// sin movimiento o en el celular, se lee entera.
import { Image } from "astro:assets"
import sofiAtenta from "../../assets/sofi-atenta.png"
import sofiDecidida from "../../assets/sofi-decidida.png"
import sofiFeliz from "../../assets/sofi-feliz.png"

type Estado = {
  estado: string
  sofi?: string
  tu?: string
  argos?: string
  cara?: "atenta" | "decidida" | "feliz"
}
const estados: Estado[] = [
  { estado: "Escribe la clienta", sofi: "Atiende al instante", cara: "atenta" },
  { estado: "Cotizado", sofi: "Muestra el valor y ofrece una vez", cara: "decidida" },
  { estado: "Pedido anotado", sofi: "Anota el pedido y pide el pago", cara: "atenta" },
  {
    estado: "Pago por confirmar",
    tu: "Confirmas la captura (el link se confirma solo)",
    argos: "Te toca: 1 pago por confirmar",
  },
  { estado: "Pagado", sofi: "Cobró, y el stock baja solo", cara: "feliz" },
  { estado: "Sale hoy", tu: "Empacas", argos: "Sale hoy, en Despachos" },
  { estado: "Entregado", tu: "Entregas", argos: "Queda en la ficha de la clienta" },
]
const caras = { atenta: sofiAtenta, decidida: sofiDecidida, feliz: sofiFeliz }
---
<section class="proceso" aria-labelledby="proceso-h" data-proceso>
  <div class="proceso__pin" data-proceso-pin>
    <div class="marco">
      <div class="cabeza">
        <p class="etiqueta">Quién hace qué</p>
        <h2 id="proceso-h" class="titulo-2">Sofi lleva el pedido. <span class="cur">Tú solo haces tres cositas.</span></h2>
      </div>
      <p class="proceso__pedido" aria-hidden="true">
        <span>Pedido 1042</span><b data-proceso-estado>{estados[0]?.estado}</b>
      </p>
      <div class="proceso__tabla" role="table" aria-label="Los estados del pedido y quién hace cada paso">
        <div class="proceso__fila proceso__fila--estados" role="row">
          <span class="proceso__carril" role="columnheader">Estado</span>
          {estados.map((e, i) => (
            <span class="proceso__estado" role="columnheader" data-col={i} data-cara={e.cara ?? ""} data-nombre={e.estado}>
              <i aria-hidden="true">{i + 1}</i>{e.estado}
            </span>
          ))}
        </div>
        <div class="proceso__fila proceso__fila--sofi" role="row">
          <span class="proceso__carril" role="rowheader">Sofi</span>
          {estados.map((e, i) => (
            <span class="proceso__celda" role="cell" data-col={i}>
              {e.sofi && <span class="tarea tarea--sofi">{e.sofi}</span>}
            </span>
          ))}
          <span class="proceso__sofi" data-proceso-sofi aria-hidden="true">
            {Object.entries(caras).map(([k, img]) => (
              <Image src={img} alt="" widths={[80, 160]} sizes="80px" data-cara={k} />
            ))}
          </span>
        </div>
        <div class="proceso__fila proceso__fila--tu" role="row">
          <span class="proceso__carril" role="rowheader">Tu equipo</span>
          {estados.map((e, i) => (
            <span class="proceso__celda" role="cell" data-col={i}>
              {e.tu && <span class="tarea tarea--tu">{e.tu}</span>}
            </span>
          ))}
        </div>
        <div class="proceso__fila proceso__fila--argos" role="row">
          <span class="proceso__carril" role="rowheader">Argos</span>
          {estados.map((e, i) => (
            <span class="proceso__celda" role="cell" data-col={i}>
              {e.argos && <span class="tarea tarea--argos">{e.argos}</span>}
            </span>
          ))}
        </div>
        <div class="proceso__avance" aria-hidden="true"><span data-proceso-avance></span></div>
      </div>
      <p class="proceso__cuenta">De 7 estados, a tu equipo le tocan <b>3 cositas</b>. El resto lo llevan Sofi y Argos.</p>
    </div>
  </div>
</section>
