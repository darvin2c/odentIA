---
// El logotipo de gestorIA, el mismo de la marca común (lo vigila src/lib/marca.test.tsx). Sus colores
// salen de `--identity-ink` y `--identity-accent` (Base.astro).
import logotipo from "../assets/logotipo.svg?raw"

interface Props {
  /** Una clase más para el enlace (el pie lleva la suya). */
  class?: string
}

const { class: className = "" } = Astro.props
// El enlace ya dice «gestorIA, inicio»: el dibujo no se lee dos veces.
const svg = logotipo
  .replace(/ role="[^"]*"/, "")
  .replace(/ aria-label="[^"]*"/, "")
  .replace("<svg ", '<svg aria-hidden="true" focusable="false" ')
---
<a class={`logo ${className}`.trim()} href="/" aria-label="gestorIA, inicio"><Fragment set:html={svg} /></a>
