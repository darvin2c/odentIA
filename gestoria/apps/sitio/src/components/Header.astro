---
// La cabecera: el logo, las secciones de la portada, «Entrar» y el botón principal. En el celular,
// «Entrar» y un menú que se abre sin JavaScript (lienzo B8, tablero 3).
import { cta, LOGIN_URL, mainNav } from "../lib/sitio"
import Logo from "./Logo.astro"

interface Props {
  /** Oscura sobre la portada; clara en las demás páginas. */
  variant: "dark" | "light"
}

const { variant } = Astro.props
---
<header class:list={[variant === "dark" ? "night" : "header-light"]}>
  <div class="wrap header">
    <Logo />
    <nav class="nav" aria-label="Principal">
      {mainNav.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
    <div class="actions">
      <a class="btn btn-ghost" href={LOGIN_URL}>Entrar</a>
      <a class="btn btn-primary" href={cta.href}>{cta.short}</a>
      <details class="menu">
        <summary aria-label="Menú">
          <svg class="open" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"></path></svg>
          <svg class="close" aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"></path></svg>
        </summary>
        <div class="menu-panel">
          <nav aria-label="Menú">
            {mainNav.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
          <a class="btn btn-big" href={cta.href}>{cta.label}</a>
        </div>
      </details>
      <script is:inline>
        // Al tocar una sección del menú, el menú se cierra: si no, queda abierto encima al volver arriba.
        for (const link of document.querySelectorAll(".menu-panel a"))
          link.addEventListener("click", () => link.closest("details")?.removeAttribute("open"))
      </script>
    </div>
  </div>
</header>
