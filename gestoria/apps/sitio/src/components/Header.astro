---
// La cabecera de todas las páginas (web v3, nav-mega de tasteskill): el logo, «Producto» con su menú,
// las demás palabras del mapa, «Entrar» (el ingreso real de la app) y el botón principal. En el
// celular, system.js la vuelve una hoja a pantalla completa.
import menuCard from "../assets/pantallas/menu-pedido.png"
import { Image } from "astro:assets"
import { cta, hrefOf, LOGIN_URL, mainNav, SITE_MAP } from "../lib/sitio"
import Logo from "./Logo.astro"

const [sofi, cobros, entregas, clientes] = SITE_MAP.producto
const columns = [
  { title: "En el chat", pages: [sofi] },
  { title: "En tu tienda", pages: [cobros, clientes] },
]
const [producto, ...rest] = mainNav
const entregasHref = hrefOf(entregas)
---
<header class="nav">
  <div class="wrap nav__bar">
    <a class="skip-link" href="#top">Ir al contenido</a>
    <Logo />
    <nav class="nav__links" aria-label="Principal">
      <div class="nav__item">
        <a class="nav__link" href={producto.href}>{producto.label} <svg class="chev" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        <div class="nav__menu">
          <div class="wrap grid">
            {columns.map((col) => (
              <div class="menu-col span-3">
                <p class="t-label">{col.title}</p>
                {col.pages.map((p) => {
                  const href = hrefOf(p)
                  return href && <a href={href}>{p.label}<span>{p.hint}</span></a>
                })}
              </div>
            ))}
            {entregasHref && (
              <a class="menu-card span-3 start-10" href={entregasHref}>
                <div class="panel"><Image class="frame__img" src={menuCard} alt="Un pedido de Calzados Rosa en gestorIA con su pago confirmado" widths={[300, 600]} sizes="300px" /></div>
                <span class="t-card">{entregas.label}</span>
                <span class="t-small muted">{entregas.hint}</span>
              </a>
            )}
          </div>
        </div>
      </div>
      {rest.map((link) => <div class="nav__item"><a class="nav__link" href={link.href}>{link.label}</a></div>)}
    </nav>
    <div class="nav__actions">
      <a class="nav__link" href={LOGIN_URL}>Entrar</a>
      <a class="btn btn--primary" href={cta.href}>{cta.short}</a>
    </div>
    <button class="nav__toggle" type="button" aria-expanded="false" aria-label="Menú">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path d="M2 5h14M2 13h14" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"></path></svg>
    </button>
  </div>
</header>
