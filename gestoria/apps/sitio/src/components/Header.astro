---
// La cabecera de todas las páginas (web v5): transparente sobre el héroe y blanca con desenfoque
// al bajar (lo pidió el dueño). Sobre un héroe oscuro empieza con letras blancas (`tono="oscuro"`).
// «Producto» abre su menú; «Entrar» lleva al ingreso real de la app. En el celular, el menú es una
// hoja a pantalla completa.
import { cta, hrefOf, LOGIN_URL, mainNav, SITE_MAP } from "../lib/sitio"
import Logo from "./Logo.astro"

interface Props {
  tono?: "oscuro" | "claro"
}
const { tono = "claro" } = Astro.props

const iconos: Record<string, string> = {
  Sofi: '<path d="M4 5.5h16v10H9l-5 4z"/><circle cx="9.5" cy="10.5" r="1"/><circle cx="14.5" cy="10.5" r="1"/>',
  Cobros: '<rect x="3" y="6" width="18" height="12" rx="2.5"/><path d="M3 10h18M7 14.5h3"/>',
  Entregas:
    '<path d="M3 7.5h11v8H3zM14 10.5h4l3 3v2h-7"/><circle cx="7" cy="17" r="1.6"/><circle cx="17" cy="17" r="1.6"/>',
  Clientes:
    '<circle cx="12" cy="8.5" r="3.5"/><path d="M5 20c.8-3.6 3.6-5.5 7-5.5s6.2 1.9 7 5.5"/>',
  Catálogo:
    '<rect x="4" y="4" width="7" height="7" rx="1.5"/><rect x="13" y="4" width="7" height="7" rx="1.5"/><rect x="4" y="13" width="7" height="7" rx="1.5"/><rect x="13" y="13" width="7" height="7" rx="1.5"/>',
  Inventario: '<path d="M4 8l8-4 8 4v8l-8 4-8-4z"/><path d="M4 8l8 4 8-4M12 12v8"/>',
  Argos:
    '<circle cx="12" cy="12" r="8"/><circle cx="12" cy="12" r="3"/><path d="M12 4v3M20 12h-3"/>',
}
const producto = SITE_MAP.producto
  .map((p) => ({ ...p, href: hrefOf(p) }))
  .filter((p): p is typeof p & { href: string } => p.href !== null)
const [, ...resto] = mainNav
const grupos = [
  { titulo: "Producto", enlaces: producto.map((p) => ({ href: p.href, label: p.label })) },
  { titulo: "Más", enlaces: resto },
]
const flecha =
  '<svg viewBox="0 0 12 12" aria-hidden="true"><path d="M1.5 6h8M6.5 2.5 10 6l-3.5 3.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>'
---
<a class="saltar" href="#contenido">Ir al contenido</a>
<header class="cabecera" data-tono={tono} data-cabecera>
  <div class="marco cabecera__barra">
    <Logo />
    <nav class="cabecera__nav" aria-label="Principal">
      <div class="cabecera__item">
        <a class="cabecera__enlace" href="/#venta" aria-haspopup="true">Producto <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"></path></svg></a>
        <div class="cabecera__menu">
          {producto.map((p) => (
            <a href={p.href}>
              <span class="cabecera__icono"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={iconos[p.label] ?? ""}></svg></span>
              <b>{p.label}</b>
              <small>{p.hint}</small>
            </a>
          ))}
        </div>
      </div>
      {resto.map((link) => <a class="cabecera__enlace" href={link.href}>{link.label}</a>)}
    </nav>
    <div class="cabecera__acciones">
      <a class="cabecera__enlace cabecera__entrar" href={LOGIN_URL}>Entrar</a>
      <a class="boton boton--chico" href={cta.href}>{cta.short}<Fragment set:html={flecha} /></a>
      <button class="cabecera__abrir" type="button" aria-expanded="false" aria-controls="hoja-menu" data-abrir-menu>
        <span class="sr">Abrir el menú</span>
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 7h14M3 13h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
      </button>
    </div>
  </div>
</header>
<div class="hoja" id="hoja-menu" role="dialog" aria-modal="true" aria-label="Menú" data-hoja hidden>
  <div class="hoja__barra">
    <Logo />
    <button class="cabecera__abrir" style="display:grid" type="button" data-cerrar-menu>
      <span class="sr">Cerrar el menú</span>
      <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M5 5l10 10M15 5 5 15" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"></path></svg>
    </button>
  </div>
  {grupos.map((g) => (
    <nav class="hoja__grupo" aria-label={g.titulo}>
      <h2>{g.titulo}</h2>
      <ul>{g.enlaces.map((l) => <li><a href={l.href} data-cerrar-menu>{l.label}</a></li>)}</ul>
    </nav>
  ))}
  <div class="hoja__acciones">
    <a class="boton" href={cta.href}>{cta.label}<Fragment set:html={flecha} /></a>
    <a class="boton boton--fantasma" href={LOGIN_URL}>Entrar a mi tienda</a>
  </div>
</div>
