---
// El documento de cada página (web v5): título y descripción propios, la imagen al compartir el
// enlace (WhatsApp la muestra), la cabecera, el contenido y el pie con su cierre. El sistema visual
// es propio (src/styles/base.css): Geist, tinta cálida y el naranja de la marca (#CC4604).
import "@fontsource-variable/geist"
import "@fontsource-variable/geist-mono"
import "@fontsource/instrument-serif/latin-400-italic.css"
import Footer from "../components/Footer.astro"
import Header from "../components/Header.astro"
import { SITE_URL } from "../lib/sitio"
import "../styles/base.css"
import "../styles/paginas.css"

interface Props {
  title: string
  description: string
  noindex?: boolean
  /** Datos estructurados propios de la página (schema.org), además del sitio. */
  ld?: Record<string, unknown>[]
  /** El tono del héroe de la página: con uno oscuro, la cabecera empieza con letras blancas. */
  tono?: "oscuro" | "claro"
  /**
   * La página carga a Sofi ella misma (inicio.ts o agentes.ts). Va en el HTML para que sitio.ts no
   * la cargue otra vez: dos lienzos se ven como dos burbujas, una sobre otra.
   */
  sofiPropia?: boolean
}

const {
  title,
  description,
  noindex = false,
  ld = [],
  tono = "claro",
  sofiPropia = false,
} = Astro.props
// Al armar, la ruta es el archivo (/terminos.html); la dirección pública va sin .html.
const path = Astro.url.pathname.replace(/(\/index)?\.html$/, "") || "/"
const canonical = new URL(path, SITE_URL).toString()
const fullTitle = title.includes("gestorIA") ? title : `${title} · gestorIA`
const ogImage = new URL("/og.png", SITE_URL).toString()
const isHome = path === "/"
// La 404 se sirve en cualquier dirección que no existe: no dice ser ninguna.
const isNotFound = path === "/404"
const site = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "gestorIA",
  alternateName: ["gestoria24", "Gestoria"],
  url: `${SITE_URL}/`,
  inLanguage: "es",
  publisher: { "@type": "Organization", name: "gestorIA", url: `${SITE_URL}/` },
}
const data = isHome ? [site, ...ld] : ld
---
<!doctype html>
<html lang="es" data-sofi-propia={sofiPropia ? "" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {!isNotFound && <link rel="canonical" href={canonical} />}
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_419" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    {!isNotFound && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content="gestorIA" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="gestorIA: Sofi vende por chat para tu tienda." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content={tono === "oscuro" ? "#111113" : "#ffffff"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {/* `js`: hay JavaScript (el chat del héroe se puede tocar). `mueve`: además, sin «reducir movimiento», lo que entra al bajar empieza escondido. */}
    <script is:inline>
      document.documentElement.classList.add("js")
      if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("mueve")
    </script>
    {data.map((item) => <script type="application/ld+json" set:html={JSON.stringify(item)} />)}
  </head>
  <body>
    <Header tono={tono} />
    <main id="contenido">
      <slot />
    </main>
    <Footer />
    <script>
      import { iniciarSitio } from "../scripts/sitio"
      iniciarSitio()
    </script>
  </body>
</html>
