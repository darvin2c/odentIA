---
// El Inicio de gestorIA (web v4): una venta de Sofi de punta a punta, con el nivel de movimiento de
// minitap.ai y sus técnicas adaptadas, nunca su código ni su marca.
// - Héroe oscuro con el chat de WhatsApp como lo ve la clienta, en código, mensaje por mensaje.
// - La venta en una escena fija que avanza con el scroll (GSAP + ScrollTrigger): el paquete en 3D
//   (three.js) recibe la zapatilla, se cierra al confirmar el pago, se sella y sale.
// - Lo que ve la tienda, con las capturas reales de la app (Calzados Rosa): Pedidos, el pedido por
//   confirmar y la ficha de la clienta.
// Lo que todavía no existe (el carrito con «Pagar ahora», gestorIA Reparto) se dice como «pronto».
// Con «reducir movimiento» nada se fija ni se mueve: cada parte queda completa en su lugar.
import { getImage, Image } from "astro:assets"
import instagram from "../assets/iconos/instagram.svg"
import messenger from "../assets/iconos/messenger.svg"
import whatsapp from "../assets/iconos/whatsapp.svg"
import isotipo from "../assets/isotipo.svg?raw"
import clienta from "../assets/pantallas/clienta.png"
import clientaCelular from "../assets/pantallas/clienta-celular.png"
import pedidoPorConfirmar from "../assets/pantallas/pedido-por-confirmar.png"
import pedidos from "../assets/pantallas/pedidos.png"
import pedidosCelular from "../assets/pantallas/pedidos-celular.png"
import pedidosTableta from "../assets/pantallas/pedidos-tableta.png"
import ChatWhatsApp from "../components/inicio/ChatWhatsApp.astro"
import Base from "../layouts/Base.astro"
import { cta, SITE_URL } from "../lib/sitio"
import "../styles/inicio.css"

const PHONE = "(max-width: 639px)"
const TABLET = "(min-width: 640px) and (max-width: 1023px)"

const webp = (src: ImageMetadata, widths: number[]) => getImage({ src, widths, format: "webp" })
const [pedidosW, pedidosT, pedidosC, clientaW, clientaC] = await Promise.all([
  webp(pedidos, [960, 1280, 1920, 2560]),
  webp(pedidosTableta, [720, 1440, 2160]),
  webp(pedidosCelular, [360, 720, 1080]),
  webp(clienta, [640, 960, 1280, 1920]),
  webp(clientaCelular, [360, 720, 1080]),
])

const marca = isotipo.replace(/ role="[^"]*"/, "").replace(/ aria-label="[^"]*"/, "")

const pasos = [
  {
    titulo: "La clienta escribe por WhatsApp",
    texto: "Por WhatsApp, a las 9:41 o a medianoche. Sofi contesta al instante, con tu catálogo y tu stock.",
  },
  {
    titulo: "Sofi muestra el valor",
    texto: "Precio, material y horma, con lo que tú escribiste del producto. Nunca inventa un precio ni un stock.",
  },
  {
    titulo: "Negocia sin bajar de tu mínimo",
    texto: "Si la clienta pide rebaja, Sofi hace una sola oferta, con hora para pagar. Tu precio mínimo no se toca.",
  },
  {
    titulo: "Anota el pedido",
    texto: "Con el sí, Sofi anota el pedido con su envío y su total, y pide el pago con tus medios.",
  },
  {
    titulo: "Tu equipo confirma el pago",
    texto: "Una captura de Yape la confirma una persona; el link de pago, solo. Pronto: «Pagar ahora» con Yape y tarjeta.",
  },
  {
    titulo: "Sale con su pago confirmado",
    texto: "Sin pago confirmado no se entrega. El pedido queda listo para salir hoy. Pronto: gestorIA Reparto.",
  },
]

const rubros = [
  "Ropa",
  "Calzado",
  "Belleza",
  "Accesorios",
  "Tecnología",
  "Juguetes",
  "Regalos",
  "Mascotas",
  "Hogar",
  "Comida por encargo",
  "Lo que tú vendas",
]

const faqs = [
  [
    "¿Sofi puede bajar de mi precio mínimo?",
    "No. Tú pones el mínimo de cada producto y Sofi nunca vende por debajo. Ofrece una sola vez por conversación, a cambio de pagar a una hora exacta.",
  ],
  [
    "¿Sofi confirma los pagos?",
    "El link de pago se confirma solo. Una captura de Yape o de una transferencia la confirma una persona de tu equipo.",
  ],
  [
    "¿Puedo probar a Sofi antes de vender?",
    "Sí. «Probar a Sofi» la pone a vender con tu catálogo, sin mover tu stock ni crear un link de pago real.",
  ],
  [
    "¿Puedo usar gestorIA desde el celular?",
    "Sí. No necesitas una computadora: desde el celular ves los pedidos, confirmas pagos y marcas las entregas.",
  ],
]

const app = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "gestorIA",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  url: `${SITE_URL}/`,
  description:
    "Vendedora con IA para tiendas que venden por WhatsApp, Instagram y Messenger: Sofi atiende, negocia sin bajar del precio mínimo y cobra.",
  offers: { "@type": "Offer", price: "19", priceCurrency: "USD" },
}
const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map(([q, a]) => ({ "@type": "Question", name: q, acceptedAnswer: { "@type": "Answer", text: a } })),
}
---
<Base
  title="gestorIA: vendedora con IA para tiendas por chat"
  description="Sofi atiende tu WhatsApp, Instagram y Messenger, negocia sin bajar de tu precio mínimo, cobra y deja el pedido listo para salir. USD 19 al mes."
  ld={[app, faqLd]}
  moments={["word-highlight"]}
>
  <section class="hero v4-hero" data-enter aria-labelledby="hero-h">
    <div class="v4-hero__fondo" aria-hidden="true"><span class="v4-hero__luz v4-hero__luz--a"></span><span class="v4-hero__luz v4-hero__luz--b"></span></div>
    <div class="wrap v4-hero__wrap">
      <div class="v4-hero__texto">
        <p class="v4-hero__nota"><span class="v4-hero__punto" aria-hidden="true"></span>Para tiendas que venden por chat</p>
        <h1 id="hero-h">Vendedora con IA para tiendas por chat</h1>
        <p class="v4-hero__lead">Sofi atiende tu WhatsApp, Instagram y Messenger, negocia sin bajar de tu precio mínimo y cobra. Tú confirmas el pago y despachas. USD 19 al mes.</p>
        <div class="btn-row">
          <a class="btn btn--primary" href={cta.href}>{cta.label}<svg class="m-arrow" viewBox="0 0 12 12" aria-hidden="true"><path class="m-arrow__stem" d="M1 6h8"></path><path class="m-arrow__head" d="M4.5 2.5 8 6l-3.5 3.5"></path></svg></a>
          <a class="btn btn--secondary" href="#venta">Ver una venta</a>
        </div>
        <ul class="v4-canales" aria-label="Los chats donde vende Sofi">
          <li><img src={whatsapp.src} width="22" height="22" alt="" />WhatsApp</li>
          <li><img class="v4-canales__ig" src={instagram.src} width="22" height="22" alt="" />Instagram</li>
          <li><img src={messenger.src} width="22" height="22" alt="" />Messenger</li>
        </ul>
      </div>
      <div class="v4-hero__chat"><ChatWhatsApp /></div>
    </div>
  </section>

  <section class="v4-libre venta" id="venta" aria-labelledby="venta-h">
    <div class="venta__pin">
      <div class="wrap venta__wrap">
        <div class="venta__texto">
          <h2 id="venta-h" class="venta__h">Una venta con Sofi, de punta a punta</h2>
          <ol class="venta__pasos">
            {pasos.map((p, i) => (
              <li class="paso" data-paso={i}>
                <span class="paso__n" aria-hidden="true">{String(i + 1).padStart(2, "0")}</span>
                <h3>{p.titulo}</h3>
                <p>{p.texto}</p>
              </li>
            ))}
          </ol>
          <div class="venta__riel" aria-hidden="true">{pasos.map(() => <span><i></i></span>)}</div>
        </div>
        <div class="venta__escena" role="img" aria-label="La venta en un paquete: la zapatilla entra a la caja, la caja se cierra con el pago confirmado, se sella con la cinta naranja y sale">
          <canvas class="venta__lienzo" data-paquete="venta"></canvas>
          <span class="venta__pulso" aria-hidden="true"></span>
          <div class="tarjeta tarjeta--burbuja" data-tarjeta="0">
            <span>Hola, ¿tienen la zapatilla blanca en 38?</span>
            <small>9:41 <svg viewBox="0 0 18 12"><path d="M1 6.5l3 3 6-7"></path><path d="M7 9.5l1 1 6-8"></path></svg></small>
          </div>
          <div class="tarjeta tarjeta--producto" data-tarjeta="1">
            <span class="tarjeta__muestra"></span>
            <div>
              <b>Zapatilla urbana · blanca · 38</b>
              <span class="tarjeta__precio">S/ 129</span>
              <small>Cuero sintético · planta de goma · horma normal</small>
            </div>
            <em class="tarjeta__hizo">Buscó en el catálogo</em>
          </div>
          <div class="tarjeta tarjeta--precio" data-tarjeta="2">
            <span class="tarjeta__rotulo">La oferta de Sofi</span>
            <span class="tarjeta__cifra">S/ <span data-precio>129</span></span>
            <div class="medidor" aria-hidden="true">
              <span class="medidor__min"><i></i>Tu mínimo S/ 100</span>
              <span class="medidor__barra"><span class="medidor__lleno" data-medidor></span></span>
              <span class="medidor__lista">Lista S/ 129</span>
            </div>
            <em class="tarjeta__hizo">Una sola oferta: envío gratis, paga hasta mañana 10:58 a. m.</em>
          </div>
          <div class="tarjeta tarjeta--pedido" data-tarjeta="3">
            <div class="tarjeta__fila"><b>Pedido 0018</b><span class="estado" data-estado>Pago por confirmar</span></div>
            <small>Valeria Soto · WhatsApp</small>
            <div class="tarjeta__fila"><span>1 × Zapatilla urbana blanca 38</span><span>S/ 120</span></div>
            <div class="tarjeta__fila"><span>Reparto a Surco</span><span>Gratis</span></div>
            <div class="tarjeta__fila tarjeta__total"><span>Total</span><span>S/ 120</span></div>
          </div>
          <div class="tarjeta tarjeta--ruta" data-tarjeta="5">
            <svg class="ruta" viewBox="0 0 400 120" aria-hidden="true"><path data-ruta d="M10 100 C 120 100, 160 20, 390 24"></path></svg>
            <b>Sale hoy · Reparto en Lima</b>
            <small>Pronto: gestorIA Reparto, la app del repartidor</small>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section v4-tienda" id="pedidos" aria-labelledby="pedidos-h">
    <div class="wrap">
      <div class="v4-cabeza">
        <p class="v4-eyebrow">Lo que ve tu tienda</p>
        <h2 id="pedidos-h">Tus pedidos, con el pago de cada uno</h2>
        <p class="v4-sub">Cada pedido dice cuánto falta cobrar, si el pago está confirmado o por confirmar y qué sale hoy. Es la pantalla real de la app.</p>
      </div>
      <div class="tablero" data-tablero>
        <div class="tablero__marco">
          <div class="tablero__barra" aria-hidden="true"><i></i><i></i><i></i><span>app.gestoria24.com</span></div>
          <picture>
            <source media={PHONE} srcset={pedidosC.srcSet.attribute} sizes="342px" width={pedidosCelular.width} height={pedidosCelular.height} />
            <source media={TABLET} srcset={pedidosT.srcSet.attribute} sizes="calc(100vw - 96px)" width={pedidosTableta.width} height={pedidosTableta.height} />
            <img class="tablero__img" src={pedidosW.src} srcset={pedidosW.srcSet.attribute} sizes="(min-width: 1440px) 1280px, calc(100vw - 96px)" width={pedidos.width} height={pedidos.height} alt="Pedidos de Calzados Rosa en gestorIA: 13 abiertos, 5 para entregar hoy y 2 con pago por confirmar; cada pedido con su total, su pago, su entrega y su estado" loading="lazy" />
          </picture>
        </div>
        <span class="tablero__nota tablero__nota--a" data-nota>2 pagos por confirmar</span>
        <span class="tablero__nota tablero__nota--b" data-nota>5 pedidos salen hoy</span>
      </div>
    </div>
  </section>

  <section class="section v4-regla" id="entrega" data-moment="word-highlight" aria-labelledby="entrega-h">
    <div class="wrap v4-regla__wrap">
      <div class="v4-regla__texto">
        <p class="v4-eyebrow">La regla de las entregas</p>
        <h2 id="entrega-h" class="v4-regla__frase mo-wh__text">Sin pago confirmado, <strong>no se entrega.</strong> Sofi cobra antes de que el pedido salga.</h2>
        <p class="v4-sub">Si la clienta paga al recibir, quien entrega anota lo que cobró y con qué medio, y recién lo da por entregado.</p>
      </div>
      <div class="v4-regla__cel" data-cel>
        <Image class="pantalla-cel" src={pedidoPorConfirmar} alt="El pedido 0008 de Carla Mendoza con el pago por Yape por confirmar: la tienda revisa su cuenta y toca «Confirmar pago» o «No coincide»; se ve lo que Sofi cedió y el margen que usó" widths={[260, 520, 780]} sizes={`${PHONE} 240px, 320px`} loading="lazy" />
      </div>
    </div>
  </section>

  <section class="section v4-clientas" id="clientas" aria-labelledby="clientas-h">
    <div class="wrap v4-split">
      <div class="v4-split__texto">
        <p class="v4-eyebrow">La clienta, en una ficha</p>
        <h2 id="clientas-h">Una ficha por clienta en gestorIA</h2>
        <p class="v4-sub">Sus compras, lo que debe y cómo prefiere recibir, escriba por el chat que escriba. Si dos fichas parecen la misma clienta, gestorIA te avisa y lo decides tú: nunca las une por el teléfono.</p>
        <ul class="v4-datos" data-datos>
          <li>Instagram y WhatsApp</li>
          <li>2 compras</li>
          <li>Debe S/ 85.65</li>
        </ul>
      </div>
      <div class="v4-split__img" data-cortina>
        <picture>
          <source media={PHONE} srcset={clientaC.srcSet.attribute} sizes="300px" width={clientaCelular.width} height={clientaCelular.height} />
          <img src={clientaW.src} srcset={clientaW.srcSet.attribute} sizes="(min-width: 1024px) 640px, calc(100vw - 96px)" width={clienta.width} height={clienta.height} alt="La ficha de Andrea Castillo en Clientes: escribe por Instagram y WhatsApp, lleva 2 compras, una entregada y otra por pagar, y su dirección de reparto" loading="lazy" />
        </picture>
      </div>
    </div>
  </section>

  <section class="section v4-libre v4-rubros" id="rubros" aria-labelledby="rubros-h">
    <div class="wrap">
      <p class="v4-eyebrow">Cualquier rubro</p>
      <h2 id="rubros-h">Para cualquier tienda que vende por chat</h2>
      <p class="v4-sub">Sofi vende con tu catálogo, sea lo que sea: cada producto con sus opciones, como talla, color o tamaño, su stock y su precio mínimo. Los rubros son ejemplos, no un límite.</p>
    </div>
    <div class="cinta-rubros" aria-label={`Ejemplos de rubros: ${rubros.join(", ")}`} role="img">
      <div class="cinta-rubros__fila" data-fila="1">{[...rubros, ...rubros].map((r) => <span>{r}</span>)}</div>
      <div class="cinta-rubros__fila cinta-rubros__fila--b" data-fila="-1">{[...rubros.slice(5), ...rubros, ...rubros.slice(0, 5)].map((r) => <span>{r}</span>)}</div>
    </div>
  </section>

  <section class="section v4-precio" id="precio" aria-labelledby="precio-h">
    <div class="wrap v4-split">
      <div class="v4-split__texto">
        <p class="v4-eyebrow">Precio</p>
        <h2 id="precio-h">Un plan de USD 19 al mes</h2>
        <p class="v4-sub">Los USD 19 vuelven a tu tienda como saldo. De ahí sale el 1 % de cada pedido que gestorIA genera sola; pagas la diferencia solo si el saldo se acaba. Lo que anota tu equipo no paga el 1 %.</p>
      </div>
      <article class="plan4">
        <div class="plan4__cabeza">
          <span class="plan4__marca" aria-hidden="true"><Fragment set:html={marca} /></span>
          <h3>Tu tienda en gestorIA</h3>
        </div>
        <p class="plan4__precio">USD <span data-cuenta="19">19</span> <small>al mes</small></p>
        <p class="plan4__mas">+ 1 % de cada pedido que gestorIA genera sola, pagado con tu saldo.</p>
        <ul>
          <li>Sofi en WhatsApp, Instagram y Messenger</li>
          <li>Tu catálogo con precio mínimo por producto</li>
          <li>Pedidos, pagos y entregas del día</li>
          <li>La ficha de cada clienta</li>
          <li>Tu equipo con su rol: Dueño, Administrador y Ventas</li>
          <li>«Probar a Sofi» sin mover tu stock</li>
        </ul>
      </article>
    </div>
  </section>

  <section class="section faq-section v4-preguntas" id="preguntas" aria-labelledby="preguntas-h">
    <div class="wrap v4-split">
      <div class="v4-split__texto">
        <p class="v4-eyebrow">Preguntas</p>
        <h2 id="preguntas-h">Preguntas de quien vende por chat</h2>
        <p class="v4-sub solo-amplio">Lo que más nos preguntan antes de abrir su tienda. <a class="link" href="/contacto">Escribirnos</a></p>
      </div>
      <div class="faq">
        {faqs.map(([q, a]) => (
          <div class="faq__item"><h3>{q}</h3><p>{a}</p></div>
        ))}
      </div>
    </div>
  </section>

  <Fragment slot="cierre">
    <div class="cierre3d" aria-hidden="true"><canvas class="cierre3d__lienzo" data-paquete="cierre"></canvas></div>
  </Fragment>
</Base>

<script>
  import { iniciar } from "../scripts/inicio"
  iniciar()
</script>
