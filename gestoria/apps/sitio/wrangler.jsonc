// La web pública de gestorIA (gestoria24.com) en Cloudflare Workers: solo archivos, armados una vez
// al publicar, sin código de servidor (lienzo B8). Aparte de la app (`gestoria-web`) y de las webs
// de las clínicas: si se cae, nadie más lo nota. Sin `routes`: el dominio propio `gestoria24.com`
// se conecta a mano en el panel de Cloudflare, como `app.gestoria24.com` (docs/deployment.md).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestoria-sitio",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    // /terminos sirve terminos.html; una dirección que no existe, 404.html con su estado 404.
    "html_handling": "drop-trailing-slash",
    "not_found_handling": "404-page"
  }
}
