// La app de gestorIA en Cloudflare Workers (ADR 0203): solo archivos, sin código de servidor. Toda
// dirección que no es un archivo vuelve a la app (`single-page-application`). Sin `routes`: la ruta
// de `app.<dominio de gestorIA>` se pone en el panel de Cloudflare al encenderla.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "gestoria-web",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
