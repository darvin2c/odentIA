{
  "name": "odentia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file=./infra/dev/.env ./node_modules/turbo/bin/turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "check": "biome check .",
    "check:write": "biome check --write .",
    "db:generate": "pnpm --filter @odentia/db generate",
    "db:migrate": "pnpm --filter @odentia/db migrate",
    "db:seed": "pnpm --filter @odentia/services seed:dev",
    "e2e": "pnpm --filter @odentia/e2e run test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "portless": "0.15.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3",
    "typescript-language-server": "6.0.1",
    "undici": "8.10.2"
  },
  "pnpm": {
    "patchedDependencies": {
      "portless@0.15.6": "patches/portless@0.15.6.patch",
      "testcontainers@12.1.0": "patches/testcontainers@12.1.0.patch",
      "@base-ui/react@1.8.0": "patches/@base-ui__react@1.8.0.patch",
      "react-resizable-panels@4.12.4": "patches/react-resizable-panels@4.12.4.patch"
    }
  }
}
