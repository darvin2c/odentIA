{
  "name": "odentia",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "set -a && . ./infra/dev/.env && set +a && turbo dev",
    "build": "turbo build",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "db:generate": "pnpm --filter @odentia/db generate",
    "db:migrate": "pnpm --filter @odentia/db migrate",
    "db:seed": "pnpm --filter @odentia/services seed:dev",
    "e2e": "pnpm --filter @odentia/e2e test"
  },
  "devDependencies": {
    "portless": "0.15.6",
    "turbo": "2.10.12",
    "typescript": "5.9.3"
  }
}
